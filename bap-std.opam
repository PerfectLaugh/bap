# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "dev"
synopsis: "BAP Standard Library"
maintainer: ["Ivan Gotovchits <ivg@ieee.org>"]
authors: ["The BAP Team"]
license: "MIT"
tags: ["bap" "bap-library"]
homepage: "https://github.com/BinaryAnalysisPlatform/bap"
bug-reports: "https://github.com/BinaryAnalysisPlatform/bap/issues"
depends: [
  "dune" {>= "3.24"}
  "bap-common" {= version}
  "bap-bundle" {= version}
  "bap-core-theory" {= version}
  "bap-future" {= version}
  "bap-knowledge" {= version}
  "bap-main" {= version}
  "bap-plugins" {= version}
  "bap-relation" {= version}
  "bap-rust" {= version}
  "base-unix"
  "bitvec-order" {= version}
  "bitvec" {= version}
  "zipc" {>= "0.2.0"}
  "cmdliner" {>= "2.0.0"}
  "conf-mingw-w64-g++-x86_64" {os = "win32"}
  "core"
  "eio" {with-test & >= "1.0"}
  "eio_main" {with-test & >= "1.0"}
  "mtime" {with-test & >= "2.0"}
  "spawn" {with-test}
  "fileutils"
  "graphlib" {= version}
  "mmap"
  "monads" {= version}
  "ogre" {= version}
  "ounit2" {with-test}
  "ppx_bap" {= version}
  "regular" {= version}
  "uri"
  "uuidm"
  "zarith"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "--promote-install-files=false"
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
  ["dune" "install" "-p" name "--create-install-files" name]
]
dev-repo: "git+https://github.com/BinaryAnalysisPlatform/bap.git"
x-maintenance-intent: ["(latest)"]
