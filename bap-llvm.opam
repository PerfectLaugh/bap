# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "dev"
synopsis: "BAP LLVM backend"
maintainer: ["Ivan Gotovchits <ivg@ieee.org>"]
authors: ["The BAP Team"]
license: "MIT"
tags: ["bap" "bap-plugin" "llvm"]
homepage: "https://github.com/BinaryAnalysisPlatform/bap"
bug-reports: "https://github.com/BinaryAnalysisPlatform/bap/issues"
depends: [
  "dune" {>= "3.24"}
  "bap-demangle" {= version}
  "bap-std" {= version}
  "conf-mingw-w64-g++-x86_64" {os = "win32"}
  "core"
  "monads" {= version}
  "bap-common" {= version}
  "ogre" {= version}
  "ppx_bap" {= version}
  "odoc" {with-doc}
]
dev-repo: "git+https://github.com/BinaryAnalysisPlatform/bap.git"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "--promote-install-files=false"
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
  ["dune" "install" "-p" name "--create-install-files" name]
]

depexts: [
  ["cmake" "ninja-build"] {os-family = "debian"}
  ["cmake" "samurai"] {os-distribution = "alpine"}
  ["cmake" "ninja-build"] {os-distribution = "fedora"}
  ["cmake" "ninja"] {os-distribution = "arch"}
  ["cmake" "ninja"] {os = "macos" & os-distribution = "homebrew"}
  ["mingw-w64-x86_64-cmake" "mingw-w64-x86_64-ninja"] {os = "win32" & os-distribution = "msys2"}
]

extra-source "llvm-project-23.1.4.src.tar.xz" {
  src:
    "https://github.com/llvm/llvm-project/releases/download/llvmorg-23.1.4/llvm-project-23.1.4.src.tar.xz"
  checksum:
    "sha256=819ecf7351f1a66f76b2d701d8942faaf5faeb324cb90c9d5b090de142434bb2"
}
