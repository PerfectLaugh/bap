(defun t2STRD_PRE (wb rt rt2 rn off cnd _)
  (when (condition-holds cnd)
    (let ((a (+ rn off))) (a32-store-pair rt rt2 a) (set$ wb a))))
(defun t2STRD_POST (wb rt rt2 rn off cnd _)
  (when (condition-holds cnd)
    (let ((a rn)) (a32-store-pair rt rt2 a) (set$ wb (+ a off)))))

