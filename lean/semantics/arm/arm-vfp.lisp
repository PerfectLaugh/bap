(defun VSTMSDB_UPD (wb rn cnd _ r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16) (VSTM*DB_UPD wb rn cnd r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16))

;;; ADVANCED SIMD (NEON)
;;
;; The target has no Q registers, Qn is D(2n+1):D(2n), so the vector
;; operands, which are D or Q registers, are read and written by the
;; numbers of their D registers. The lists of the registers of the
;; loads and the stores are named by their first D register, e.g., D16
;; for {d16-d19}, or by their pairs, Q8 or D17_D18, and D16_D18 for the
;; spaced ones. The lanes are computed by the recursive halving of the
;; vectors, whose widths and the sizes of the lanes are static.
(defun neon-index (r)
  "(neon-index R) is the number of the first D register of the
   register or the list of the registers R"
  (case (symbol r)
    'D0 0
    'D1 1
    'D2 2
    'D3 3
    'D4 4
    'D5 5
    'D6 6
    'D7 7
    'D8 8
    'D9 9
    'D10 10
    'D11 11
    'D12 12
    'D13 13
    'D14 14
    'D15 15
    'D16 16
    'D17 17
    'D18 18
    'D19 19
    'D20 20
    'D21 21
    'D22 22
    'D23 23
    'D24 24
    'D25 25
    'D26 26
    'D27 27
    'D28 28
    'D29 29
    'D30 30
    'D31 31
    'Q0 0
    'Q1 2
    'Q2 4
    'Q3 6
    'Q4 8
    'Q5 10
    'Q6 12
    'Q7 14
    'Q8 16
    'Q9 18
    'Q10 20
    'Q11 22
    'Q12 24
    'Q13 26
    'Q14 28
    'Q15 30
    'D1_D2 1
    'D3_D4 3
    'D5_D6 5
    'D7_D8 7
    'D9_D10 9
    'D11_D12 11
    'D13_D14 13
    'D15_D16 15
    'D17_D18 17
    'D19_D20 19
    'D21_D22 21
    'D23_D24 23
    'D25_D26 25
    'D27_D28 27
    'D29_D30 29
    'D0_D2 0
    'D1_D3 1
    'D2_D4 2
    'D3_D5 3
    'D4_D6 4
    'D5_D7 5
    'D6_D8 6
    'D7_D9 7
    'D8_D10 8
    'D9_D11 9
    'D10_D12 10
    'D11_D13 11
    'D12_D14 12
    'D13_D15 13
    'D14_D16 14
    'D15_D17 15
    'D16_D18 16
    'D17_D19 17
    'D18_D20 18
    'D19_D21 19
    'D20_D22 20
    'D21_D23 21
    'D22_D24 22
    'D23_D25 23
    'D24_D26 24
    'D25_D27 25
    'D26_D28 26
    'D27_D29 27
    'D28_D30 28
    'D29_D31 29
    0))

(defun neon-d (n)
  "(neon-d N) is the register DN, N is static"
  (case n
    0 D0
    1 D1
    2 D2
    3 D3
    4 D4
    5 D5
    6 D6
    7 D7
    8 D8
    9 D9
    10 D10
    11 D11
    12 D12
    13 D13
    14 D14
    15 D15
    16 D16
    17 D17
    18 D18
    19 D19
    20 D20
    21 D21
    22 D22
    23 D23
    24 D24
    25 D25
    26 D26
    27 D27
    28 D28
    29 D29
    30 D30
    31 D31
    D0))

(defun neon-set-d (n x)
  "(neon-set-d N X) sets the register DN to X, N is static"
  (case n
    0 (set$ 'D0 x)
    1 (set$ 'D1 x)
    2 (set$ 'D2 x)
    3 (set$ 'D3 x)
    4 (set$ 'D4 x)
    5 (set$ 'D5 x)
    6 (set$ 'D6 x)
    7 (set$ 'D7 x)
    8 (set$ 'D8 x)
    9 (set$ 'D9 x)
    10 (set$ 'D10 x)
    11 (set$ 'D11 x)
    12 (set$ 'D12 x)
    13 (set$ 'D13 x)
    14 (set$ 'D14 x)
    15 (set$ 'D15 x)
    16 (set$ 'D16 x)
    17 (set$ 'D17 x)
    18 (set$ 'D18 x)
    19 (set$ 'D19 x)
    20 (set$ 'D20 x)
    21 (set$ 'D21 x)
    22 (set$ 'D22 x)
    23 (set$ 'D23 x)
    24 (set$ 'D24 x)
    25 (set$ 'D25 x)
    26 (set$ 'D26 x)
    27 (set$ 'D27 x)
    28 (set$ 'D28 x)
    29 (set$ 'D29 x)
    30 (set$ 'D30 x)
    31 (set$ 'D31 x)
    (set$ 'D0 x)))

(defun neon-regs (i n s)
  "(neon-regs I N S) is the concatenation of the N registers DI,
   D(I+S), ..., the first one in the lowest bits"
  (if (= n 1) (neon-d i)
    (concat (neon-regs (+ i s) (- n 1) s) (neon-d i))))

(defun neon-set-regs (i n s x)
  "(neon-set-regs I N S X) sets the N registers DI, D(I+S), ... to the
   64-bit parts of X, the lowest one to DI"
  (if (= n 1) (neon-set-d i x)
    (prog (neon-set-d i (cast-low 64 x))
          (neon-set-regs (+ i s) (- n 1) s (cast-high (* 64 (- n 1)) x)))))

(defun neon-get (r n) (neon-regs (neon-index r) n 1))
(defun neon-set (r n x) (let ((v x)) (neon-set-regs (neon-index r) n 1 v)))

(defmacro neon (cnd n rd x)
  "(neon CND N RD X) sets the N D registers of RD to X if CND holds"
  (when (condition-holds cnd) (neon-set rd n x)))

(defun neon-lane (x e i)
  "(neon-lane X E I) is the lane I of E bits of X"
  (extract (+ (* i e) e -1) (* i e) x))

(defun neon-mask (c e)
  "(neon-mask C E) is the lane of E ones if C and zeros otherwise"
  (neg (cast-unsigned e c)))

(defun neon-half (x) (/ (word-width x) 2))

;; the operations on the lanes, OP is static

(defun neon-op1 (op x k)
  (let ((e (word-width x)))
    (case op
      'abs (fp-select (msb x) (neg x) x)
      'neg (neg x)
      'shl (lshift x k)
      'shru (if (= k e) (cast-unsigned e 0) (rshift x k))
      'shrs (arshift x (if (= k e) (- e 1) k))
      'cnt (cast-unsigned e (popcount x))
      'clz (cast-unsigned e (clz x))
      'cls (cast-unsigned e (- (clz (logxor x (arshift x 1))) 1))
      'ceqz (neon-mask (is-zero x) e)
      'cgtz (neon-mask (s> x (fp-zero x)) e)
      'cgez (neon-mask (s>= x (fp-zero x)) e)
      'clez (neon-mask (s<= x (fp-zero x)) e)
      'cltz (neon-mask (s< x (fp-zero x)) e)
      'f2s (fp-to-int true 32 (neon-fz x) 8 23)
      'f2u (fp-to-int false 32 (neon-fz x) 8 23)
      's2f (cast-sfloat :rne 32 x)
      'u2f (cast-float :rne 32 x)
      'rshrs (cast-low e (arshift (+ (cast-signed (+ e 1) x)
                                     (lshift (cast-unsigned (+ e 1) 1) (- k 1)))
                                  k))
      'rshru (cast-low e (rshift (+ (cast-unsigned (+ e 1) x)
                                    (lshift (cast-unsigned (+ e 1) 1) (- k 1)))
                                 k))
      'fabs (fp-abs x)
      'fneg (fp-neg x)
      'fceqz (neon-fcmp 'eq x (fp-zero x))
      'fcgez (neon-fcmp 'ge x (fp-zero x))
      'fcgtz (neon-fcmp 'gt x (fp-zero x))
      'fclez (neon-fcmp 'ge (fp-zero x) x)
      'fcltz (neon-fcmp 'gt (fp-zero x) x))))

(defun neon-sat-signed (r e)
  "(neon-sat-signed R E) is the wider signed R saturated to E bits"
  (let ((hi (cast-signed (word-width r) (lnot (lshift (lnot (cast-unsigned e 0)) (- e 1)))))
        (lo (lnot hi)))
    (cast-low e (fp-select (s> r hi) hi (fp-select (s< r lo) lo r)))))

(defun neon-sat-unsigned (r e)
  "(neon-sat-unsigned R E) is the wider signed R saturated to the
   unsigned E bits"
  (let ((hi (cast-unsigned (word-width r) (lnot (cast-unsigned e 0)))))
    (cast-low e (fp-select (s> r hi) hi (fp-select (msb r) (fp-zero r) r)))))

(defun neon-shift (x s signed)
  "(neon-shift X S SIGNED) is X shifted left by the signed byte S, or
   right if S is negative"
  (let ((e (word-width x))
        (n (neg (cast-signed 16 s)))
        (p (cast-signed 16 s)))
    (fp-select (msb s)
               (if signed
                   (arshift x (fp-select (s< n e) n (cast-signed 16 (- e 1))))
                 (fp-select (s< n e) (rshift x n) (cast-unsigned e 0)))
               (fp-select (s< p e) (lshift x p) (cast-unsigned e 0)))))

(defun neon-op2 (op x y k)
  (let ((e (word-width x)))
    (case op
      'add (+ x y)
      'sub (- x y)
      'mul (* x y)
      'and (logand x y)
      'or (logor x y)
      'xor (logxor x y)
      'bic (logand x (lnot y))
      'orn (logor x (lnot y))
      'smax (fp-select (s> x y) x y)
      'umax (fp-select (> x y) x y)
      'smin (fp-select (s< x y) x y)
      'umin (fp-select (< x y) x y)
      'ceq (neon-mask (= x y) e)
      'cgts (neon-mask (s> x y) e)
      'cgtu (neon-mask (> x y) e)
      'cges (neon-mask (s>= x y) e)
      'cgeu (neon-mask (>= x y) e)
      'tst (neon-mask (not (is-zero (logand x y))) e)
      'abds (fp-select (s> x y) (- x y) (- y x))
      'abdu (fp-select (> x y) (- x y) (- y x))
      'hadds (cast-low e (arshift (+ (cast-signed (+ e 1) x) (cast-signed (+ e 1) y)) 1))
      'haddu (cast-low e (rshift (+ (cast-unsigned (+ e 1) x) (cast-unsigned (+ e 1) y)) 1))
      'rhadds (cast-low e (arshift (+ (cast-signed (+ e 1) x) (cast-signed (+ e 1) y) (cast-unsigned (+ e 1) 1)) 1))
      'rhaddu (cast-low e (rshift (+ (cast-unsigned (+ e 1) x) (cast-unsigned (+ e 1) y) (cast-unsigned (+ e 1) 1)) 1))
      'hsubs (cast-low e (arshift (- (cast-signed (+ e 1) x) (cast-signed (+ e 1) y)) 1))
      'hsubu (cast-low e (arshift (- (cast-unsigned (+ e 1) x) (cast-unsigned (+ e 1) y)) 1))
      'qadds (neon-sat-signed (+ (cast-signed (+ e 1) x) (cast-signed (+ e 1) y)) e)
      'qsubs (neon-sat-signed (- (cast-signed (+ e 1) x) (cast-signed (+ e 1) y)) e)
      'qaddu (neon-sat-unsigned (+ (cast-unsigned (+ e 2) x) (cast-unsigned (+ e 2) y)) e)
      'qsubu (neon-sat-unsigned (- (cast-unsigned (+ e 2) x) (cast-unsigned (+ e 2) y)) e)
      'shls (neon-shift x (cast-low 8 y) true)
      'shlu (neon-shift x (cast-low 8 y) false)
      'sras (+ x (arshift y (if (= k e) (- e 1) k)))
      'srau (+ x (if (= k e) (cast-unsigned e 0) (rshift y k)))
      'sli (logor (lshift y k) (logand x (lnot (lshift (lnot (cast-unsigned e 0)) k))))
      'sri (if (= k e) x
             (logor (rshift y k) (logand x (lnot (rshift (lnot (cast-unsigned e 0)) k)))))
      'trn1 (concat (cast-low (neon-half x) y) (cast-low (neon-half x) x))
      'trn2 (concat (cast-high (neon-half x) y) (cast-high (neon-half x) x))
      'fadd (neon-fadd x y)
      'fsub (neon-fsub x y)
      'fmul (neon-fmul x y)
      'fmax (neon-fres (fp-max (neon-fz x) (neon-fz y) 23))
      'fmin (neon-fres (fp-min (neon-fz x) (neon-fz y) 23))
      'fceq (neon-fcmp 'eq x y)
      'fcge (neon-fcmp 'ge x y)
      'fcgt (neon-fcmp 'gt x y)
      'fabd (fp-abs (neon-fsub x y))
      'mulls (* (cast-signed (* 2 e) x) (cast-signed (* 2 e) y))
      'mullu (* (cast-unsigned (* 2 e) x) (cast-unsigned (* 2 e) y))
      'addls (+ (cast-signed (* 2 e) x) (cast-signed (* 2 e) y))
      'addlu (+ (cast-unsigned (* 2 e) x) (cast-unsigned (* 2 e) y))
      'subls (- (cast-signed (* 2 e) x) (cast-signed (* 2 e) y))
      'sublu (- (cast-unsigned (* 2 e) x) (cast-unsigned (* 2 e) y))
      'abdls (cast-unsigned (* 2 e) (fp-select (s> x y) (- x y) (- y x)))
      'abdlu (cast-unsigned (* 2 e) (fp-select (> x y) (- x y) (- y x)))
      'second y)))

(defun neon-op3 (op a x y)
  (case op
    'mla (+ a (* x y))
    'mls (- a (* x y))
    'fmla (neon-fadd a (neon-fmul x y))
    'fmls (neon-fsub a (neon-fmul x y))
    'fma (neon-fres (vfp-fma (neon-fz x) (neon-fz y) (neon-fz a)))
    'fms (neon-fres (vfp-fma (fp-neg (neon-fz x)) (neon-fz y) (neon-fz a)))
    'abas (+ a (fp-select (s> x y) (- x y) (- y x)))
    'abau (+ a (fp-select (> x y) (- x y) (- y x)))
    'mlals (+ a (* (cast-signed (word-width a) x) (cast-signed (word-width a) y)))
    'mlalu (+ a (* (cast-unsigned (word-width a) x) (cast-unsigned (word-width a) y)))
    'mlsls (- a (* (cast-signed (word-width a) x) (cast-signed (word-width a) y)))
    'mlslu (- a (* (cast-unsigned (word-width a) x) (cast-unsigned (word-width a) y)))))

;; the maps of the operations on the lanes of E bits, the halves are
;; mapped recursively, the result has the width of the lanes of the
;; result, e.g., twice the lanes of the operands of the long ones

(defun neon-map1 (op x e k)
  (if (= (word-width x) e) (neon-op1 op x k)
    (concat (neon-map1 op (cast-high (neon-half x) x) e k)
            (neon-map1 op (cast-low (neon-half x) x) e k))))

(defun neon-map2 (op x y e k)
  (if (= (word-width x) e) (neon-op2 op x y k)
    (concat (neon-map2 op (cast-high (neon-half x) x) (cast-high (neon-half y) y) e k)
            (neon-map2 op (cast-low (neon-half x) x) (cast-low (neon-half y) y) e k))))

(defun neon-map3 (op a x y e)
  "the lanes of A are E bits, or 2E bits for the long operations,
   and the ones of X and Y are E bits"
  (if (= (word-width x) e) (neon-op3 op a x y)
    (concat (neon-map3 op (cast-high (neon-half a) a) (cast-high (neon-half x) x)
                       (cast-high (neon-half y) y) e)
            (neon-map3 op (cast-low (neon-half a) a) (cast-low (neon-half x) x)
                       (cast-low (neon-half y) y) e))))

(defun neon-widen (signed x e)
  "the lanes of E bits of X extended to 2E bits"
  (if (= (word-width x) e)
      (if signed (cast-signed (* 2 e) x) (cast-unsigned (* 2 e) x))
    (concat (neon-widen signed (cast-high (neon-half x) x) e)
            (neon-widen signed (cast-low (neon-half x) x) e))))

(defun neon-narrow (op x e k)
  "the lanes of E bits of X narrowed to E/2 bits"
  (if (= (word-width x) e)
      (case op
        'trunc (cast-low (/ e 2) x)
        'shrn (cast-low (/ e 2) (rshift x k))
        'rshrn (cast-low (/ e 2) (rshift (+ x (lshift (cast-unsigned e 1) (- k 1))) k))
        'qs (neon-sat-signed x (/ e 2))
        'qu (neon-sat-unsigned (cast-unsigned (+ e 1) x) (/ e 2))
        'qsu (neon-sat-unsigned x (/ e 2)))
    (concat (neon-narrow op (cast-high (neon-half x) x) e k)
            (neon-narrow op (cast-low (neon-half x) x) e k))))

(defun neon-pairwise (op x e)
  "the operation on the adjacent lanes of E bits of X"
  (if (= (word-width x) (* 2 e))
      (neon-op2 op (cast-low e x) (cast-high e x) 0)
    (concat (neon-pairwise op (cast-high (neon-half x) x) e)
            (neon-pairwise op (cast-low (neon-half x) x) e))))

(defun neon-rev (x e)
  "the lanes of E bits of X in the reverse order"
  (if (= (word-width x) e) x
    (concat (neon-rev (cast-low (neon-half x) x) e)
            (neon-rev (cast-high (neon-half x) x) e))))

(defun neon-rev-in (x e g)
  "the lanes of E bits reversed in each group of G bits of X"
  (if (= (word-width x) g) (neon-rev x e)
    (concat (neon-rev-in (cast-high (neon-half x) x) e g)
            (neon-rev-in (cast-low (neon-half x) x) e g))))

(defun neon-pick (x e k i n)
  "the N lanes I, I+K, ..., of E bits of X"
  (if (= n 1) (neon-lane x e i)
    (concat (neon-pick x e k (+ i k) (- n 1)) (neon-lane x e i))))

(defun neon-weave (x e k n i m)
  "the lanes I, ..., M-1 of the K vectors of N lanes of E bits of X
   interleaved, the lane J of the result is the lane J/K of the vector
   J mod K"
  (if (= i (- m 1))
      (neon-lane x e (+ (* n (mod i k)) (/ i k)))
    (concat (neon-weave x e k n (+ i 1) m)
            (neon-lane x e (+ (* n (mod i k)) (/ i k))))))

(defun neon-interleave (x e k)
  "the K vectors of X interleaved by the lanes of E bits"
  (let ((m (/ (word-width x) e)))
    (neon-weave x e k (/ m k) 0 m)))

(defun neon-rep (x n)
  "(neon-rep X N) is X repeated N times, N is static"
  (if (= n 1) x (concat (neon-rep x (- n 1)) x)))

(defun neon-dup (x n) (neon-rep x (/ n (word-width x))))

;; the modified immediates, AdvSIMDExpandImm of the 13-bit encoded
;; value, op:cmode:imm8

(defun neon-imm-bytes (imm)
  (concat (replicate-to-fill (select 7 imm) 8)
          (replicate-to-fill (select 6 imm) 8)
          (replicate-to-fill (select 5 imm) 8)
          (replicate-to-fill (select 4 imm) 8)
          (replicate-to-fill (select 3 imm) 8)
          (replicate-to-fill (select 2 imm) 8)
          (replicate-to-fill (select 1 imm) 8)
          (replicate-to-fill (select 0 imm) 8)))

(defun neon-expand-imm (imm)
  "(neon-expand-imm IMM) is the 64-bit value of the encoded IMM"
  (let ((b (cast-low 8 imm))
        (cmode (logand (rshift imm 8) 0xf))
        (op (logand (rshift imm 12) 1)))
    (case (rshift cmode 1)
      0 (neon-rep (cast-unsigned 32 b) 2)
      1 (neon-rep (lshift (cast-unsigned 32 b) 8) 2)
      2 (neon-rep (lshift (cast-unsigned 32 b) 16) 2)
      3 (neon-rep (lshift (cast-unsigned 32 b) 24) 2)
      4 (neon-rep (cast-unsigned 16 b) 4)
      5 (neon-rep (lshift (cast-unsigned 16 b) 8) 4)
      6 (if (= cmode 12)
            (neon-rep (logor (lshift (cast-unsigned 32 b) 8) 0xff) 2)
          (neon-rep (logor (lshift (cast-unsigned 32 b) 16) 0xffff) 2))
      (if (= cmode 14)
          (if (= op 0) (neon-rep b 8) (neon-imm-bytes b))
        (neon-rep (vfp-expand-imm b 8 23) 2)))))

;; the floating-point operations, the default NaN is positive and
;; the NaNs are propagated, as in FPProcessNaNs

(defun vfp-is-snan (x)
  (logand (is-nan x) (is-zero (select (- (fp-frac-bits x) 1) x))))

(defun vfp-frac-bits (x) (if (= (word-width x) 64) 52 23))
(defun fp-frac-bits (x) (vfp-frac-bits x))

(defun vfp-default-nan (x)
  (if (= (word-width x) 64)
      (concat (cast-unsigned 32 0x7ff80000) (cast-unsigned 32 0))
    (cast-unsigned 32 0x7fc00000)))

(defun vfp-nan1 (r x)
  (fp-select (is-nan x) (fp-quiet x (vfp-frac-bits x))
    (fp-select (is-nan r) (vfp-default-nan r) r)))

(defun vfp-nan2 (r x y)
  (let ((f (vfp-frac-bits x)))
    (fp-select (vfp-is-snan x) (fp-quiet x f)
      (fp-select (vfp-is-snan y) (fp-quiet y f)
        (fp-select (is-nan x) x
          (fp-select (is-nan y) y
            (fp-select (is-nan r) (vfp-default-nan r) r)))))))

(defun vfp-add (x y) (vfp-nan2 (+. :rne x y) x y))
(defun vfp-sub (x y) (vfp-nan2 (-. :rne x y) x y))
(defun vfp-mul (x y) (vfp-nan2 (*. :rne x y) x y))
(defun vfp-div (x y) (vfp-nan2 (/. :rne x y) x y))
(defun vfp-sqrt (x) (vfp-nan1 (fsqrt :rne x) x))

(defun vfp-nan3 (r a x y)
  "(vfp-nan3 R A X Y) is FPProcessNaNs3 of the addend A and the factors
   X and Y, of FPMulAdd, with the result R"
  (let ((f (vfp-frac-bits x)))
    (fp-select (vfp-is-snan a) (fp-quiet a f)
      (fp-select (vfp-is-snan x) (fp-quiet x f)
        (fp-select (vfp-is-snan y) (fp-quiet y f)
          (fp-select (logand (is-nan a)
                             (logor (logand (is-inf x) (is-fzero y))
                                    (logand (is-fzero x) (is-inf y))))
                     (vfp-default-nan r)
            (fp-select (is-nan a) a
              (fp-select (is-nan x) x
                (fp-select (is-nan y) y
                  (fp-select (is-nan r) (vfp-default-nan r) r))))))))))

(defun vfp-fma (x y z)
  "(vfp-fma X Y Z) is X * Y + Z rounded once"
  (vfp-nan3
   (if (= (word-width x) 64)
       (intrinsic 'fmad_rne_ieee754_binary_64 x y z :result 64)
     (intrinsic 'fmad_rne_ieee754_binary_32 x y z :result 32))
   z x y))

;; the single-precision operations of NEON use the standard FPSCR
;; value, they flush the denormals to zero and give the default NaN

(defun neon-fz (x)
  "(neon-fz X) is X, or the zero of its sign if X is denormal"
  (fp-select (is-zero (extract 30 23 x)) (logand x 0x80000000) x))

(defun neon-fres (r)
  (fp-select (is-nan r) (cast-unsigned 32 0x7fc00000) (neon-fz r)))

(defun neon-fcmp (op x y)
  "(neon-fcmp OP X Y) is the mask of the ordered comparison of the
   flushed X and Y"
  (let ((a (neon-fz x)) (b (neon-fz y)))
    (neon-mask (logand (not (is-nan a)) (not (is-nan b))
                       (case op
                         'eq (=. a b)
                         'ge (>=. a b)
                         'gt (>. a b)))
               32)))

(defun neon-fadd (x y) (neon-fres (+. :rne (neon-fz x) (neon-fz y))))
(defun neon-fsub (x y) (neon-fres (-. :rne (neon-fz x) (neon-fz y))))
(defun neon-fmul (x y) (neon-fres (*. :rne (neon-fz x) (neon-fz y))))

;; the other helpers of the instructions

(defun neon-select (m x y)
  "(neon-select M X Y) is the bits of X where M is set, and of Y elsewhere"
  (logor (logand m x) (logand (lnot m) y)))

(defun neon-set-lane (x e i v)
  "(neon-set-lane X E I V) is X with the lane I of E bits set to V"
  (let ((sh (* i e)))
    (logor (logand x (lnot (lshift (cast-unsigned 64 (lnot (cast-unsigned e 0))) sh)))
           (lshift (cast-unsigned 64 v) sh))))

(defun neon-tbl (tab idx dflt)
  "(neon-tbl TAB IDX DFLT) is the bytes of TAB selected by the bytes of
   IDX, or the bytes of DFLT if they are out of TAB"
  (if (= (word-width idx) 8)
      (fp-select (< (cast-unsigned 16 idx) (/ (word-width tab) 8))
                 (cast-low 8 (rshift tab (* (cast-unsigned (word-width tab) idx) 8)))
                 dflt)
    (concat (neon-tbl tab (cast-high (neon-half idx) idx) (cast-high (neon-half dflt) dflt))
            (neon-tbl tab (cast-low (neon-half idx) idx) (cast-low (neon-half dflt) dflt)))))

(defun neon-step (rm n)
  "the increment of the writeback, the register RM or N if it is Nil"
  (if (= (symbol rm) 'Nil) n rm))

;; the registers are loaded and stored one by one

(defun neon-load-regs (i n a)
  "(neon-load-regs I N A) loads the N registers from DI at A"
  (if (= n 1) (neon-set-d i (load-bits 64 a))
    (prog (neon-set-d i (load-bits 64 a))
          (neon-load-regs (+ i 1) (- n 1) (+ a 8)))))

(defun neon-store-regs (i n a)
  "(neon-store-regs I N A) stores the N registers from DI at A"
  (if (= n 1) (store-word a (neon-d i))
    (prog (store-word a (neon-d i))
          (neon-store-regs (+ i 1) (- n 1) (+ a 8)))))

(defmacro neon-ld1 (cnd rd n w a)
  (when (condition-holds cnd) (neon-load-regs (neon-index rd) n a)))

(defmacro neon-ld1-upd (cnd rd n w rn off)
  (when (condition-holds cnd)
    (let ((a rn))
      (neon-load-regs (neon-index rd) n a)
      (set$ rn (+ a off)))))

(defun neon-st1 (cnd rd n a)
  (when (condition-holds cnd) (neon-store-regs (neon-index rd) n a)))

(defun neon-st1-upd (cnd rd n rn off)
  (when (condition-holds cnd)
    (let ((a rn))
      (neon-store-regs (neon-index rd) n a)
      (set$ rn (+ a off)))))

;; the structures of two elements are N registers, the first half of
;; them gets the first elements, the second one starts S*N/2 registers
;; after the first register

(defun neon-ld2-regs (rd n s e a)
  (let ((x (load-bits (* 64 n) a))
        (i (neon-index rd))
        (m (/ (* 32 n) e)))
    (neon-set-regs i (/ n 2) 1 (neon-pick x e 2 0 m))
    (neon-set-regs (+ i (* s (/ n 2))) (/ n 2) 1 (neon-pick x e 2 1 m))))

(defun neon-st2-value (rd n s e)
  (let ((i (neon-index rd)))
    (neon-interleave (concat (neon-regs (+ i (* s (/ n 2))) (/ n 2) 1)
                             (neon-regs i (/ n 2) 1))
                     e 2)))

(defun neon-ld2 (cnd rd n s e a)
  (when (condition-holds cnd) (neon-ld2-regs rd n s e a)))

(defun neon-ld2-upd (cnd rd n s e rn off)
  (when (condition-holds cnd)
    (let ((a rn))
      (neon-ld2-regs rd n s e a)
      (set$ rn (+ a off)))))

(defun neon-st2 (cnd rd n s e a)
  (when (condition-holds cnd) (store-word a (neon-st2-value rd n s e))))

(defun neon-st2-upd (cnd rd n s e rn off)
  (when (condition-holds cnd)
    (let ((a rn))
      (store-word a (neon-st2-value rd n s e))
      (set$ rn (+ a off)))))

