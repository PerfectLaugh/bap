(defun VSTMSDB_UPD (wb rn cnd _ r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13) (VSTM*DB_UPD wb rn cnd r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13))
