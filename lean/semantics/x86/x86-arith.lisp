(declare (context (target x86)))
(require x86-common)

(in-package x86-common)

;;; INTEGER ARITHMETIC AND LOGIC
;;
;; The operations of a family, e.g., ADD, share a kernel, e.g., add-op,
;; that computes the result and sets the flags. The forms of the
;; instructions are rr (register, register), rm (register, memory), mr
;; (memory, register), ri (register, immediate), mi (memory, immediate)
;; and i (the accumulator, immediate), the immediates are truncated to
;; the size of the operation, which is the size of the registers or of
;; the memory operand. The _REV and _alt forms are other encodings.

(defun add-op (x y) (add-with-flags x y 0:1))
(defun adc-op (x y) (add-with-flags x y CF))
(defun sub-op (x y) (sub-with-flags x y 0:1))
(defun sbb-op (x y) (sub-with-flags x y CF))
(defun and-op (x y) (logic-with-flags (logand x y)))
(defun or-op (x y) (logic-with-flags (logor x y)))
(defun xor-op (x y) (logic-with-flags (logxor x y)))

(defmacro binop-rr (op rd x y) (set-gpr rd (op x y)))
(defmacro binop-rm (op rd x base scale index off seg)
  (set-gpr rd (op x (load-n (word-width x) (ea base scale index off seg)))))
(defmacro binop-mr (op base scale index off seg y)
  (let ((a (ea base scale index off seg)))
    (store-n (word-width y) a (op (load-n (word-width y) a) y))))
(defmacro binop-ri (op rd x imm) (set-gpr rd (op x (cast-low (word-width x) imm))))
(defmacro binop-mi (op n base scale index off seg imm)
  (let ((a (ea base scale index off seg)))
    (store-n n a (op (load-n n a) (cast-low n imm)))))

;; the comparisons only set the flags
(defmacro cmp-rr (op x y) (op x y))
(defmacro cmp-rm (op x base scale index off seg)
  (op x (load-n (word-width x) (ea base scale index off seg))))
(defmacro cmp-mr (op base scale index off seg y)
  (op (load-n (word-width y) (ea base scale index off seg)) y))
(defmacro cmp-ri (op x imm) (op x (cast-low (word-width x) imm)))
(defmacro cmp-mi (op n base scale index off seg imm)
  (op (load-n n (ea base scale index off seg)) (cast-low n imm)))

