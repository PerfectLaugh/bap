;;; UNARY OPERATIONS
;;
;; INC and DEC don't change CF, NOT doesn't change the flags.

(defun inc-op (x)
  (let ((cf CF) (r (add-op x (zext-like x 1:1))))
    (set CF cf)
    r))

(defun dec-op (x)
  (let ((cf CF) (r (sub-op x (zext-like x 1:1))))
    (set CF cf)
    r))

(defun neg-op (x)
  (let ((r (sub-op (zext-like x 0:1) x)))
    (set CF (not (is-zero x)))
    r))

(defun not-op (x) (lnot x))

(defmacro unop-r (op rd x) (set-gpr rd (op x)))
(defmacro unop-m (op n base scale index off seg)
  (let ((a (ea base scale index off seg)))
    (store-n n a (op (load-n n a)))))

