;;; MULTIPLICATION AND DIVISION
;;
;; The one-operand forms multiply and divide the accumulator, extended
;; with the data register, e.g., EDX:EAX, the flags SF, ZF, AF and PF
;; are undefined after the multiplications and are not changed, all the
;; flags are undefined after the divisions. The remainder of IDIV has the
;; sign of the dividend. The accumulator of each size is a function of
;; its own, as the registers have the size of the operation.

(defun set-mul-flags (ov)
  (set CF ov)
  (set OF ov))

(defun imul-overflow (p n)
  (/= p (cast-signed (word-width p) (cast-low n p))))

(defmacro product (cast n x y) (* (cast (* 2 n) x) (cast (* 2 n) y)))

;; the product of the multiplication, as the halves are its operands
(defmacro mul-high (cast n x y) (cast-high n (product cast n x y)))

(defun mul8 (y)
  (let ((p (product cast-unsigned 8 AL y)))
    (set-mul-flags (not (is-zero (cast-high 8 p))))
    (set AX p)))

(defun mul16 (y)
  (let ((p (product cast-unsigned 16 AX y)))
    (set-mul-flags (not (is-zero (cast-high 16 p))))
    (set DX (cast-high 16 p))
    (set AX (cast-low 16 p))))

(defun mul32 (y)
  (let ((p (product cast-unsigned 32 EAX y)))
    (set-mul-flags (not (is-zero (cast-high 32 p))))
    (set-edx (cast-high 32 p))
    (set-eax (cast-low 32 p))))

(defun mul64 (y)
  (declare (context (bits 64)))
  (let ((p (product cast-unsigned 64 RAX y)))
    (set-mul-flags (not (is-zero (cast-high 64 p))))
    (set RDX (cast-high 64 p))
    (set RAX (cast-low 64 p))))

(defun imul8 (y)
  (let ((p (product cast-signed 8 AL y)))
    (set-mul-flags (imul-overflow p 8))
    (set AX p)))

(defun imul16 (y)
  (let ((p (product cast-signed 16 AX y)))
    (set-mul-flags (imul-overflow p 16))
    (set DX (cast-high 16 p))
    (set AX (cast-low 16 p))))

(defun imul32 (y)
  (let ((p (product cast-signed 32 EAX y)))
    (set-mul-flags (imul-overflow p 32))
    (set-edx (cast-high 32 p))
    (set-eax (cast-low 32 p))))

(defun imul64 (y)
  (declare (context (bits 64)))
  (let ((p (product cast-signed 64 RAX y)))
    (set-mul-flags (imul-overflow p 64))
    (set RDX (cast-high 64 p))
    (set RAX (cast-low 64 p))))

;; the quotient and the remainder of X by Y, the dividend is twice as
;; wide as the divisor
(defmacro quotient (div cast x y) (div x (cast (word-width x) y)))
(defmacro remainder (div cast x y)
  (let ((d (cast (word-width x) y)))
    (- x (* (div x d) d))))

(defun div8 (y)
  (let ((x AX))
    (set AL (cast-low 8 (quotient / cast-unsigned x y)))
    (set AH (cast-low 8 (remainder / cast-unsigned x y)))))

(defun div16 (y)
  (let ((x (concat DX AX)))
    (set AX (cast-low 16 (quotient / cast-unsigned x y)))
    (set DX (cast-low 16 (remainder / cast-unsigned x y)))))

(defun div32 (y)
  (let ((x (concat EDX EAX)))
    (set-eax (cast-low 32 (quotient / cast-unsigned x y)))
    (set-edx (cast-low 32 (remainder / cast-unsigned x y)))))

(defun div64 (y)
  (declare (context (bits 64)))
  (let ((x (concat RDX RAX)))
    (set RAX (cast-low 64 (quotient / cast-unsigned x y)))
    (set RDX (cast-low 64 (remainder / cast-unsigned x y)))))

(defun idiv8 (y)
  (let ((x AX))
    (set AL (cast-low 8 (quotient s/ cast-signed x y)))
    (set AH (cast-low 8 (remainder s/ cast-signed x y)))))

(defun idiv16 (y)
  (let ((x (concat DX AX)))
    (set AX (cast-low 16 (quotient s/ cast-signed x y)))
    (set DX (cast-low 16 (remainder s/ cast-signed x y)))))

(defun idiv32 (y)
  (let ((x (concat EDX EAX)))
    (set-eax (cast-low 32 (quotient s/ cast-signed x y)))
    (set-edx (cast-low 32 (remainder s/ cast-signed x y)))))

(defun idiv64 (y)
  (declare (context (bits 64)))
  (let ((x (concat RDX RAX)))
    (set RAX (cast-low 64 (quotient s/ cast-signed x y)))
    (set RDX (cast-low 64 (remainder s/ cast-signed x y)))))

