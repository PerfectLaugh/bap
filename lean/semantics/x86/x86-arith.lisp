;; the two- and three-operand IMUL truncate the product to the size of
;; the operands
(defun imul-op (x y)
  (let ((n (word-width x))
        (p (product cast-signed n x (cast-low n y))))
    (set-mul-flags (imul-overflow p n))
    (cast-low n p)))

