private def wordAt (image : Image) (little : Bool) (address size : Nat) : Nat :=
  (List.range size).foldl (init := 0) fun value index =>
    let byte := ((image.memory.readByte (address + index)).getD 0).toNat
    value + byte * 256 ^ (if little then index else size - index - 1)

private def signed16 (value : Nat) : Int := if value ≥ 0x8000 then (value : Int) - 0x10000 else value

