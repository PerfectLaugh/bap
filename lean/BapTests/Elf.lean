private def runRelocations : IO Unit := do
  for (name, object, sections) in [("MIPS64", mips64Object, mips64Sections), ("PowerPC64", ppc64leObject, ppc64leSections),
      ("SystemZ", s390xObject, s390xSections), ("ARM", armObject, armSections), ("RISC-V", riscv64Object, riscv64Sections),
      ("mipsN32", mipsN32Object, mipsN32Sections), ("mipsGp0", mipsGp0Object, mipsGp0Sections), ("x86TlsLe", x86TlsLeObject, x86TlsLeSections), ("aarch64Tls", aarch64TlsObject, aarch64TlsSections), ("riscvTls", riscvTlsObject, riscvTlsSections), ("ppc64Tls", ppc64TlsObject, ppc64TlsSections), ("mips64Tls", mips64TlsObject, mips64TlsSections), ("aarch64Movw", aarch64MovwObject, aarch64MovwSections)] do
    match Elf.decode object, Elf.linkObject object with
    | .error error, _ | _, .error error => throw <| IO.userError error
    | .ok image, .ok output =>
      assertEqual s!"{name} object applied every relocation" ([] : List String) output.warnings
      for (sectionName, expected) in sections do
        match image.segments.find? (·.name == sectionName) with
        | none => throw <| IO.userError s!"{name} has no {sectionName}"
        | some segment =>
          let bytes := ofHex expected
          assertEqual s!"{name} {sectionName} matches ld.lld" (bytes.toList.map some) (bytesAt image segment.addr bytes.size)
  let symbolAt (image : Image) (name : String) : Nat :=
    ((image.symbols.find? (·.name == name)).map (·.addr)).getD 0
  -- the GOT is laid out as this linker likes, so its relocations are checked by what the code reads through them
  match Elf.decode mipsGotObject with
  | .error error => throw <| IO.userError error
  | .ok image =>
    let gp := ((image.segments.find? (·.name == "%got")).map (·.addr)).getD 0 + 0x7ff0
    let half (address : Nat) := wordAt image false (address + 2) 2
    assertEqual "R_MIPS_GOT_DISP slot holds S + A" (symbolAt image "tab" + 8)
      (gotValue image false gp (signed16 (half 0)))
    assertEqual "R_MIPS_GOT_HI16 and LO16 slot holds S + A" (symbolAt image "tab" + 16)
      (gotValue image false gp ((half 4 : Int) * 65536 + signed16 (half 8)))
    assertEqual "R_MIPS_CALL_HI16 and LO16 slot holds S" (symbolAt image "g")
      (gotValue image false gp ((half 12 : Int) * 65536 + signed16 (half 16)))
  match Elf.decode ppcGotObject with
  | .error error => throw <| IO.userError error
  | .ok image =>
    let toc := ((image.segments.find? (·.name == "%got")).map (·.addr)).getD 0 + 0x8000
    let half (address : Nat) := wordAt image true address 2
    assertEqual "R_PPC64_GOT16_DS slot holds S" (symbolAt image "value") (gotValue image true toc (signed16 (half 4)))
    assertEqual "R_PPC64_GOT16_HA and LO_DS slot holds S" (symbolAt image "value")
      (gotValue image true toc (signed16 (half 8) * 65536 + signed16 (half 12)))
    assertEqual "R_PPC64_GOT16_HA and LO slot holds S" (symbolAt image "f")
      (gotValue image true toc (signed16 (half 16) * 65536 + signed16 (half 20)))

/-- A file of one 16-byte section `.text`, a second one if `tls` of thread-local data, and a symbol at `value`, relocated once. -/
private def oneRelocation (machine width : Nat) (typ : Nat) (value : Nat) (explicit : Bool := true) (addend : Int := 0)
    (shndx : Nat := ElfLinker.shnAbs) (little : Bool := true) (tls : Bool := false) : ElfLinker.Input :=
  let text : ElfLinker.Section := ⟨".text", 1, ElfLinker.shfAlloc, 0, 16, 16⟩
  let data : ElfLinker.Section := ⟨".tdata", 1, ElfLinker.shfAlloc + ElfLinker.shfTls, 16, 8, 8⟩
  { machine, width, little, base := 0x1000, data := ByteArray.mk (Array.replicate 24 0)
    sections := if tls then #[text, data] else #[text]
    symbols := #[⟨"sym", shndx, false, value, 0, 0, 1, 0⟩]
    relocations := [⟨0, 0, typ, 0, addend, explicit⟩] }

private def outOfRange (input : ElfLinker.Input) : Bool :=
  (ElfLinker.link input).warnings.any (·.endsWith "is out of range of its field")

private def relocatedBytes (input : ElfLinker.Input) (n : Nat) : Nat :=
  ElfLinker.readNat (ElfLinker.link input).memory input.little 0 n

/-- What `relocate_image` says of a link: each store of its log reads back, and the bytes that nothing stored to are the input's. -/
private def checkImage (name : String) (input : ElfLinker.Input) : IO Unit := do
  let output := ElfLinker.link input
  let writes := output.applied.flatMap (·.2)
  for w in writes do
    assertEqual s!"{name}: a store reads back at {w.off}" (ElfLinker.field w.value 0 (8 * w.n))
      (ElfLinker.readNat output.memory w.little w.off w.n)
  for o in List.range input.data.size do
    if writes.all fun w => o < w.off || w.off + w.n ≤ o then
      assertEqual s!"{name}: byte {o} is the input's" (input.data.get! o) (output.memory.get! o)

/-- The stores of a whole link, of relocations of several machines. A deferred half is stored with the addend of its pair, or at
the end without one, and every one of them only once. -/
private def runWholeLink : IO Unit := do
  let bytes := ByteArray.mk (Array.replicate 24 0xaa)
  let sym : ElfLinker.Sym := ⟨"sym", ElfLinker.shnAbs, false, 0x12348000, 0, 0, 1, 0⟩
  let text : ElfLinker.Section := ⟨".text", 1, ElfLinker.shfAlloc, 0, 24, 16⟩
  let input (machine width : Nat) (little : Bool) (rels : List ElfLinker.Rel) : ElfLinker.Input :=
    { machine, width, little, base := 0x1000, data := bytes, sections := #[text], symbols := #[sym], relocations := rels }
  let x86 := input 62 64 true [⟨0, 0, 2, 0, -4, true⟩, ⟨0, 8, 1, 0, 1, true⟩, ⟨0, 16, 9, 0, -4, true⟩]
  checkImage "x86-64" x86
  assertEqual "x86-64 stores each site once" 3 (ElfLinker.link x86).applied.length
  assertEqual "x86-64 has no warning" 0 (ElfLinker.link x86).warnings.length
  let thumb := input 40 32 true [⟨0, 0, 0x2f, 0, 0, true⟩, ⟨0, 4, 0x30, 0, 0, true⟩, ⟨0, 8, 2, 0, 0, true⟩]
  checkImage "ARM" thumb
  assertEqual "ARM stores two halves of an instruction in one site" [2, 2, 1]
    ((ElfLinker.link thumb).applied.map (·.2.length))
  -- `HI16` is stored when its `LO16` comes, then the `LO16` and what comes without a pair at the end
  let mips := input 8 32 false [⟨0, 0, 5, 0, 0, false⟩, ⟨0, 4, 6, 0, 0, false⟩, ⟨0, 8, 5, 0, 0, false⟩]
  checkImage "MIPS" mips
  let output := ElfLinker.link mips
  assertEqual "MIPS stores in the order of its pairs" [([] : List Nat), [0], [4], [], [8]]
    (output.applied.map fun e => e.2.map (·.off))
  let hi := ElfLinker.readNat output.memory false 0 4
  let lo := ElfLinker.readNat output.memory false 4 4
  assertEqual "HI16 keeps the instruction and has the half of its pair" (0xaaaa0000 + 0xaaab * 0 + ((0xaaaa0000 + ElfLinker.sext (0xaaaa : Nat) 16 + 0x12348000 + 0x8000) >>> 16 : Int).toNat % 65536 : Nat) hi
  assertEqual "LO16 keeps the instruction" 0xaaaa0000 (lo - lo % 65536)

/-- A file with an instruction sequence and thread-local data: a symbol at the start of `.tdata` of eight bytes, and one after it. -/
private def tlsInput (machine width : Nat) (code : List UInt8) (relocations : List ElfLinker.Rel) : ElfLinker.Input :=
  let size := code.length
  { machine, width, little := true, base := 0x1000, data := ByteArray.mk (code ++ List.replicate 8 0).toArray
    sections := #[⟨".text", 1, ElfLinker.shfAlloc + ElfLinker.shfExecinstr, 0, size, 16⟩,
      ⟨".tdata", 1, ElfLinker.shfAlloc + ElfLinker.shfWrite + ElfLinker.shfTls, size, 8, 8⟩]
    symbols := #[⟨"x", 1, false, 0, 8, 6, 1, 0⟩, ⟨"__tls_get_addr", ElfLinker.shnAbs, false, 0, 0, 2, 1, 0⟩]
    relocations }

private def relaxedCode (input : ElfLinker.Input) (size : Nat) : List UInt8 :=
  let output := ElfLinker.link (ElfLinker.relaxTls input)
  ((output.memory.extract 0 size).toList)

/-- The relaxations of thread-local accesses, against the bytes `ld.lld -static` leaves of each. -/
private def runTlsRelax : IO Unit := do
  let gd : List UInt8 := [0x66, 0x48, 0x8d, 0x3d, 0, 0, 0, 0, 0x66, 0x66, 0x48, 0xe8, 0, 0, 0, 0]
  let input := tlsInput 62 64 gd [⟨0, 4, 19, 0, -4, true⟩, ⟨0, 12, 4, 1, -4, true⟩]
  assertEqual "R_X86_64_TLSGD becomes local-exec" [0x64, 0x48, 0x8b, 0x04, 0x25, 0, 0, 0, 0, 0x48, 0x8d, 0x80, 0xf8, 0xff, 0xff, 0xff]
    (relaxedCode input 16)
  assertEqual "without a warning" 0 (ElfLinker.link (ElfLinker.relaxTls input)).warnings.length
  assertEqual "the plain link of it warns" 2 (ElfLinker.link { input with relocations := [⟨0, 4, 19, 0, -4, true⟩, ⟨0, 4, 20, 0, -4, true⟩] }).warnings.length
  let ld : List UInt8 := [0x48, 0x8d, 0x3d, 0, 0, 0, 0, 0xe8, 0, 0, 0, 0, 0x48, 0x8d, 0x88, 0, 0, 0, 0]
  assertEqual "R_X86_64_TLSLD and DTPOFF32"
    [0x66, 0x66, 0x66, 0x64, 0x48, 0x8b, 0x04, 0x25, 0, 0, 0, 0, 0x48, 0x8d, 0x88, 0xf8, 0xff, 0xff, 0xff]
    (relaxedCode (tlsInput 62 64 ld [⟨0, 3, 20, 0, -4, true⟩, ⟨0, 8, 4, 1, -4, true⟩, ⟨0, 15, 21, 0, 0, true⟩]) 19)
  let desc : List UInt8 := [0x4c, 0x8d, 0x25, 0, 0, 0, 0, 0xff, 0x10]
  assertEqual "R_X86_64_GOTPC32_TLSDESC keeps its register" [0x49, 0xc7, 0xc4, 0xf8, 0xff, 0xff, 0xff, 0x66, 0x90]
    (relaxedCode (tlsInput 62 64 desc [⟨0, 3, 34, 0, -4, true⟩, ⟨0, 7, 35, 0, 0, true⟩]) 9)
  let otherOpcode : List UInt8 := [0x66, 0x48, 0x8b, 0x3d, 0, 0, 0, 0, 0x66, 0x66, 0x48, 0xe8, 0, 0, 0, 0]
  assertTrue "another instruction than the sequence isn't rewritten, and warns"
    ((ElfLinker.link (ElfLinker.relaxTls (tlsInput 62 64 otherOpcode [⟨0, 4, 19, 0, -4, true⟩, ⟨0, 12, 4, 1, -4, true⟩]))).warnings.length > 0)
  let i386gd : List UInt8 := [0x8d, 0x04, 0x1d, 0, 0, 0, 0, 0xe8, 0, 0, 0, 0]
  assertEqual "R_386_TLS_GD with an index" [0x65, 0xa1, 0, 0, 0, 0, 0x81, 0xe8, 0x08, 0, 0, 0]
    (relaxedCode (tlsInput 3 32 i386gd [⟨0, 3, 18, 0, 0, false⟩, ⟨0, 8, 4, 1, 0, false⟩]) 12)
  let i386ld : List UInt8 := [0x8d, 0x83, 0, 0, 0, 0, 0xe8, 0, 0, 0, 0]
  assertEqual "R_386_TLS_LDM" [0x65, 0xa1, 0, 0, 0, 0, 0x90, 0x8d, 0x74, 0x26, 0x00]
    (relaxedCode (tlsInput 3 32 i386ld [⟨0, 2, 19, 0, 0, false⟩, ⟨0, 7, 4, 1, 0, false⟩]) 11)
  let a64 : List UInt8 := List.replicate 16 0
  -- `TPREL` of the first byte of a block of alignment eight is sixteen on AArch64
  assertEqual "the TLSDESC sequence of AArch64"
    [0x00, 0x00, 0xa0, 0xd2, 0x00, 0x02, 0x80, 0xf2, 0x1f, 0x20, 0x03, 0xd5, 0x1f, 0x20, 0x03, 0xd5]
    (relaxedCode (tlsInput 183 64 a64 [⟨0, 0, 0x232, 0, 0, true⟩, ⟨0, 4, 0x233, 0, 0, true⟩, ⟨0, 8, 0x234, 0, 0, true⟩, ⟨0, 12, 0x239, 0, 0, true⟩]) 16)
  -- the `_NC` halves of AArch64 leave the opcode: a bit 16 doesn't make the `movk` a `movn`
  let big := { tlsInput 183 64 [0x00, 0x00, 0x80, 0xf2] [⟨0, 0, 0x224, 0, 0x10000, true⟩] with little := true }
  assertEqual "R_AARCH64_TLSLE_MOVW_TPREL_G0_NC keeps a movk" [0x00, 0x02, 0x80, 0xf2] (relaxedCode big 4)
  -- ARM has no relaxation in `ld.lld`: what needs a loader stays
  let arm := tlsInput 40 32 (List.replicate 4 0) [⟨0, 0, 0x68, 0, 0, false⟩]
  assertEqual "R_ARM_TLS_GD32 warns" 1 (ElfLinker.link (ElfLinker.relaxTls arm)).warnings.length

/-- Thunks, of branches that are out of range across a section without contents. What they come to is decoded with `llvm-objdump`
and has the targets and the Thumb bits that `ld.lld`'s have, in a harness of the sources of this port. -/
private def runThunks : IO Unit := do
  let gap : ElfLinker.Section := ⟨".gap", ElfLinker.shtNobits, ElfLinker.shfAlloc + ElfLinker.shfExecinstr, 16, 0x9000000, 16⟩
  let far : ElfLinker.Section := ⟨".far", 1, ElfLinker.shfAlloc + ElfLinker.shfExecinstr, 16, 16, 16⟩
  let text : ElfLinker.Section := ⟨".text", 1, ElfLinker.shfAlloc + ElfLinker.shfExecinstr, 0, 16, 16⟩
  let file (machine width : Nat) (sym : ElfLinker.Sym) (rels : List ElfLinker.Rel) : ElfLinker.Input :=
    { machine, width, little := true, base := 0, data := ByteArray.mk (Array.replicate 32 0)
      sections := #[text, gap, far], symbols := #[sym], relocations := rels }
  let a64 := file 183 64 ⟨"f", 2, false, 0, 0, 2, 1, 0⟩ [⟨0, 0, 0x11b, 0, 8, true⟩, ⟨0, 4, 0x11a, 0, 8, true⟩]
  assertEqual "CALL26 and JUMP26 out of range warn without thunks" 2 (ElfLinker.link a64).warnings.length
  let prepared := ElfLinker.prepare a64
  let linked := ElfLinker.link prepared
  assertEqual "with thunks they don't" 0 linked.warnings.length
  assertEqual "the thunks are a section after the text" (some ".thunks") (prepared.sections[1]?.map (·.name))
  assertEqual "at the aligned end of it" (some 16) (linked.sectionAddrs[1]?.join)
  assertEqual "both go to the one thunk" (ElfLinker.setBits 0 0 26 (16 >>> 2 : Int)) (ElfLinker.readNat linked.memory true 0 4)
  assertEqual "the second from four bytes on" (ElfLinker.setBits 0 0 26 (12 >>> 2 : Int)) (ElfLinker.readNat linked.memory true 4 4)
  assertEqual "ldr x16, #8" 0x58000050 (ElfLinker.readNat linked.memory true 32 4)
  assertEqual "br x16" 0xd61f0200 (ElfLinker.readNat linked.memory true 36 4)
  assertEqual "the word is the target with its addend" (((linked.sectionAddrs[3]?).join.getD 0) + 8) (ElfLinker.readNat linked.memory true 40 8)
  let near := { a64 with sections := #[text, ⟨".far", 1, ElfLinker.shfAlloc + ElfLinker.shfExecinstr, 16, 16, 16⟩] , symbols := #[⟨"f", 1, false, 0, 0, 2, 1, 0⟩] }
  assertEqual "a branch in range has no thunk" 2 (ElfLinker.prepare near).sections.size
  -- ARM, whose jumps need a veneer to change the instruction set even if in range
  let armTarget (value : Nat) : ElfLinker.Sym := ⟨"t", 1, false, value, 0, 2, 1, 0⟩
  let inRange : ElfLinker.Input :=
    { machine := 40, width := 32, little := true, base := 0, data := ByteArray.mk (Array.replicate 32 0)
      sections := #[text, far], symbols := #[armTarget 1], relocations := [⟨0, 0, 0x1d, 0, -8, true⟩] }
  let veneer := ElfLinker.prepare inRange
  assertEqual "R_ARM_JUMP24 to Thumb has a veneer" 3 veneer.sections.size
  let linkedArm := ElfLinker.link veneer
  assertEqual "ldr pc, [pc, #-4]" 0xe51ff004 (ElfLinker.readNat linkedArm.memory true 32 4)
  assertEqual "the word has the Thumb bit" (((linkedArm.sectionAddrs[2]?).join.getD 0) + 1) (ElfLinker.readNat linkedArm.memory true 36 4)
  let called := { inRange with relocations := [⟨0, 0, 0x1c, 0, -8, true⟩] }
  assertEqual "R_ARM_CALL to Thumb is a BLX in range" 2 (ElfLinker.prepare called).sections.size
  let thumbJump := { inRange with symbols := #[armTarget 0], relocations := [⟨0, 0, 0x1e, 0, -4, true⟩] }
  let linkedThumb := ElfLinker.link (ElfLinker.prepare thumbJump)
  assertEqual "movw ip of a veneer from Thumb" 0xf240 (ElfLinker.readNat linkedThumb.memory true 32 2 &&& 0xfbf0)
  assertEqual "bx ip" 0x4760 (ElfLinker.readNat linkedThumb.memory true 40 2)
  assertEqual "no warning" 0 linkedThumb.warnings.length

/-- The fields of relocations against what `ld.lld` reports: every relocation type of every machine is compared with it at the
ends of the ranges by a harness of the sources of this port, and these are a few of that. -/
private def runFieldChecks : IO Unit := do
  for (name, machine, width, typ, value, expected) in [
      ("R_X86_64_8 keeps the top of its range", 62, 64, 14, 255, false), ("R_X86_64_8 of 256", 62, 64, 14, 256, true),
      ("R_X86_64_32 is unsigned", 62, 64, 10, 2 ^ 32 - 1, false), ("R_X86_64_32 of 2^32", 62, 64, 10, 2 ^ 32, true),
      ("R_X86_64_32S is signed", 62, 64, 11, 2 ^ 31 - 1, false), ("R_X86_64_32S of 2^31", 62, 64, 11, 2 ^ 31, true),
      ("R_X86_64_64 has no range", 62, 64, 1, 2 ^ 63, false),
      ("R_AARCH64_ABS16 is either", 183, 64, 0x103, 2 ^ 16 - 1, false), ("R_AARCH64_ABS16 of 2^16", 183, 64, 0x103, 2 ^ 16, true),
      ("R_AARCH64_MOVW_UABS_G0", 183, 64, 0x107, 2 ^ 16, true), ("R_AARCH64_MOVW_UABS_G0_NC is not checked", 183, 64, 0x108, 2 ^ 16, false),
      ("R_AARCH64_MOVW_SABS_G0 is signed", 183, 64, 0x10e, 2 ^ 16 - 1, false), ("R_AARCH64_MOVW_SABS_G0 of 2^16", 183, 64, 0x10e, 2 ^ 16, true),
      ("R_390_12 is unsigned", 22, 64, 2, 4095, false), ("R_390_12 of 4096", 22, 64, 2, 4096, true),
      ("R_RISCV_HI20 of the top of a 32-bit word wraps", 243, 32, 26, 2 ^ 31 - 1, false)] do
    assertEqual s!"{name}" expected (outOfRange (oneRelocation machine width typ value))
  -- what loses its low bits is reported, for each relocation, and what doesn't is not
  let misaligned (input : ElfLinker.Input) : Bool :=
    (ElfLinker.link input).warnings.any (·.endsWith "needs a value aligned to 4")
  assertEqual "R_AARCH64_CALL26 to a word" false (misaligned (oneRelocation 183 64 0x11b 0x2000))
  assertEqual "R_AARCH64_CALL26 off a word" true (misaligned (oneRelocation 183 64 0x11b 0x2002))
  assertEqual "R_AARCH64_LDST32 of a word" false (misaligned (oneRelocation 183 64 0x11d 0x2000))
  assertEqual "R_AARCH64_LDST32 off a word" true (misaligned (oneRelocation 183 64 0x11d 0x2001))
  assertEqual "R_AARCH64_ADD_ABS_LO12 has no alignment" false (misaligned (oneRelocation 183 64 0x115 0x2001))
  assertEqual "R_PPC64_ADDR16_DS off a word" true (misaligned (oneRelocation 21 64 56 0x2001))
  assertEqual "R_X86_64_PC32 has no alignment" false (misaligned (oneRelocation 62 64 2 0x2001))
  assertTrue "R_RISCV_JAL to an odd address is reported" ((ElfLinker.link (oneRelocation 243 64 17 0x2001)).warnings.any (·.endsWith "needs a value aligned to 2"))
  assertEqual "R_X86_64_8 of -128" false (outOfRange (oneRelocation 62 64 14 0 (addend := -128)))
  assertEqual "R_X86_64_8 of -129" true (outOfRange (oneRelocation 62 64 14 0 (addend := -129)))
  assertEqual "R_X86_64_32 of -1" true (outOfRange (oneRelocation 62 64 10 0 (addend := -1)))
  assertEqual "a relocation that doesn't fit is still stored, cut" 0x12 (relocatedBytes (oneRelocation 62 64 14 0x212) 1)
  -- one warning per relocation
  let two := { oneRelocation 62 64 14 0x212 with relocations := [⟨0, 0, 14, 0, 0, true⟩, ⟨0, 8, 14, 0, 0, true⟩] }
  assertEqual "a warning for each relocation that doesn't fit" 2 (ElfLinker.link two).warnings.length

/-- The special symbols of a compound record of N64, on which lld has nothing to say, and thread-local relocations that go
through the GOT, whose relaxed form differs there. -/
private def runCompound : IO Unit := do
  let special (ssym last : Nat) := relocatedBytes
    (oneRelocation 8 64 (7 + 24 * 2 ^ 8 + last * 2 ^ 16 + ssym * 2 ^ 24) 0x40 (shndx := ElfLinker.shnAbs)) 4
  -- GP is 0x8000 past the GOT at 0x1010: S - GP = 0x40 - 0x9010
  let gp : Int := 0x1010 + 0x7ff0
  let base : Int := 0x40 - gp
  assertEqual "RSS_UNDEF negates the value" (ElfLinker.field (0 - base) 0 16) (special 0 6)
  assertEqual "RSS_GP is relative to the global pointer" (ElfLinker.field (gp - base) 0 16) (special 1 6)
  assertEqual "RSS_LOC is relative to the place" (ElfLinker.field ((0x1000 : Int) - base) 0 16) (special 3 6)
  let unknown := ElfLinker.link (oneRelocation 8 64 (7 + 24 * 2 ^ 8 + 6 * 2 ^ 16 + 4 * 2 ^ 24) 0x40)
  assertTrue "an unknown special symbol isn't applied" (unknown.warnings.any (·.endsWith "was not applied"))
  -- The block is `.tdata` at 0x1010, 8 bytes and aligned to 8: x86-64 has the symbol 8 bytes before the thread pointer.
  let ie := ElfLinker.link (oneRelocation 62 64 22 0 (addend := -4) (shndx := 1) (tls := true))
  let slot := ElfLinker.readNat ie.memory true 24 8
  assertEqual "R_X86_64_GOTTPOFF's slot holds the offset from the thread pointer" (ElfLinker.field (-8 : Int) 0 64) slot
  let le := relocatedBytes (oneRelocation 62 64 23 0 (shndx := 1) (tls := true)) 4
  assertEqual "R_X86_64_TPOFF32 is the offset from the thread pointer" (ElfLinker.field (-8 : Int) 0 32) le
  let aarch64 := relocatedBytes (oneRelocation 183 64 0x224 0 (shndx := 1) (tls := true)) 4
  assertEqual "R_AARCH64_TLSLE_MOVW_TPREL_G0_NC is past the control block, and leaves the opcode as ld.lld does" (16 * 2 ^ 5) aarch64
  assertEqual "R_RISCV_TPREL_ADD stores nothing" 0 (relocatedBytes (oneRelocation 243 64 32 0 (shndx := 1) (tls := true)) 4)
  let gd := ElfLinker.link (oneRelocation 62 64 19 0 (shndx := 1) (tls := true))
  assertTrue "a thread-local relocation that needs a loader isn't applied" (gd.warnings.any (·.endsWith "was not applied"))
  -- A pair of N32 records is one record, the first one's symbol and addend.
  let records : List ElfLinker.Rel := [⟨0, 0, 7, 1, 2, true⟩, ⟨0, 0, 24, 0, 0, true⟩, ⟨0, 0, 5, 0, 0, true⟩, ⟨0, 4, 6, 0, 0, true⟩]
  match Elf.packCompound records with
  | [first, second] =>
    assertEqual "N32's records of a place are packed" (7 + 24 * 256 + 5 * 65536) first.typ
    assertEqual "N32's first record has the symbol" 1 first.symbol
    assertEqual "N32's first record has the addend" 2 first.addend
    assertEqual "N32's other places aren't touched" 6 second.typ
  | _ => throw <| IO.userError "two places should have two records"

/-- A little-endian ELF64 of `machine` with a whole-file LOAD, a dynamic segment of `tags` and then `table`; each tag
value of `none` is the file offset of the table. -/
private def dynamic64 (machine : Nat) (tags : List (Nat × Option Nat)) (table : ByteArray) : ByteArray :=
  let tableOffset := 176 + 16 * (tags.length + 1)
  let total := tableOffset + table.size
  let b := appendNat ByteArray.empty 0x464c457f 4
  let b := appendNat (appendNat (appendNat b 2 1) 1 1) 1 1
  let b := appendNat b 0 9
  let b := appendNat (appendNat (appendNat b 3 2) machine 2) 1 4
  let b := appendNat (appendNat (appendNat b 0 8) 64 8) 0 8
  let b := appendNat (appendNat (appendNat b 0 4) 64 2) 56 2
  let b := appendNat (appendNat (appendNat (appendNat b 2 2) 64 2) 0 2) 0 2
  let segment (bytes : ByteArray) (kind flags offset size : Nat) :=
    let b := appendNat (appendNat bytes kind 4) flags 4
    let b := appendNat (appendNat (appendNat b offset 8) offset 8) offset 8
    appendNat (appendNat (appendNat b size 8) size 8) 8 8
  let b := segment b 1 6 0 total
  let b := segment b 2 6 176 (16 * (tags.length + 1))
  let b := tags.foldl (init := b) fun bytes tag =>
    appendNat (appendNat bytes tag.1 8) (tag.2.getD tableOffset) 8
  let b := appendNat b 0 16
  table.foldl (init := b) fun bytes byte => bytes.push byte

private def relocationsOf (bytes : ByteArray) : IO Elf.RelocationSpec := do
  match Elf.decode bytes with
  | .error error => throw <| IO.userError error
  | .ok image =>
    match Elf.dynamicRelocations image with
    | .error error => throw <| IO.userError error
    | .ok spec => pure spec

private def runPacked : IO Unit := do
  -- APS2: 2 relocations from 0x100, one group sharing offset delta 8 and type, with addend deltas 16 and 8
  let aps2 := ByteArray.mk #[65, 80, 83, 50, 2, 0x80, 0x02, 2, 11, 8, 0x83, 0x08, 16, 8]
  let tags (size : Nat) : List (Nat × Option Nat) := [(0x60000011, none), (0x60000012, some size)]
  let spec ← relocationsOf (dynamic64 183 (tags 14) aps2)
  assertEqual "APS2 relative relocations" [0x108, 0x110] spec.relative
  -- the last addend is missing: what was decoded stays, and nothing is made up from the rest
  let spec ← relocationsOf (dynamic64 183 (tags 13) (aps2.extract 0 13))
  assertEqual "APS2 truncated table keeps the complete relocations" [0x108] spec.relative
  let spec ← relocationsOf (dynamic64 183 (tags 4) (aps2.extract 0 4))
  assertEqual "APS2 without a count" ([] : List Nat) spec.relative
  let oversized := ByteArray.mk #[65, 80, 83, 50, 2, 0x80, 0x02, 3, 11, 8, 0x83, 0x08, 16, 8]
  let spec ← relocationsOf (dynamic64 183 (tags 14) oversized)
  assertEqual "APS2 group larger than the table" ([] : List Nat) spec.relative
  let bad := ByteArray.mk #[65, 80, 83, 51, 2, 0x80, 0x02, 2, 11, 8, 0x83, 0x08, 16, 8]
  let spec ← relocationsOf (dynamic64 183 (tags 14) bad)
  assertEqual "APS2 bad magic" ([] : List Nat) spec.relative
  -- RELR: the address 0x1000, then a bitmap marking the second word after it, and 63 words on another
  let relr := appendNat (appendNat (appendNat ByteArray.empty 0x1000 8) 5 8) 3 8
  let spec ← relocationsOf (dynamic64 183 [(36, none), (35, some 24)] relr)
  assertEqual "RELR relative relocations" [0x1000, 0x1010, 0x1008 + 63 * 8] spec.relative
  let spec ← relocationsOf (dynamic64 183 [(36, none), (35, some 8)] (relr.extract 0 8))
  assertEqual "RELR address entry" [0x1000] spec.relative
  -- mips64el: `r_sym` in the low word, `r_ssym, r_type3, r_type2, r_type` above it
  assertEqual "mips64el r_info" (0x1203, 7) (Elf.splitInfo true true 0x0312000000000007)
  assertEqual "mips64 big-endian r_info" (0x1203, 7) (Elf.splitInfo true false 0x0000000700001203)
  assertEqual "ELF32 r_info" (0x17, 0x12) (Elf.splitInfo false false 0x1217)
  -- a relocation table of mips64el: R_MIPS_REL32 / R_MIPS_64 with no symbol is relative
  let table := appendNat (appendNat ByteArray.empty 0x2000 8) 0x0312000000000000 8
  let spec ← relocationsOf (dynamic64 8 [(17, none), (18, some 16)] table)
  assertEqual "mips64el relative relocation" [0x2000] spec.relative

/-- A little-endian MIPS ELF32 with one local GOT entry and the imported `x` and defined `y` as global ones. -/
private def mipsGotFixture : ByteArray :=
  let b := elf32Header appendNat 1 3 8 0 52 0 2 0 0
  let b := elf32Program appendNat b 1 0 0 0 256 256 6
  let b := elf32Program appendNat b 2 116 116 116 72 72 6
  let b := [(6, 188), (5, 236), (10, 5), (3, 0x400), (0x7000000a, 2), (0x70000013, 1), (0x70000011, 3), (11, 16), (0, 0)]
    |>.foldl (init := b) fun result entry => appendNat (appendNat result entry.1 4) entry.2 4
  let b := appendNat b 0 16
  let symbol (bytes : ByteArray) (name value info shndx : Nat) :=
    let b := appendNat (appendNat (appendNat bytes name 4) value 4) 0 4
    appendNat (appendNat (appendNat b info 1) 0 1) shndx 2
  let b := symbol (symbol b 1 0 0x10 0) 3 0x100 0x11 1
  let b := appendString (appendString (appendNat b 0 1) "x") "y"
  appendNat b 0 (256 - b.size)

private def runElf32 : IO Unit := do
  match Elf.decode elf32Fixture with
  | .error error => throw <| IO.userError error
  | .ok image =>
    assertEqual "ELF32 architecture" Arch.arm image.arch
    assertEqual "ELF32 address width" 32 image.addrWidth
    assertEqual "ELF32 entry" 0x8000 image.entryPoint
    assertEqual "ELF32 mapped file byte" (some 0xc3) (image.memory.readByte 0x8000)
    assertEqual "ELF32 zero-filled byte" (some 0) (image.memory.readByte 0x8007)
    assertEqual "ELF32 virtual memory end" none (image.memory.readByte 0x8008)
    assertEqual "ELF32 p_vaddr rather than p_paddr" none (image.memory.readByte 0x9000)
    assertEqual "ELF32 segment span" (some (0x8000, 8)) (image.segments[0]?.map fun segment => (segment.addr, segment.size))
    assertEqual "ELF32 segment permissions" (some (true, false, true))
      (image.segments[0]?.map fun segment => (segment.readable, segment.writable, segment.executable))
    assertEqual "ELF32 sections" [".symtab", ".shstrtab"]
      (image.sections.map (·.name) |>.filter (· != ""))
    assertEqual "ELF32 symbol names" ["f"] (image.symbols.map (·.name))
    assertEqual "ELF32 symbol clears the Thumb bit" [0x8000] (image.symbols.map (·.addr))
    assertEqual "ELF32 symbol size" [4] (image.symbols.map (·.size))
    assertEqual "ELF32 function symbol" [true] (image.symbols.map (·.isFunction))
  match Elf.programHeaders elf32Fixture with
  | .error error => throw <| IO.userError error
  | .ok headers =>
    assertEqual "ELF32 program header" [[1, 5, 84, 0x8000, 4, 8]]
      (headers.map fun header =>
        [header.kind, header.flags, header.offset, header.addr, header.fileSize, header.memorySize])
  match Elf.decode elf32BigFixture with
  | .error error => throw <| IO.userError error
  | .ok image =>
    assertEqual "ELF32 big-endian" Endian.big image.endian
    assertEqual "ELF32 big-endian architecture" Arch.mips image.arch
    assertEqual "ELF32 big-endian bytes" (some 0xbe) (image.memory.readByte 0x400002)
    assertEqual "ELF32 big-endian zero fill" (some 0) (image.memory.readByte 0x40000f)
    assertEqual "ELF32 big-endian permissions" (some (true, true, false))
      (image.segments[0]?.map fun segment => (segment.readable, segment.writable, segment.executable))
  match Elf.decode elf32DynamicFixture with
  | .error error => throw <| IO.userError error
  | .ok image =>
    match Elf.dynamicRelocations image with
    | .error error => throw <| IO.userError error
    | .ok relocations =>
      assertEqual "ELF32 relative relocation" [212] relocations.relative
      assertEqual "ELF32 named reference" [(216, "x")] relocations.references
      assertEqual "ELF32 R_386_32 target adds the stored addend" [(216, 0x104)] relocations.absolute
  match Elf.decode elf64ObjectFixture with
  | .error error => throw <| IO.userError error
  | .ok image =>
    assertEqual "ELF object without sections has no segments" 0 image.segments.length
    assertEqual "ELF object has no mapped memory" 0 image.memory.entries.length
  assertEqual "ELF object has no program headers" (some 0) ((Elf.programHeaders elf64ObjectFixture).toOption.map (·.length))
  match Elf.decode (elf32Fixture.set! 42 0) with
  | .error _ => IO.println "ok: undersized ELF program entries rejected when present"
  | .ok _ => throw <| IO.userError "undersized ELF program entries accepted"

def run : IO Unit := do
  runObjects
  runRelocations
  runFieldChecks
  runCompound
  runPacked
  runWholeLink
  runTlsRelax
  runThunks
  let spec ← relocationsOf mipsGotFixture
  assertEqual "MIPS global GOT entries of imports are references" [(0x408, "x")] spec.references
  runElf32
  assertEqual "ELF fixture size" 124 fixture.size
  match Elf.decode fixture with
  | .error error => throw <| IO.userError error
  | .ok image =>
    assertEqual "ELF sectionless architecture" Arch.x86_64 image.arch
    assertEqual "ELF sectionless entry" 0x400000 image.entryPoint
    assertEqual "ELF sectionless sections" 0 image.sections.length
    assertEqual "ELF sectionless symbols" 0 image.symbols.length
    assertEqual "ELF PT_LOAD count" 1 image.segments.length
    assertEqual "ELF mapped file byte" (some 0xc3) (image.memory.readByte 0x400000)
    assertEqual "ELF zero-filled byte" (some 0) (image.memory.readByte 0x400004)
    assertEqual "ELF final zero-filled byte" (some 0) (image.memory.readByte 0x400007)
    assertEqual "ELF virtual memory end" none (image.memory.readByte 0x400008)
    match image.segments[0]? with
    | some segment =>
      assertEqual "ELF virtual segment size" 8 segment.size
      assertEqual "ELF segment permissions" (true, false, true)
        (segment.readable, segment.writable, segment.executable)
    | none => throw <| IO.userError "missing ELF LOAD segment"
  let host ← Elf.load "/bin/echo"
  assertEqual "host ELF filters non-LOAD headers" 3 host.segments.length
  assertEqual "host ELF zero-filled BSS" (some 0) (host.memory.readByte 0x900c)
  match Elf.dynamicRelocations host with
  | .error error => throw <| IO.userError error
  | .ok relocations =>
    assertTrue "host ELF has named dynamic references" (!relocations.references.isEmpty)
    assertTrue "host ELF has relative dynamic relocations" (!relocations.relative.isEmpty)
    match Elf.imports host relocations 0x700000 with
    | .error error => throw <| IO.userError error
    | .ok imports =>
      assertTrue "host ELF has linked imports" (!imports.isEmpty)
      assertEqual "host ELF import addresses are sequential" (some 0x700000) (imports.head?.map (·.address))

end Bap.Tests.Elf
