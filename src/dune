(executable
 (name bap_frontend)
 (public_name bap)
 (package bap-frontend)
 (modules bap_frontend bap_memprof bap_script_run)
 (preprocess
  (pps ppx_bap))
 (libraries
  bap
  bap-core-theory
  bap-frontend.script
  bap-knowledge
  bap-main
  core
  dune-site.plugins
  dynlink
  findlib.dynload
  regular
  threads
  unix)
 (link_deps
  (glob_files longpaths.o))
 (link_flags
  (:include longpaths.flags)))

; On Windows, bap.exe and the testsuite are linked with longpaths.manifest,
; which tells that they are aware of the long paths, so that their limit of
; 260 characters is lifted, when they are enabled in Windows, e.g., for the
; specifications of Ghidra, which are extracted into the cache, see
; plugins/ghidra. The flags link the manifest, and are empty elsewhere.

(rule
 (enabled_if
  (= %{os_type} Win32))
 (targets longpaths.o)
 (deps longpaths.rc longpaths.manifest)
 (action
  (run x86_64-w64-mingw32-windres longpaths.rc -O coff -o %{targets})))

(rule
 (enabled_if
  (= %{os_type} Win32))
 (action
  (with-stdout-to
   longpaths.flags
   (echo "(\"src/longpaths.o\")"))))

(rule
 (enabled_if
  (<> %{os_type} Win32))
 (action
  (with-stdout-to
   longpaths.flags
   (echo "()"))))

