; the functional tests of bap and bap-mc, which run them on the binaries of
; the testsuite, in testsuite/ at the root of the repository, with their
; sources in testsuite/src, and with the scripts, the Lisp files, and the
; inputs of the cases in inputs/, which the cases read rather than write,
; so that they are the same in every environment. They are OUnit tests,
; which are slow, so they don't run with dune test, run them with
;
;   dune build @testsuite
;
; and select the cases whose names contain one of the words of BAP_TESTS,
; e.g., BAP_TESTS="taint mc/" dune build @testsuite. The cases run in 16
; threads, OUNIT_SHARDS sets their number, BAP_TESTSUITE_WORK keeps
; the outputs of the failed cases in its directory, and
; BAP_TESTSUITE_EXECUTOR=lifted runs the native code in the lifted
; engine, with bap:lifted-executor, rather than in Unicorn. Run
;
;   dune build @install && dune exec -- tools/testsuite/run.exe -help
;
; for the OUnit options, e.g., -list-test and -only-test.
;
; The golden cases compare the specifications that the loaders make of the
; files of the testsuite, and the summaries of the programs that bap lifts
; from them, with the files of the golden folder, and keep the actual ones
; in the outputs of the failed cases. After an intended change, update them with
;
;   BAP_TESTSUITE_PROMOTE=1 BAP_TESTS=golden/ dune build @testsuite
;
; and review their diff.

; the cases make and remove the paths of bap, which can be longer than
; Windows allows, unless the program is aware of the long paths, see src/dune

(executable
 (name run)
 (libraries ounit2 ounit2.threads re spawn threads.posix unix)
 (link_deps
  (glob_files %{project_root}/src/longpaths.o))
 (link_flags
  (:include %{project_root}/src/longpaths.flags)))

; the cases test the plugins that are built in this tree, and run every
; time, since they depend on the testsuite

(rule
 (alias testsuite)
 (deps
  (alias_rec %{workspace_root}/install)
  (universe))
 (action
  (run %{exe:run.exe} -bap %{bin:bap} -mc %{bin:bap-mc})))

; the fixed inputs and the golden files of the cases are data

(data_only_dirs inputs golden)
