#53: #v14 := SP + 7
#54: R0 := #v14
#55: #v15 := R0 + 0xF
#56: R1 := #v15
#57: R2 := 0xCE
#58: R2 := R2 & 0xFFFF | 0x30000
#59: goto %#60

#60:
#61: #v16 := CF
