#31: ZF := R4 + 6 = 0
#32: CF := 31:31[R4] & ~31:31[R4 + 6]
#33: #v8 := ~ZF <> 0
#34: when #v8 goto %#21
#35: goto %#36

#36:
#37: #v9 := CF
