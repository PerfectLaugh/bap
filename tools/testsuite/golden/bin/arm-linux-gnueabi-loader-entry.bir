# exited with 0
sub _start(_start_result)
  calls exit main
sub exit(exit_code)
  calls exit
sub fgetc(fgetc_stream, fgetc_result)
sub getchar(getchar_result)
sub helper(helper_result)
sub main(main_argc, main_argv, main_result)
  calls helper putchar
sub putchar(putchar_c, putchar_result)

sub main(main_argc, main_argv, main_result)
#1: main_argc :: in u32 = R0
#2: main_argv :: in out u32 = R1
#3: main_result :: out u32 = R0

#4:
#5: #v1 := SP
