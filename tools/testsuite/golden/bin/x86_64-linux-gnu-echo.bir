          63:63[RAX] & ~63:63[#254]
#430: OF := 63:63[RAX] & 63:63[RDX] & ~63:63[#254] | ~63:63[RAX] &
          ~63:63[RDX] & 63:63[#254]
#431: AF := 0:0[(#254 ^ RAX ^ RDX) >> 4]
#432: SF := 63:63[#254]
#433: ZF := #254 = 0
#434: #255 := low:8[#254]
#435: #256 := #255 ^ #255 >> 4
#436: #257 := #256 ^ #256 >> 2
#437: #258 := #257 ^ #257 >> 1
#438: PF := ~0:0[#258]
#439: RAX := #254
#440: RAX := mem[RAX, el]:u64
#441: RDI := RAX
#442: RSP := RSP - 8
#443: mem := mem with [RSP, el]:u64 <- 0x400841
#444: call @strlen with return %#445

#445:
#446: #261 := RAX + 1
#447: CF := 63:63[RAX] & ~63:63[#261]
#448: OF := ~63:63[RAX] & 63:63[#261]
#449: AF := 0:0[(#261 ^ RAX ^ 1) >> 4]
#450: SF := 63:63[#261]
#451: ZF := #261 = 0
#452: #262 := low:8[#261]
#453: #263 := #262 ^ #262 >> 4
#454: #264 := #263 ^ #263 >> 2
#455: #265 := #264 ^ #264 >> 1
#456: PF := ~0:0[#265]
#457: RAX := #261
#458: RDI := RAX
#459: RSP := RSP - 8
#460: mem := mem with [RSP, el]:u64 <- 0x40084D
#461: call @malloc with return %#462

#462:
#463: RSI := RBX
#464: RDI := RAX
#465: RSP := RSP - 8
#466: mem := mem with [RSP, el]:u64 <- 0x400858
#467: call @strcpy with return %#468

#468:
#469: RDX := mem[RBP - 0x30, el]:u64
#470: RCX := pad:64[mem[RBP - 0x4C, el]:u32]
#471: RCX := extend:64[31:0[RCX]]
#472: mem := mem with [RDX + (RCX << 3), el]:u64 <- RAX
#473: #273 := RBP - 0x4C
#474: #274 := mem[#273, el]:u32 + 1
#475: CF := 31:31[mem[#273, el]:u32] & ~31:31[#274]
#476: OF := ~31:31[mem[#273, el]:u32] & 31:31[#274]
#477: AF := 0:0[(#274 ^ mem[#273, el]:u32 ^ 1) >> 4]
#478: SF := 31:31[#274]
#479: ZF := #274 = 0
#480: #275 := low:8[#274]
#481: #276 := #275 ^ #275 >> 4
#482: #277 := #276 ^ #276 >> 2
#483: #278 := #277 ^ #277 >> 1
#484: PF := ~0:0[#278]
#485: mem := mem with [#273, el]:u32 <- #274
#486: goto %#175

