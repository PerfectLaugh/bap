(executable
 (name rewrite)
 (preprocess
  (pps ppx_sexp_conv))
 (modules rewrite)
 (libraries bap-common base stdio sexplib dune-configurator dune-site))

(executable
 (name bapbuild)
 (public_name bapbuild)
 (package bap-build)
 (preprocess
  (pps ppx_bap))
 (modules bapbuild)
 (libraries core ocamlbuild bap-build compiler-libs))

(executable
 (name bapbundle)
 (public_name bapbundle)
 (package bap-bundle)
 (modules bapbundle)
 (libraries core core_unix.sys_unix bap-bundle fileutils uri))

(rule
 (target bap_config)
 (deps
  (:input bap_config.ab)
  (alias ../config)
  ../config.status)
 (action
  (with-stdin-from
   %{input}
   (with-stdout-to
    %{target}
    (chdir
     %{workspace_root}
     (run ./tools/rewrite.exe -filename %{input}))))))
