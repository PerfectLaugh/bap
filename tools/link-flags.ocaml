(* Prints the flags of the linker of OCaml, that the programs link with:
   the linker of Xcode 15 and later warns about the libraries, that it
   gets more than once, e.g., -lc++, which dune passes for each library
   with C++ stubs, or -lpthread, so it doesn't warn, if it accepts
   -no_warn_duplicate_libraries, which the older linkers reject.

   usage: ocaml link-flags.ocaml CC [FLAG...] *)

let () =
  let cc = List.tl (Array.to_list Sys.argv) in
  let flag = "-Wl,-no_warn_duplicate_libraries" in
  let source = "link_flags_test.c" and program = "link_flags_test.exe" in
  let out = open_out source in
  output_string out "int main(void) { return 0; }\n";
  close_out out;
  let command =
    String.concat " "
      (List.map Filename.quote (cc @ [ flag; source; "-o"; program ]))
  in
  let accepted =
    Sys.command (command ^ " > link_flags_test.log 2>&1") = 0
  in
  List.iter
    (fun file -> if Sys.file_exists file then Sys.remove file)
    [ source; program; "link_flags_test.log" ];
  print_string (if accepted then "(-ccopt " ^ flag ^ ")\n" else "()\n")
