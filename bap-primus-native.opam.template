build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "--promote-install-files=false"
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
  ["dune" "install" "-p" name "--create-install-files" name]
]

depexts: [
  ["cmake" "ninja-build"] {os-family = "debian"}
  ["cmake" "samurai"] {os-distribution = "alpine"}
  ["cmake" "ninja-build"] {os-distribution = "fedora"}
  ["cmake" "ninja"] {os-distribution = "arch"}
  ["cmake" "ninja"] {os = "macos" & os-distribution = "homebrew"}
  ["mingw-w64-x86_64-cmake" "mingw-w64-x86_64-ninja"] {os = "win32" & os-distribution = "msys2"}
]

extra-source "unicorn-2.1.4.tar.gz" {
  src:
    "https://github.com/unicorn-engine/unicorn/archive/refs/tags/2.1.4.tar.gz"
  checksum:
    "sha256=ea8863f095a0136388694e5a6063afd9bb7650e30243dd6251af59c5ce5601f4"
}
