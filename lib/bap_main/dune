(library
 (name bap_main)
 (public_name bap-main)
 (wrapped false)
 (libraries
  stdlib-shims
  base
  stdio
  cmdliner
  core
  core_kernel.caml_unix
  fileutils
  bap-future
  bap-bundle
  bap-common
  bap-plugins
  bap-recipe)
 (private_modules bap_main_dirs bap_main_log))

(rule
 (target bap_main_config.ml)
 (deps
  (:input bap_main_config.ml.ab)
  (alias ../../config)
  ../../config.status)
 (action
  (with-stdin-from
   %{input}
   (with-stdout-to
    %{target}
    (chdir
     %{workspace_root}
     (run ./tools/rewrite.exe -filename %{input}))))))
