(library
 (name bap_plugins)
 (public_name bap-plugins)
 (wrapped false)
 (modules :standard \ bap_common)
 (private_modules
  bap_plugins_config
  bap_plugins_loader_backend
  bap_plugins_package
  bap_plugins_units)
 (preprocess
  (pps ppx_bap))
 (libraries
  core
  dynlink
  findlib
  uri
  bap-bundle
  bap-common
  bap-future
  dune-site
  dune-site.plugins))

(rule
 (target bap_plugins_config.ml)
 (deps
  (:input bap_plugins_config.ml.ab)
  (alias ../../config)
  ../../config.status)
 (action
  (with-stdin-from
   %{input}
   (with-stdout-to
    %{target}
    (chdir
     %{workspace_root}
     (run ./tools/rewrite.exe -filename %{input}))))))
