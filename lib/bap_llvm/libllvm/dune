; Builds LLVM from its sources with the compilers of OCaml, see build.cmake.
; When installed with opam, the sources are fetched as an extra-source to
; the root of the project, otherwise they are downloaded by the script.

(rule
 (targets
  (dir llvm))
 (deps
  build.cmake
  (:tarball
   (glob_files %{project_root}/llvm-project-23.1.4.src.tar.xz)))
 (action
  (run
   cmake
   -DOUT=llvm
   -DTARBALL=%{tarball}
   "-DCC=%{cc}"
   "-DCXX=%{cxx}"
   -P
   %{dep:build.cmake})))
