(library
 (name bap_llvm)
 (public_name bap-llvm)
 (wrapped false)
 (preprocess
  (pps ppx_bap))
 (libraries bap core monads ogre)
 (foreign_stubs
  (language cxx)
  (names
   llvm_disasm
   llvm_error_or
   llvm_primitives
   llvm_loader
   llvm_loader_utils
   llvm_coff_loader
   llvm_elf_loader
   llvm_macho_loader
   llvm_pdb_loader
   llvm_demangle
   llvm_jit)
  (extra_deps
   (glob_files *.hpp)
   ; dune tracks only the *.h headers of the dependencies
   ../bap_disasm/disasm.hpp)
  (flags
   -I.
   :standard
   (:include cxx.flags)))
 ; the stubs that call the program, see llvm_register.cpp
 (foreign_stubs
  (language cxx)
  (names llvm_register)
  (extra_deps ../bap_disasm/disasm.hpp)
  (flags
   -I.
   :standard
   (:include cxx.flags)
   (:include c.flags)))
 (foreign_stubs
  (language c)
  (names llvm_stubs llvm_loader_stubs)
  (flags
   :standard
   (:include c.flags)))
 (c_library_flags
  (:include link.flags)
  (:include ../bap_disasm/cxx_runtime.flags)))

; the flags of the LLVM that libllvm builds from its sources, with its
; paths relative to the directory of the library, where the stubs are
; compiled, and to the root of the build context, where they are linked

(rule
 (targets c.flags cxx.flags link.flags bap_llvm_config.ml)
 (deps
  (:input bap_llvm_config.ml.ab)
  libllvm/llvm)
 (action
  (run
   ./config/llvm_configurator.exe
   -filename
   %{input}
   -llvm-config
   libllvm/llvm/bin/llvm-config%{ext_exe}
   -compile-prefix
   libllvm/llvm
   -link-prefix
   lib/bap_llvm/libllvm/llvm)))
