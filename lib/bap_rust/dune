(library
 (name bap_rust)
 (public_name bap-rust)
 (wrapped false)
 (modules bap_rust)
 (libraries core)
 (foreign_archives bap_ocaml)
 (c_library_flags -lpthread -ldl -lm))

(rule
 (targets libbap_ocaml.a dllbap_ocaml.so (dir cargo))
 (deps
  (glob_files_rec ../../rust/*.{rs,toml,lock}))
 (action
  (progn
   (run
    cargo
    build
    --locked
    --release
    --manifest-path
    %{workspace_root}/rust/Cargo.toml
    --package
    bap-ocaml
    --target-dir
    cargo)
   (system "cp cargo/release/libbap_ocaml.a libbap_ocaml.a")
   (system "cp cargo/release/libbap_ocaml.so dllbap_ocaml.so"))))
