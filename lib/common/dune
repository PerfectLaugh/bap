(library
 (name bap_common)
 (public_name bap-common)
 (wrapped false)
 (private_modules bap_common_build)
 (libraries unix dune-site dune-site.plugins))

(generate_sites_module
 (module bap_common_private_sites)
 (plugins
  (bap-common plugins)))

; the context and the libraries, that the program is built with, which
; are the ones of the program, that is run from the build tree

(rule
 (target bap_common_build.ml)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let context = {|%{context_name}|}\n")
    (echo "let stdlib = {|%{ocaml_where}|}\n")
    (echo "let ocamlpath = {|%{env:OCAMLPATH=}|}\n")))))
