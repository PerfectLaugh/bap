(library
 (name bap_ghidra)
 (public_name bap-ghidra)
 (wrapped false)
 (preprocess
  (pps ppx_bap))
 (libraries bap)
 (foreign_stubs
  (language cxx)
  (names ghidra_disasm)
  (extra_deps
   (glob_files *.hpp)
   ; dune tracks only the *.h headers of the dependencies
   ../bap_disasm/disasm.hpp
   libghidra/include)
  ; the headers of the library include its bundled zlib, see
  ; libghidra/build.cmake, as the library is built with it
  (flags :standard -fPIC -DLOCAL_ZLIB -isystem libghidra/include))
 ; the stubs that call the program, see ghidra_register.cpp
 (foreign_stubs
  (language cxx)
  (names ghidra_register)
  (extra_deps ../bap_disasm/disasm.hpp)
  (flags
   :standard
   -fPIC
   (:include libghidra/c.flags)))
 (foreign_stubs
  (language c)
  (names ghidra_stubs)
  (flags
   :standard
   (:include libghidra/c.flags)))
 ; the decompiler is linked statically, see libghidra/build.cmake
 (c_library_flags
  (:include libghidra/link.flags)
  (:include ../bap_disasm/cxx_runtime.flags)))
