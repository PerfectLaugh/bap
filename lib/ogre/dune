 (targets libbap_ogre.a dllbap_ogre.so)
 (deps ../bap_rust/libbap_ocaml.a ../bap_rust/dllbap_ocaml.so)
 (action
  (progn
   (copy ../bap_rust/libbap_ocaml.a libbap_ogre.a)
   (copy ../bap_rust/dllbap_ocaml.so dllbap_ogre.so))))
