(version 1)

(build
 (choice
  ((((arch x86_64)
     (os linux))
    ((arch arm64)
     (os linux))
    ((arch x86_64)
     (os macos))
    ((arch arm64)
     (os macos)))
   ((action
     (run pkg-config zlib))))
  ((((arch x86_64) (os win32)))
   ((action
     (run
      (when
       (catch_undefined_var (<> %{os_distribution} cygwinports) false)
       pkgconf)
      (when
       (catch_undefined_var (= %{os_distribution} cygwinports) false)
       pkg-config)
      (when false "")
      (when
       (catch_undefined_var
        (and_absorb_undefined_var
         (<> %{os_distribution} cygwinports)
         %{pkg:host-arch-x86_64:installed})
        false)
       --personality=x86_64-w64-mingw32)
      zlib))))))

(depends
 (choice
  ((((arch x86_64)
     (os linux))
    ((arch arm64)
     (os linux))
    ((arch x86_64)
     (os macos))
    ((arch arm64)
     (os macos)))
   (conf-pkg-config))
  ((((arch x86_64)
     (os win32)))
   (conf-pkg-config host-arch-x86_64 conf-mingw-w64-zlib-x86_64))))

(depexts
 ((zlib-dev)
  (= %{os_distribution} alpine))
 ((zlib1g-dev)
  (= %{os_family} debian))
 ((zlib1g-dev)
  (= %{os_family} ubuntu))
 ((zlib-static zlib-devel)
  (and_absorb_undefined_var
   (= %{os_distribution} centos)
   (< %{os_version} 10)))
 ((zlib-ng-compat-static zlib-ng-compat-devel)
  (and_absorb_undefined_var
   (= %{os_distribution} centos)
   (>= %{os_version} 10)))
 ((zlib-devel)
  (and_absorb_undefined_var
   (= %{os_family} fedora)
   (< %{os_version} 40)))
 ((zlib-ng-compat-static zlib-ng-compat-devel)
  (and_absorb_undefined_var
   (= %{os_family} fedora)
   (>= %{os_version} 40)))
 ((zlib-devel)
  (= %{os_distribution} ol))
 ((zlib)
  (= %{os_distribution} nixos))
 ((zlib)
  (and_absorb_undefined_var
   (= %{os_distribution} homebrew)
   (= %{os} macos)))
 ((zlib)
  (= %{os_family} arch))
 ((zlib)
  (and_absorb_undefined_var
   (= %{os} win32)
   (= %{os_distribution} cygwinports)))
 ((zlib-devel)
  (= %{os} cygwin))
 ((zlib-ng-compat-devel)
  (= %{os_family} opensuse))
 ((zlib-devel)
  (and_absorb_undefined_var
   (= %{os_family} suse)
   (< %{os_version} 16)))
 ((zlib-ng-compat-devel)
  (and_absorb_undefined_var
   (= %{os_family} suse)
   (>= %{os_version} 16))))
