(version 1)

(build
 (choice
  ((((arch x86_64) (os win32)))
   ((action (run x86_64-w64-mingw32-g++ --version))))))

(depends
 (choice
  ((((arch x86_64) (os win32))) (conf-mingw-w64-gcc-x86_64))))

(depexts
 ((mingw64-x86_64-gcc-g++)
  (and_absorb_undefined_var
   (= %{os} win32)
   (= %{os_distribution} cygwin))))

(enabled_on_platforms
 (only
  ((arch x86_64)
   (os win32))))
