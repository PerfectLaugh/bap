(version 0.1)

(build
 (all_platforms
  ((action
    (progn
     (substitute find-radare2.ml.in find-radare2.ml)
     (run ocaml unix.cma find-radare2.ml))))))

(depends
 (all_platforms
  (ocaml base-unix conf-which)))

(depexts
 ((radare2)
  (= %{os_family} debian))
 ((radare2)
  (= %{os_family} fedora))
 ((radare2)
  (= %{os_distribution} arch))
 ((radare2)
  (= %{os_distribution} alpine))
 ((radare2)
  (= %{os_distribution} gentoo))
 ((radare2)
  (or_absorb_undefined_var
   (= %{os_family} suse)
   (= %{os_family} opensuse)))
 ((radare2)
  (and_absorb_undefined_var
   (= %{os_distribution} homebrew)
   (= %{os} macos)))
 ((radare2)
  (= %{os_distribution} freebsd)))

(extra_sources
 (find-radare2.ml.in
  (fetch
   (url
    https://raw.githubusercontent.com/ocaml/opam-source-archives/main/patches/conf-radare2/find-radare2.ml.in)
   (checksum
    sha256=729155faf47b7f915b155036e83a773e70ec49beb0708b05fbc4036268da7b6d))))
