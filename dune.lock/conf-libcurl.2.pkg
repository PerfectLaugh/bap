(version 2)

(build
 (choice
  ((((arch x86_64)
     (os linux))
    ((arch arm64)
     (os linux))
    ((arch x86_64)
     (os macos))
    ((arch arm64)
     (os macos)))
   ((action
     (run curl-config --libs))))
  ((((arch x86_64) (os win32)))
   ((action
     (run
      (when
       (catch_undefined_var (<> %{os_distribution} cygwinports) false)
       sh)
      curl-config
      --libs))))))

(depends
 (choice
  ((((arch x86_64)
     (os linux))
    ((arch arm64)
     (os linux))
    ((arch x86_64)
     (os macos))
    ((arch arm64)
     (os macos)))
   ())
  ((((arch x86_64)
     (os win32)))
   (host-arch-x86_64 conf-mingw-w64-gcc-x86_64 conf-mingw-w64-curl-x86_64))))

(depexts
 ((libcurl4-gnutls-dev)
  (= %{os_family} debian))
 ((libcurl4-gnutls-dev)
  (= %{os_family} ubuntu))
 ((libcurl-devel)
  (= %{os_distribution} mageia))
 ((openssl-devel libcurl-devel)
  (= %{os_distribution} centos))
 ((curl)
  (= %{os_distribution} nixos))
 ((curl)
  (= %{os_distribution} arch))
 ((curl)
  (and_absorb_undefined_var
   (= %{os} win32)
   (= %{os_distribution} cygwinports)))
 ((curl-dev)
  (= %{os_distribution} alpine))
 ((libcurl-devel)
  (or_absorb_undefined_var
   (= %{os_family} suse)
   (= %{os_family} opensuse)))
 ((libcurl-devel)
  (= %{os_family} fedora))
 ((libcurl-devel)
  (= %{os_distribution} ol))
 ((curl)
  (and_absorb_undefined_var
   (= %{os_distribution} homebrew)
   (= %{os} macos)))
 ((curl)
  (and_absorb_undefined_var
   (= %{os_distribution} macports)
   (= %{os} macos)))
 ((curl)
  (= %{os} freebsd)))
