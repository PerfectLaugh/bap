(version 1)

(install
 (choice
  ((((arch x86_64)
     (os macos))
    ((arch arm64)
     (os macos)))
   (when
    (or_absorb_undefined_var
     (= %{os_distribution} homebrew)
     (= %{os_distribution} macports))
    (run sh -c "ln -s \"$(which gm4)\" \"%{bin}/m4\"")))))

(build
 (choice
  ((((arch x86_64)
     (os linux))
    ((arch arm64)
     (os linux)))
   ((action
     (run sh -exc "echo | m4"))))
  ((((arch x86_64)
     (os macos))
    ((arch arm64)
     (os macos)))
   ((action
     (run sh -exc "echo | gm4"))))))

(depexts
 ((m4)
  (= %{os_family} debian))
 ((m4)
  (= %{os_family} ubuntu))
 ((m4)
  (= %{os_family} fedora))
 ((m4)
  (= %{os_distribution} rhel))
 ((m4)
  (= %{os_distribution} centos))
 ((m4)
  (= %{os_distribution} alpine))
 ((m4)
  (= %{os_distribution} nixos))
 ((m4)
  (or_absorb_undefined_var
   (= %{os_family} suse)
   (= %{os_family} opensuse)))
 ((m4)
  (= %{os_distribution} ol))
 ((m4)
  (= %{os_distribution} arch))
 ((m4)
  (= %{os_distribution} cygwin))
 ((m4)
  (= %{os_distribution} msys2)))

(enabled_on_platforms
 (only
  ((arch x86_64)
   (os linux))
  ((arch arm64)
   (os linux))
  ((arch x86_64)
   (os macos))
  ((arch arm64)
   (os macos))))
