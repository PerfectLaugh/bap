(version v0.17.0)

(build
 (choice
  ((((arch x86_64)
     (os linux))
    ((arch arm64)
     (os linux))
    ((arch x86_64)
     (os macos))
    ((arch arm64)
     (os macos)))
   ((action
     (run dune build -p %{pkg-self:name} -j %{jobs}))))))

(depends
 (choice
  ((((arch x86_64)
     (os linux))
    ((arch arm64)
     (os linux))
    ((arch x86_64)
     (os macos))
    ((arch arm64)
     (os macos)))
   (ocaml core ppx_jane dune))))

(source
 (fetch
  (url
   https://github.com/janestreet/timezone/archive/refs/tags/v0.17.0.tar.gz)
  (checksum
   sha256=43026ee35551b996c627b0759e20da1a01609a3fd999eb6ba3149632dd625adf)))

(enabled_on_platforms
 (only
  ((arch x86_64)
   (os linux))
  ((arch arm64)
   (os linux))
  ((arch x86_64)
   (os macos))
  ((arch arm64)
   (os macos))))
