; powerpc, see lib_test/cross/lifter_gen.ml
(toolchain cross)
(cc_target powerpc-linux-gnu)
(qemu qemu-ppc)
(mc_triple powerpc)
(mode ppc32)
(cc_flags (-mno-altivec))
(drop (OV32 CA32))
(mc_flags (-mcpu=pwr9))
(arch ppc)
(helpers Powerpc_tests_helpers)
(gpr (0 1 0x7f 0x80 0x7fff 0x8000 0x7fffffff 0x80000000 0xffffffff 0x12345678 0xfedcba98))
(gpr2 (0 1 0x80 0x7fff 0x80000000 0xffffffff 0x7fffffff 0x12345678))
(sets
 (bit (0 1))
 (count (0 1 7 8 15 16 31 32 33 63 64 127))
 (ctr (0 1 2 0x100000001))
 (lr (0x20400 0x20403))
 (dds (0 1 0x7f 0xffffffffffffffff 0xffffffffffffff80))
 (dd (0 0x8000000000000000 0x7fffffffffffffff 0x123456789abcdef0 0xfedcba9876543210))
 (sel (0x0001020304050607 0x3f3e3d3c3b3a3938 0x4000ff0810203038 0x0706050403020100)))
(kinds
 ((CR[0-7]* SO OV CA OV32 CA32) bit)
 ((CTR) ctr))
