(executable
 (name run_x86_tests)
 (libraries
  bap
  bap-x86
  bap-plugins
  bap-main
  ounit2
  primus_bil
  lifter_test
  threads))

; the tests are generated from the specs, with the expected values
; computed by executing the instructions, see lib_test/cross/lifter_gen.ml

(rule
 (target test_x86_64.ml)
 (deps
  (glob_files gen/*))
 (action
  (with-stdout-to
   %{target}
   (run
    %{exe:../cross/lifter_gen.exe}
    -runner
    gen
    gen/x86_64.sexp
    gen/x86_64.spec
    X86_64))))

(rule
 (target test_i686.ml)
 (deps
  (glob_files gen/*))
 (action
  (with-stdout-to
   %{target}
   (run
    %{exe:../cross/lifter_gen.exe}
    -runner
    gen
    gen/i686.sexp
    gen/i686.spec
    I686))))

; the instruction tests are slow, so they don't run with dune test, run
; them with dune build @instruction-tests, in 4 processes, each loads the
; semantics of its targets, so more processes take more memory, about
; 1.5 GB each, and not less time. OUnit collects the heap after each test, which is the
; most of the time of the tests, as the heap has the knowledge base of the
; lifters, the tests don't need it

(rule
 (alias instruction-tests)
 (enabled_if
  (<> %{os_type} Win32))
 (action
  (setenv
   OUNIT_RUN_GC_FULL_MAJOR
   false
   (run %{exe:run_x86_tests.exe} -runner processes -shards 4))))

; the processes runner of OUnit forks, which Windows can't do

(rule
 (alias instruction-tests)
 (enabled_if
  (= %{os_type} Win32))
 (action
  (setenv
   OUNIT_RUN_GC_FULL_MAJOR
   false
   (run %{exe:run_x86_tests.exe} -runner sequential))))
