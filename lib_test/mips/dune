(executable
 (name run_mips_tests)
 (libraries bap bap-plugins bap-main ounit2 primus_bil lifter_test threads))

; the tests are generated from the specs, with the expected values
; computed by executing the instructions under QEMU, see
; lib_test/cross/lifter_gen.ml, the 32-bit instructions are also tested in the
; 64-bit modes, with sign-extended operands

(rule
 (target test_mips32eb.ml)
 (deps
  (glob_files gen/*)
  (glob_files %{project_root}/lib_test/cross/*))
 (action
  (with-stdout-to
   %{target}
   (run
    %{exe:../cross/lifter_gen.exe}
    -runner
    %{project_root}/lib_test/cross
    gen/mips.sexp
    gen/mips32.spec
    MIPS32eb))))

(rule
 (target test_mips32le.ml)
 (deps
  (glob_files gen/*)
  (glob_files %{project_root}/lib_test/cross/*))
 (action
  (with-stdout-to
   %{target}
   (run
    %{exe:../cross/lifter_gen.exe}
    -runner
    %{project_root}/lib_test/cross
    gen/mipsel.sexp
    gen/mips32.spec
    MIPS32le))))

