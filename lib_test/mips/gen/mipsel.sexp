; mipsel, see lib_test/cross/lifter_gen.ml
(toolchain cross)
(cc_target mipsel-linux-gnu)
(qemu qemu-mipsel)
(mc_triple mipsel)
(mc_flags (-mcpu=mips32r2))
(mode mips32le)
(cc_flags (-mno-abicalls -G0 -Wl,-e,__start))
(arch mips)
(prelude ".set noreorder")
(helpers Mips_tests_helpers)
(gpr (0 1 0x7f 0x80 0x7fff 0x8000 0x7fffffff 0x80000000 0xffffffff 0x12345678 0xfedcba98))
(gpr2 (0 1 0x80 0x7fff 0x80000000 0xffffffff 0x7fffffff 0x12345678))
(sets
 (count (0 1 7 8 15 16 31 32 33 63 64))
 (byte (0 1 0x7f 0x80 0xff))
 (nz (1 2 0x7f 0x80 0x7fffffff 0x80000000 0xffffffff 0xfffffffe 0x12345678 0x10)))
