; OUnit collects the heap after each test, which takes the most of the time
; of the tests when the plugins are loaded, the tests don't need it

(test
 (name run_protobuf_tests)
 (package bap-protobuf)
 (preprocess
  (pps ppx_bap))
 (libraries bap bap-main bap-protobuf bap-protobuf.plugin core ounit2 threads)
 (action
  (setenv
   OUNIT_RUN_GC_FULL_MAJOR
   false
   (run %{test}))))
