(executable
 (name run_arm_tests)
 (libraries
  bap
  bap-core-theory
  bap-knowledge
  bap-plugins
  bap-main
  ounit2
  primus_bil
  lifter_test
  threads))

; the instruction tests are slow, so they don't run with dune test, run
; them with dune build @instruction-tests, in one process, as the most of
; the time of a process is loading the semantics of its targets. OUnit collects the heap after each test, which is the
; most of the time of the tests, as the heap has the knowledge base of the
; lifters, the tests don't need it

(rule
 (alias instruction-tests)
 (action
  (setenv
   OUNIT_RUN_GC_FULL_MAJOR
   false
   (run %{exe:run_arm_tests.exe} -runner sequential))))

; the A32 tests with the expected values computed by executing the
; instructions under QEMU, see lib_test/cross/lifter_gen.ml

(rule
 (target test_a32_qemu.ml)
 (deps
  (glob_files gen/*)
  (glob_files %{project_root}/lib_test/cross/*))
 (action
  (with-stdout-to
   %{target}
   (run
    %{exe:../cross/lifter_gen.exe}
    -runner
    %{project_root}/lib_test/cross
    gen/a32.sexp
    gen/a32_qemu.spec
    A32_QEMU))))

(rule
 (target test_t32_qemu.ml)
 (deps
  (glob_files gen/*)
  (glob_files %{project_root}/lib_test/cross/*))
 (action
  (with-stdout-to
   %{target}
   (run
    %{exe:../cross/lifter_gen.exe}
    -runner
    %{project_root}/lib_test/cross
    gen/t32.sexp
    gen/t32_qemu.spec
    T32_QEMU))))
