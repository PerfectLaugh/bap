(executable
 (name controlled_opt)
 (modules controlled_opt))

(test
 (name run_tests)
 (modules run_tests)
 (libraries bap-recompile core ounit2)
 (deps controlled_opt.exe)
 (action
  (setenv
   BAP_RECOMPILE_TEST_OPT
   %{exe:controlled_opt.exe}
   (run %{test}))))

(test
 (name run_mba_tests)
 (modules run_mba_tests)
 (libraries bap-recompile core ounit2))

(executable
 (name run_lean_tests)
 (modules run_lean_tests)
 (libraries bap-recompile bap-bil.plugin core ounit2))

(rule
 (alias lean-tests)
 (deps controlled_opt.exe)
 (action
  (setenv
   BAP_RECOMPILE_TEST_OPT
   %{exe:controlled_opt.exe}
   (run %{exe:run_lean_tests.exe} -runner processes -shards 2))))
