# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "dev"
synopsis: "Runs the code in Primus with the Unicorn CPU emulator"
description: """
Links the Unicorn emulator engine, which is licensed under GPL-2.0,
so this package is distributed under GPL-2.0, unlike the rest of BAP."""
maintainer: ["Ivan Gotovchits <ivg@ieee.org>"]
authors: ["The BAP Team"]
license: "GPL-2.0-only"
tags: ["bap" "bap-primus" "unicorn"]
homepage: "https://github.com/BinaryAnalysisPlatform/bap"
bug-reports: "https://github.com/BinaryAnalysisPlatform/bap/issues"
depends: [
  "dune" {>= "3.24"}
  "bap-common" {= version}
  "bap-core-theory" {= version}
  "bap-main" {= version}
  "bap-primus" {= version}
  "bap-std" {= version}
  "bitvec" {= version}
  "core"
  "monads" {= version}
  "ppx_bap" {= version}
  "bap-arm" {with-test & = version}
  "bap-mips" {with-test & = version}
  "bap-powerpc" {with-test & = version}
  "bap-riscv" {with-test & = version}
  "bap-x86" {with-test & = version}
  "odoc" {with-doc}
]
dev-repo: "git+https://github.com/BinaryAnalysisPlatform/bap.git"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "--promote-install-files=false"
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
  ["dune" "install" "-p" name "--create-install-files" name]
]

depexts: [
  ["cmake" "ninja-build"] {os-family = "debian"}
  ["cmake" "samurai"] {os-distribution = "alpine"}
  ["cmake" "ninja-build"] {os-distribution = "fedora"}
  ["cmake" "ninja"] {os-distribution = "arch"}
  ["cmake" "ninja"] {os = "macos" & os-distribution = "homebrew"}
  ["mingw-w64-x86_64-cmake" "mingw-w64-x86_64-ninja"] {os = "win32" & os-distribution = "msys2"}
]

extra-source "unicorn-2.1.4.tar.gz" {
  src:
    "https://github.com/unicorn-engine/unicorn/archive/refs/tags/2.1.4.tar.gz"
