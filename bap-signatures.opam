# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "dev"
synopsis: "A data package with BAP binary signatures"
maintainer: ["Ivan Gotovchits <ivg@ieee.org>"]
authors: ["The BAP Team"]
license: "MIT"
tags: ["bap" "data"]
homepage: "https://github.com/BinaryAnalysisPlatform/bap"
bug-reports: "https://github.com/BinaryAnalysisPlatform/bap/issues"
depends: [
  "dune" {>= "3.24"}
  "bap-common" {= version}
  "odoc" {with-doc}
]
dev-repo: "git+https://github.com/BinaryAnalysisPlatform/bap.git"
x-maintenance-intent: ["(latest)"]

build: []
install: [
  ["cmake" "-E" "tar" "xf" "sigs.tar.gz"]
  ["cmake" "-E" "make_directory" "%{share}%/bap/signatures"]
  ["cmake" "-E" "copy" "data/sigs.zip" "%{share}%/bap/signatures/byteweight.zip"]
  ["cmake" "-E" "copy_directory" "data/Ghidra" "%{share}%/bap/signatures/Ghidra"]
]
extra-source "sigs.tar.gz" {
  src:
    "https://github.com/BinaryAnalysisPlatform/bap/releases/download/v2.4.0/sigs.tar.gz"
  checksum: "md5=04e2ebb1b30d2d12bf2ceb240544044f"
}

# the signatures are extracted and installed with cmake -E, which works
# on every system, unlike tar and cp
depexts: [
  ["cmake"] {os-family = "debian"}
  ["cmake"] {os-distribution = "alpine"}
  ["cmake"] {os-distribution = "fedora"}
  ["cmake"] {os-distribution = "arch"}
  ["cmake"] {os = "macos" & os-distribution = "homebrew"}
  ["mingw-w64-x86_64-cmake"] {os = "win32" & os-distribution = "msys2"}
]
