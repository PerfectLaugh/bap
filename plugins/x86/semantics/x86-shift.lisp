;; SHLD and SHRD shift X filled with the bits of Y, the count is masked
;; to the size less one
(defun shld-op (x y c)
  (let ((n (word-width x))
        (k (resize n (logand (cast-low 8 c) (resize 8 (- n 1)))))
        (r (logor (lshift x k) (rshift y (- (resize n n) k)))))
    (when (non-zero k)
      (set CF (lsb (rshift x (- (resize n n) k))))
      (when (= k (one-of k)) (set OF (msb (logxor x r))))
      (set-result-flags r))
    (if (is-zero k) x r)))

(defun shrd-op (x y c)
  (let ((n (word-width x))
        (k (resize n (logand (cast-low 8 c) (resize 8 (- n 1)))))
        (r (logor (rshift x k) (lshift y (- (resize n n) k)))))
    (when (non-zero k)
      (set CF (msb (lshift x (- (resize n n) k))))
      (when (= k (one-of k)) (set OF (msb (logxor x r))))
      (set-result-flags r))
    (if (is-zero k) x r)))

(defmacro shiftd-r (op rd x y c) (set-gpr rd (op x y c)))
(defmacro shiftd-m (op y c base scale index off seg)
  (let ((a (ea base scale index off seg)))
    (store-n (word-width y) a (op (load-n (word-width y) a) y c))))

