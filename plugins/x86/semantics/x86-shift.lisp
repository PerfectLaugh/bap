(declare (context (target x86)))
(require x86-common)

(in-package x86-common)

;;; SHIFTS AND ROTATIONS
;;
;; The count is masked to 5 bits, or to 6 bits for the 64-bit operands,
;; whatever the size of the operand is, and the flags are not changed
;; when it is zero. CF is the bit shifted or rotated out last, OF is
;; defined for the count of 1 only and is not changed otherwise, AF is
;; undefined and is not changed.

(defun count-mask (x) (if (= (word-width x) 64) 0x3f:8 0x1f:8))
(defun masked-count (x c)
  (resize (word-width x) (logand (cast-low 8 c) (count-mask x))))

(defun shl-op (x c)
  (let ((n (word-width x))
        (k (masked-count x c))
        (r (lshift x k)))
    (when (non-zero k)
      (set CF (lsb (rshift x (- (resize n n) k))))
      (when (= k (one-of k)) (set OF (logxor (msb r) CF)))
      (set-result-flags r))
    r))

(defun shr-op (x c)
  (let ((n (word-width x))
        (k (masked-count x c))
        (r (rshift x k)))
    (when (non-zero k)
      (set CF (msb (lshift x (- (resize n n) k))))
      (when (= k (one-of k)) (set OF (msb x)))
      (set-result-flags r))
    r))

(defun sar-op (x c)
  (let ((n (word-width x))
        (k (masked-count x c))
        (r (arshift x k)))
    (when (non-zero k)
      ;; the bits shifted out last are copies of the sign
      (set CF (if (< k (resize n n)) (msb (lshift x (- (resize n n) k))) (msb x)))
      (when (= k (one-of k)) (set OF 0:1))
      (set-result-flags r))
    r))

;; ROL and ROR rotate by the count modulo the size
(defun rol-op (x c)
  (let ((n (word-width x))
        (k (masked-count x c))
        (r (rotate-left x (logand k (resize n (- n 1))))))
    (when (non-zero k)
      (set CF (lsb r))
      (when (= k (one-of k)) (set OF (logxor (msb r) CF))))
    r))

(defun ror-op (x c)
  (let ((n (word-width x))
        (k (masked-count x c))
        (r (rotate-right x (logand k (resize n (- n 1))))))
    (when (non-zero k)
      (set CF (msb r))
      (when (= k (one-of k)) (set OF (logxor (msb r) (msb (lshift r 1))))))
    r))

;; RCL and RCR rotate CF:X by the count modulo the size plus one
(defun rcl-op (x c)
  (let ((n (word-width x))
        (k (masked-count x c))
        (y (concat CF x))
        (m (resize (+ n 1) (mod k (resize n (+ n 1)))))
        (r (rotate-left y m)))
    (when (non-zero k)
      (set CF (msb r))
      (when (= k (one-of k)) (set OF (logxor (msb (cast-low n r)) CF))))
    (cast-low n r)))

(defun rcr-op (x c)
  (let ((n (word-width x))
        (k (masked-count x c))
        (y (concat CF x))
        (m (resize (+ n 1) (mod k (resize n (+ n 1)))))
        (r (rotate-right y m))
        (z (cast-low n r)))
    (when (non-zero k)
      (set CF (msb r))
      (when (= k (one-of k)) (set OF (logxor (msb z) (msb (lshift z 1))))))
    z))

(defmacro shift-r (op rd x c) (set-gpr rd (op x c)))
(defmacro shift-m (op n c base scale index off seg)
  (let ((a (ea base scale index off seg)))
    (store-n n a (op (load-n n a) c))))

