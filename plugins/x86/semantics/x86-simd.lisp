;; INSERTPS inserts the doubleword of the source selected by the bits
;; 7-6 of the immediate in the position of the bits 5-4, the bits 3-0
;; clear the lanes
(defun insertps (x v n)
  (let ((r (insert-lane 32 x v (logand (rshift n 4) 3))))
    (concat (if (non-zero (logand n 8)) 0:32 (extract 127 96 r))
            (if (non-zero (logand n 4)) 0:32 (extract 95 64 r))
            (if (non-zero (logand n 2)) 0:32 (extract 63 32 r))
            (if (non-zero (logand n 1)) 0:32 (extract 31 0 r)))))
(defun INSERTPSrri (rd x y n) (set$ rd (insertps x (extract-lane 32 y (logand (rshift n 6) 3)) n)))
(defun INSERTPSrmi (rd x base scale index off seg n) (set$ rd (insertps x (load-n 32 (ea base scale index off seg)) n)))
(defun VINSERTPSrri (rd x y n) (set-vex rd (insertps x (extract-lane 32 y (logand (rshift n 6) 3)) n)))
(defun VINSERTPSrmi (rd x base scale index off seg n) (set-vex rd (insertps x (load-n 32 (ea base scale index off seg)) n)))

