(defun MOVSX32rm16 (rd base scale index off seg) (set-gpr rd (cast-signed 32 (load-n 16 (ea base scale index off seg)))))
(defun MOVSX64rr8 (rd x) (set-gpr rd (cast-signed 64 (cast-low 8 x))))
(defun MOVSX64rm8 (rd base scale index off seg) (set-gpr rd (cast-signed 64 (load-n 8 (ea base scale index off seg)))))
(defun MOVSX64rr16 (rd x) (set-gpr rd (cast-signed 64 (cast-low 16 x))))
(defun MOVSX64rm16 (rd base scale index off seg) (set-gpr rd (cast-signed 64 (load-n 16 (ea base scale index off seg)))))
