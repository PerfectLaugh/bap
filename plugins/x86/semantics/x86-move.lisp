(defun MOVSX32rm32 (rd base scale index off seg) (set-gpr rd (cast-signed 32 (load-n 32 (ea base scale index off seg)))))
(defun MOVSX16rr16 (rd x) (set-gpr rd (cast-signed 16 (cast-low 16 x))))
(defun MOVSX16rm16 (rd base scale index off seg) (set-gpr rd (cast-signed 16 (load-n 16 (ea base scale index off seg)))))

;; LEA computes the address without the segment base, truncated to the
;; size of the destination

(defun LEA16r (rd base scale index off seg)
  (set-gpr rd (cast-low 16 (operand-address base scale index off))))
(defun LEA32r (rd base scale index off seg)
  (set-gpr rd (cast-low 32 (operand-address base scale index off))))
(defun LEA64r (rd base scale index off seg)
  (set-gpr rd (cast-low 64 (operand-address base scale index off))))
(defun LEA64_32r (rd base scale index off seg)
  (set-gpr rd (cast-low 32 (operand-address base scale index off))))

;; XCHG, XADD and CMPXCHG

(defun XCHG8rr (r1 r2 x1 x2)
  (let ((a x1) (b x2)) (set-gpr r1 b) (set-gpr r2 a)))
(defun XCHG8rm (rd x base scale index off seg)
  (let ((a (ea base scale index off seg)) (v (load-n 8 a))) (store-n 8 a x) (set-gpr rd v)))
(defun XCHG16rr (r1 r2 x1 x2)
  (let ((a x1) (b x2)) (set-gpr r1 b) (set-gpr r2 a)))
(defun XCHG16rm (rd x base scale index off seg)
  (let ((a (ea base scale index off seg)) (v (load-n 16 a))) (store-n 16 a x) (set-gpr rd v)))
(defun XCHG32rr (r1 r2 x1 x2)
  (let ((a x1) (b x2)) (set-gpr r1 b) (set-gpr r2 a)))
(defun XCHG32rm (rd x base scale index off seg)
  (let ((a (ea base scale index off seg)) (v (load-n 32 a))) (store-n 32 a x) (set-gpr rd v)))
(defun XCHG64rr (r1 r2 x1 x2)
  (let ((a x1) (b x2)) (set-gpr r1 b) (set-gpr r2 a)))
(defun XCHG64rm (rd x base scale index off seg)
  (let ((a (ea base scale index off seg)) (v (load-n 64 a))) (store-n 64 a x) (set-gpr rd v)))
(defun XCHG16ar (rd x)
  (let ((a AX) (b x)) (set-ax b) (set-gpr rd a)))
(defun XCHG32ar (rd x)
  (let ((a EAX) (b x)) (set-eax b) (set-gpr rd a)))
(defun XCHG64ar (rd x) (declare (context (bits 64)))
  (let ((a RAX) (b x)) (set-rax b) (set-gpr rd a)))
(defun XADD8rr (d s x y)
  (let ((a x) (r (add-op x y))) (set-gpr s a) (set-gpr d r)))
(defun XADD8rm (s x base scale index off seg)
  (let ((a (ea base scale index off seg)) (v (load-n 8 a)) (r (add-op v x)))
    (set-gpr s v)
    (store-n 8 a r)))
(defun XADD16rr (d s x y)
  (let ((a x) (r (add-op x y))) (set-gpr s a) (set-gpr d r)))
(defun XADD16rm (s x base scale index off seg)
  (let ((a (ea base scale index off seg)) (v (load-n 16 a)) (r (add-op v x)))
    (set-gpr s v)
    (store-n 16 a r)))
(defun XADD32rr (d s x y)
  (let ((a x) (r (add-op x y))) (set-gpr s a) (set-gpr d r)))
(defun XADD32rm (s x base scale index off seg)
  (let ((a (ea base scale index off seg)) (v (load-n 32 a)) (r (add-op v x)))
    (set-gpr s v)
    (store-n 32 a r)))
(defun XADD64rr (d s x y)
  (let ((a x) (r (add-op x y))) (set-gpr s a) (set-gpr d r)))
(defun XADD64rm (s x base scale index off seg)
  (let ((a (ea base scale index off seg)) (v (load-n 64 a)) (r (add-op v x)))
    (set-gpr s v)
    (store-n 64 a r)))

;; CMPXCHG compares the accumulator with the destination, which is
;; replaced if they are equal, the accumulator is loaded otherwise
(defmacro cmpxchg-r (acc set-acc rd y)
  (let ((x rd) (v y))
    (sub-op acc x)
    (if ZF (set-gpr rd v) (set-acc x))))

(defmacro cmpxchg-m (acc set-acc n y base scale index off seg)
  (let ((a (ea base scale index off seg)) (x (load-n n a)))
    (sub-op acc x)
    (if ZF (store-n n a y) (set-acc x))))

(defun CMPXCHG8rr (rd y) (cmpxchg-r AL set-al rd y))
(defun CMPXCHG8rm (base scale index off seg y) (cmpxchg-m AL set-al 8 y base scale index off seg))
(defun CMPXCHG16rr (rd y) (cmpxchg-r AX set-ax rd y))
(defun CMPXCHG16rm (base scale index off seg y) (cmpxchg-m AX set-ax 16 y base scale index off seg))
(defun CMPXCHG32rr (rd y) (cmpxchg-r EAX set-eax rd y))
(defun CMPXCHG32rm (base scale index off seg y) (cmpxchg-m EAX set-eax 32 y base scale index off seg))
(defun CMPXCHG64rr (rd y) (declare (context (bits 64))) (cmpxchg-r RAX set-rax rd y))
(defun CMPXCHG64rm (base scale index off seg y) (declare (context (bits 64))) (cmpxchg-m RAX set-rax 64 y base scale index off seg))

(defun CMPXCHG8B (base scale index off seg)
  (let ((a (ea base scale index off seg)) (x (load-n 64 a)))
    (if (= x (concat EDX EAX))
        (prog (set ZF 1:1) (store-n 64 a (concat ECX EBX)))
      (prog
        (set ZF 0:1)
        (set-edx (cast-high 32 x))
        (set-eax (cast-low 32 x))))))

(defun CMPXCHG16B (base scale index off seg)
  (declare (context (bits 64)))
  (let ((a (ea base scale index off seg)) (x (load-n 128 a)))
    (if (= x (concat RDX RAX))
        (prog (set ZF 1:1) (store-n 128 a (concat RCX RBX)))
      (prog
        (set ZF 0:1)
        (set RDX (cast-high 64 x))
        (set RAX (cast-low 64 x))))))

;;; THE STACK
;;
;; The memory operands of PUSH are read before the stack pointer is
;; decremented, the ones of POP are computed after it is incremented.

(defun push-n (n x)
  "the value is read before the stack pointer is decremented, e.g., of
   push %rsp, which pushes its old value"
  (declare (context (bits 64)))
  (let ((v x))
    (set RSP (- RSP (/ n 8)))
    (store-n n RSP v)))

(defun push-n (n x)
  (declare (context (bits 32)))
  (let ((v x))
    (set ESP (- ESP (/ n 8)))
    (store-n n ESP v)))

(defun pop-n (n)
  (declare (context (bits 64)))
  (let ((x (load-n n RSP)))
    (set RSP (+ RSP (/ n 8)))
    x))

(defun pop-n (n)
  (declare (context (bits 32)))
  (let ((x (load-n n ESP)))
    (set ESP (+ ESP (/ n 8)))
    x))

(defun PUSH16r (x) (push-n 16 x))
(defun PUSH16rmr (x) (push-n 16 x))
(defun PUSH16rmm (base scale index off seg) (push-n 16 (load-n 16 (ea base scale index off seg))))
(defun PUSH16i8 (imm) (push-n 16 imm))
(defun POP16r (rd) (set-gpr rd (pop-n 16)))
(defun POP16rmr (rd) (set-gpr rd (pop-n 16)))
(defun POP16rmm (base scale index off seg) (let ((x (pop-n 16))) (store-n 16 (ea base scale index off seg) x)))
(defun PUSH32r (x) (push-n 32 x))
(defun PUSH32rmr (x) (push-n 32 x))
(defun PUSH32rmm (base scale index off seg) (push-n 32 (load-n 32 (ea base scale index off seg))))
(defun PUSH32i8 (imm) (push-n 32 imm))
(defun POP32r (rd) (set-gpr rd (pop-n 32)))
(defun POP32rmr (rd) (set-gpr rd (pop-n 32)))
(defun POP32rmm (base scale index off seg) (let ((x (pop-n 32))) (store-n 32 (ea base scale index off seg) x)))
(defun PUSH64r (x) (push-n 64 x))
(defun PUSH64rmr (x) (push-n 64 x))
(defun PUSH64rmm (base scale index off seg) (push-n 64 (load-n 64 (ea base scale index off seg))))
(defun PUSH64i8 (imm) (push-n 64 imm))
(defun POP64r (rd) (set-gpr rd (pop-n 64)))
(defun POP64rmr (rd) (set-gpr rd (pop-n 64)))
(defun POP64rmm (base scale index off seg) (let ((x (pop-n 64))) (store-n 64 (ea base scale index off seg) x)))
(defun PUSH16i (imm) (push-n 16 imm))
(defun PUSH32i (imm) (push-n 32 imm))
(defun PUSH64i32 (imm) (push-n 64 imm))

;; the flags, the reserved bit 1 is set
(defun flags-word () (logor EFLAGS 2))

(defun PUSHF16 () (push-n 16 (flags-word)))
(defun PUSHF32 () (push-n 32 (flags-word)))
(defun PUSHF64 () (push-n 64 (flags-word)))
(defun POPF16 () (set EFLAGS (concat (cast-high 16 EFLAGS) (pop-n 16))))
(defun POPF32 () (set EFLAGS (pop-n 32)))
(defun POPF64 () (set EFLAGS (cast-low 32 (pop-n 64))))

(defun LAHF ()
  (set AH (concat SF ZF 0:1 AF 0:1 PF 1:1 CF)))

(defun SAHF ()
  (let ((x AH))
    (set SF (extract 7 7 x))
    (set ZF (extract 6 6 x))
    (set AF (extract 4 4 x))
    (set PF (extract 2 2 x))
    (set CF (extract 0 0 x))))

(defun PUSHA32 ()
  (let ((sp ESP))
    (push-n 32 EAX)
    (push-n 32 ECX)
    (push-n 32 EDX)
    (push-n 32 EBX)
    (push-n 32 sp)
    (push-n 32 EBP)
    (push-n 32 ESI)
    (push-n 32 EDI)))

(defun LEAVE64 ()
  (declare (context (bits 64)))
  (set RSP RBP)
  (set RBP (pop-n 64)))

(defun LEAVE ()
  (declare (context (bits 32)))
  (set ESP EBP)
  (set EBP (pop-n 32)))

;; ENTER with the nesting level 0
(defun ENTER (size _)
  (declare (context (bits 64)))
  (push-n 64 RBP)
  (set RBP RSP)
  (set RSP (- RSP (cast-unsigned 64 (cast-low 16 size)))))

(defun ENTER (size _)
  (declare (context (bits 32)))
  (push-n 32 EBP)
  (set EBP ESP)
  (set ESP (- ESP (cast-unsigned 32 (cast-low 16 size)))))

