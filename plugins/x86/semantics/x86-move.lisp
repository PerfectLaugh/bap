(defun MOVZX64rr8 (rd x) (set-gpr rd (cast-unsigned 64 (cast-low 8 x))))
(defun MOVZX64rm8 (rd base scale index off seg) (set-gpr rd (cast-unsigned 64 (load-n 8 (ea base scale index off seg)))))
