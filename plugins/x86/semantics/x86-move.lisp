(declare (context (target x86)))
(require x86-common)

(in-package x86-common)

;;; MOVES, EXCHANGES AND THE STACK
;;
;; The accumulators of each size are written by functions of their own,
;; e.g., set-al, the writes of EAX clear the upper half of RAX in the
;; 64-bit mode, and the 64-bit registers exist in the 64-bit mode only.
;; The operands are read when they are used, so the values that are
;; written back are bound first.

(defun set-al (x) (set AL x))
(defun set-ax (x) (set AX x))
(defun set-rax (x) (declare (context (bits 64))) (set RAX x))

(defun mov-r (rd x) (set-gpr rd x))

(defun MOV8rr (rd x) (set-gpr rd x))
(defun MOV8rr_REV (rd x) (set-gpr rd x))
(defun MOV8rm (rd base scale index off seg) (set-gpr rd (load-n 8 (ea base scale index off seg))))
(defun MOV8mr (base scale index off seg x) (store-n 8 (ea base scale index off seg) x))
(defun MOV8ri (rd imm) (set-gpr rd (cast-low 8 imm)))
(defun MOV8ri_alt (rd imm) (set-gpr rd (cast-low 8 imm)))
(defun MOV8mi (base scale index off seg imm) (store-n 8 (ea base scale index off seg) imm))
(defun MOV16rr (rd x) (set-gpr rd x))
(defun MOV16rr_REV (rd x) (set-gpr rd x))
(defun MOV16rm (rd base scale index off seg) (set-gpr rd (load-n 16 (ea base scale index off seg))))
(defun MOV16mr (base scale index off seg x) (store-n 16 (ea base scale index off seg) x))
(defun MOV16ri (rd imm) (set-gpr rd (cast-low 16 imm)))
(defun MOV16mi (base scale index off seg imm) (store-n 16 (ea base scale index off seg) imm))
(defun MOV32rr (rd x) (set-gpr rd x))
(defun MOV32rr_REV (rd x) (set-gpr rd x))
(defun MOV32rm (rd base scale index off seg) (set-gpr rd (load-n 32 (ea base scale index off seg))))
(defun MOV32mr (base scale index off seg x) (store-n 32 (ea base scale index off seg) x))
(defun MOV32ri (rd imm) (set-gpr rd (cast-low 32 imm)))
(defun MOV32ri_alt (rd imm) (set-gpr rd (cast-low 32 imm)))
(defun MOV32mi (base scale index off seg imm) (store-n 32 (ea base scale index off seg) imm))
(defun MOV64rr (rd x) (set-gpr rd x))
(defun MOV64rr_REV (rd x) (set-gpr rd x))
(defun MOV64rm (rd base scale index off seg) (set-gpr rd (load-n 64 (ea base scale index off seg))))
(defun MOV64mr (base scale index off seg x) (store-n 64 (ea base scale index off seg) x))
(defun MOV64ri (rd imm) (set-gpr rd (cast-low 64 imm)))
(defun MOV64ri32 (rd imm) (set-gpr rd (cast-low 64 imm)))
(defun MOV64mi32 (base scale index off seg imm) (store-n 64 (ea base scale index off seg) imm))

;; the moves between the accumulator and the absolute offsets, the
;; suffix is the size of the address

(defun MOV8ao16 (imm seg) (set-al (load-n 8 (+ (segment-base seg) imm))))
(defun MOV8o16a (imm seg) (store-n 8 (+ (segment-base seg) imm) AL))
(defun MOV8ao32 (imm seg) (set-al (load-n 8 (+ (segment-base seg) imm))))
(defun MOV8o32a (imm seg) (store-n 8 (+ (segment-base seg) imm) AL))
(defun MOV8ao64 (imm seg) (set-al (load-n 8 (+ (segment-base seg) imm))))
(defun MOV8o64a (imm seg) (store-n 8 (+ (segment-base seg) imm) AL))
(defun MOV16ao16 (imm seg) (set-ax (load-n 16 (+ (segment-base seg) imm))))
(defun MOV16o16a (imm seg) (store-n 16 (+ (segment-base seg) imm) AX))
(defun MOV16ao32 (imm seg) (set-ax (load-n 16 (+ (segment-base seg) imm))))
(defun MOV16o32a (imm seg) (store-n 16 (+ (segment-base seg) imm) AX))
(defun MOV16ao64 (imm seg) (set-ax (load-n 16 (+ (segment-base seg) imm))))
(defun MOV16o64a (imm seg) (store-n 16 (+ (segment-base seg) imm) AX))
(defun MOV32ao16 (imm seg) (set-eax (load-n 32 (+ (segment-base seg) imm))))
(defun MOV32o16a (imm seg) (store-n 32 (+ (segment-base seg) imm) EAX))
(defun MOV32ao32 (imm seg) (set-eax (load-n 32 (+ (segment-base seg) imm))))
(defun MOV32o32a (imm seg) (store-n 32 (+ (segment-base seg) imm) EAX))
(defun MOV32ao64 (imm seg) (set-eax (load-n 32 (+ (segment-base seg) imm))))
(defun MOV32o64a (imm seg) (store-n 32 (+ (segment-base seg) imm) EAX))
(defun MOV64ao32 (imm seg) (declare (context (bits 64))) (set-rax (load-n 64 (+ (segment-base seg) imm))))
(defun MOV64o32a (imm seg) (declare (context (bits 64))) (store-n 64 (+ (segment-base seg) imm) RAX))
(defun MOV64ao64 (imm seg) (declare (context (bits 64))) (set-rax (load-n 64 (+ (segment-base seg) imm))))
(defun MOV64o64a (imm seg) (declare (context (bits 64))) (store-n 64 (+ (segment-base seg) imm) RAX))

