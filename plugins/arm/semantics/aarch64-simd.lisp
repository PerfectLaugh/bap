(declare (context (target arm-family)
                  (bits 64)))

(in-package aarch64)

;;; ADVANCED SIMD (NEON) INSTRUCTIONS
;;
;; The moves of the immediates are here, the other instructions are
;; below, after the helpers of the lanes.

;; Scalar pairwise add: Dd = Qn.d[0] + Qn.d[1].
(defun ADDPv2i64p (dd qn)
  (setd dd (+ (cast-low 64 qn) (cast-high 64 qn))))

;; MOVI Vd.16B, #imm8 : broadcast the 8-bit immediate into all 16 bytes.
(defun MOVIv16b_ns (qd imm)
  (set$ qd (replicate (cast-low 8 imm) 16)))

;; MOVI and MVNI, the immediate is replicated into the lanes, the
;; 64-bit forms clear the upper half of the register

(defun movi-byte-mask (imm)
  "(movi-byte-mask IMM) is the 64-bit word with the byte i set to ones
   if the bit i of IMM is set"
  (concat (replicate-to-fill (select 7 imm) 8)
          (replicate-to-fill (select 6 imm) 8)
          (replicate-to-fill (select 5 imm) 8)
          (replicate-to-fill (select 4 imm) 8)
          (replicate-to-fill (select 3 imm) 8)
          (replicate-to-fill (select 2 imm) 8)
          (replicate-to-fill (select 1 imm) 8)
          (replicate-to-fill (select 0 imm) 8)))

(defun movi-lane (size imm sh)
  "(movi-lane SIZE IMM SH) is the 8-bit IMM shifted left by SH in a
   lane of SIZE bits"
  (lshift (cast-unsigned size (cast-low 8 imm)) sh))

(defun movi-lane-msl (size imm sh)
  "(movi-lane-msl SIZE IMM SH) is the 8-bit IMM shifted left by the
   amount in the low byte of SH, shifting ones in"
  (let ((amt (logand sh 0xff)))
    (logor (movi-lane size imm amt)
           (lnot (lshift (lnot (cast-unsigned size 0)) amt)))))

(defun movi-q (lane n) (replicate lane n))
(defun movi-d (lane n) (cast-unsigned 128 (replicate lane n)))

(defun MOVIv2d_ns (qd imm) (set$ qd (movi-q (movi-byte-mask imm) 2)))
(defun MOVIv8b_ns (qd imm) (set$ qd (movi-d (cast-low 8 imm) 8)))
(defun MOVIv4i32 (qd imm sh) (set$ qd (movi-q (movi-lane 32 imm sh) 4)))
(defun MOVIv2i32 (qd imm sh) (set$ qd (movi-d (movi-lane 32 imm sh) 2)))
(defun MOVIv8i16 (qd imm sh) (set$ qd (movi-q (movi-lane 16 imm sh) 8)))
(defun MOVIv4i16 (qd imm sh) (set$ qd (movi-d (movi-lane 16 imm sh) 4)))
(defun MOVIv4s_msl (qd imm sh) (set$ qd (movi-q (movi-lane-msl 32 imm sh) 4)))
(defun MOVIv2s_msl (qd imm sh) (set$ qd (movi-d (movi-lane-msl 32 imm sh) 2)))
(defun MVNIv4i32 (qd imm sh) (set$ qd (movi-q (lnot (movi-lane 32 imm sh)) 4)))
(defun MVNIv2i32 (qd imm sh) (set$ qd (movi-d (lnot (movi-lane 32 imm sh)) 2)))
(defun MVNIv8i16 (qd imm sh) (set$ qd (movi-q (lnot (movi-lane 16 imm sh)) 8)))
(defun MVNIv4i16 (qd imm sh) (set$ qd (movi-d (lnot (movi-lane 16 imm sh)) 4)))
(defun MVNIv4s_msl (qd imm sh) (set$ qd (movi-q (lnot (movi-lane-msl 32 imm sh)) 4)))
(defun MVNIv2s_msl (qd imm sh) (set$ qd (movi-d (lnot (movi-lane-msl 32 imm sh)) 2)))

;;; ADVANCED SIMD INTEGER INSTRUCTIONS
;;
;; A vector is a bitvector of its lanes, the lane 0 is the lowest one,
;; (a64-lane X ES I) is the lane I of ES bits of X. The operations of
;; the lanes are named by symbols, which a64-op1, a64-op2 and a64-op3
;; apply to one, two and three arguments, and the a64-map functions
;; apply an operation to the N lanes of their arguments, e.g.,
;; (a64-map2 'add 32 4 x y) is the vector of the sums of the 4 lanes of
;; 32 bits of x and y. The sizes, the numbers of the lanes and the
;; operations are static, so the recursion and the choice of the
;; operation unfold when the instruction is lifted. The functions of
;; the lanes choose with fp-select instead of if, see arm-float.lisp.
;; The results of the 64-bit forms are written with setd, which clears
;; the upper half of the register.

(defmacro a64-lane (x es i) (extract (+ (* es i) es -1) (* es i) x))

(defun a64-mask (c es)
  "(a64-mask C ES) is ES ones if C and ES zeros otherwise"
  (neg (cast-unsigned es c)))

(defun a64-sel (c x y) (fp-select c x y))

(defmacro a64-setd (rd x)
  "(a64-setd RD X) sets the D register RD to the lower 64 bits of X and
   clears the upper half of its vector register"
  (setd rd (cast-low 64 x)))

(defun a64-dup (x n)
  "(a64-dup X N) is X repeated N times"
  (if (= n 1) x (concat x (a64-dup x (- n 1)))))

(defun a64-zero (x) (cast-unsigned (word-width x) 0))
(defun a64-ones (x) (lnot (a64-zero x)))

(defun a64-insert (x es i v)
  "(a64-insert X ES I V) is X with its lane I of ES bits replaced by V"
  (let ((sh (* es i)))
    (logor (logand x (lnot (lshift (cast-unsigned (word-width x)
                                                  (lnot (cast-unsigned es 0)))
                                   sh)))
           (lshift (cast-unsigned (word-width x) v) sh))))

;; the maps, the lanes are concatenated from the highest one

(defun a64-map1 (op es n x)
  (if (= n 1) (a64-op1 op (a64-lane x es 0))
    (concat (a64-op1 op (a64-lane x es (- n 1)))
            (a64-map1 op es (- n 1) x))))

(defun a64-map2 (op es n x y)
  (if (= n 1) (a64-op2 op (a64-lane x es 0) (a64-lane y es 0))
    (concat (a64-op2 op (a64-lane x es (- n 1)) (a64-lane y es (- n 1)))
            (a64-map2 op es (- n 1) x y))))

(defun a64-map3 (op es n x y z)
  (if (= n 1) (a64-op3 op (a64-lane x es 0) (a64-lane y es 0) (a64-lane z es 0))
    (concat (a64-op3 op (a64-lane x es (- n 1)) (a64-lane y es (- n 1))
                     (a64-lane z es (- n 1)))
            (a64-map3 op es (- n 1) x y z))))

(defun a64-mapk (op es n x k)
  "applies OP to the lanes of X and to K"
  (if (= n 1) (a64-op2 op (a64-lane x es 0) k)
    (concat (a64-op2 op (a64-lane x es (- n 1)) k)
            (a64-mapk op es (- n 1) x k))))

(defun a64-mapk2 (op es n x y k)
  "applies OP to the lanes of X and Y and to K"
  (if (= n 1) (a64-op3 op (a64-lane x es 0) (a64-lane y es 0) k)
    (concat (a64-op3 op (a64-lane x es (- n 1)) (a64-lane y es (- n 1)) k)
            (a64-mapk2 op es (- n 1) x y k))))

(defun a64-mapw2 (op es n w x)
  "the lanes of W are twice as wide as the lanes of X"
  (if (= n 1) (a64-op2 op (a64-lane w (* 2 es) 0) (a64-lane x es 0))
    (concat (a64-op2 op (a64-lane w (* 2 es) (- n 1)) (a64-lane x es (- n 1)))
            (a64-mapw2 op es (- n 1) w x))))

(defun a64-mapw3 (op es n w x y)
  "the lanes of W are twice as wide as the lanes of X and Y"
  (if (= n 1) (a64-op3 op (a64-lane w (* 2 es) 0) (a64-lane x es 0) (a64-lane y es 0))
    (concat (a64-op3 op (a64-lane w (* 2 es) (- n 1)) (a64-lane x es (- n 1))
                     (a64-lane y es (- n 1)))
            (a64-mapw3 op es (- n 1) w x y))))

(defun a64-pair (op es n x)
  "applies OP to the adjacent pairs of the 2N lanes of X"
  (if (= n 1) (a64-op2 op (a64-lane x es 0) (a64-lane x es 1))
    (concat (a64-op2 op (a64-lane x es (- (* 2 n) 2)) (a64-lane x es (- (* 2 n) 1)))
            (a64-pair op es (- n 1) x))))

(defun a64-reduce (op es n i x)
  "reduces the N lanes of X from the lane I, as Reduce of the Arm ARM"
  (if (= n 1) (a64-lane x es i)
    (a64-op2 op (a64-reduce op es (/ n 2) i x)
             (a64-reduce op es (/ n 2) (+ i (/ n 2)) x))))

(defun a64-permute (op es n i x)
  "the lanes from I down to 0 of the permutation OP of the lanes of X,
   which is the concatenation of the second and the first operands, of
   N lanes each, or, if OP is a number, of the reversal of the lanes in
   the containers of OP + 1 lanes"
  (let ((odd (mod i 2))
        (j (case op
             'uzp1 (* 2 i)
             'uzp2 (+ (* 2 i) 1)
             'zip1 (+ (* odd n) (/ i 2))
             'zip2 (+ (* odd n) (/ n 2) (/ i 2))
             'trn1 (+ (* odd n) (- i odd))
             'trn2 (+ (* odd n) (- i odd) 1)
             (logxor i op))))
    (if (= i 0) (a64-lane x es j)
      (concat (a64-lane x es j) (a64-permute op es n (- i 1) x)))))

;; the operations of the lanes

(defun a64-smin (a b) (a64-sel (s< a b) a b))
(defun a64-smax (a b) (a64-sel (s< a b) b a))
(defun a64-umin (a b) (a64-sel (< a b) a b))
(defun a64-umax (a b) (a64-sel (< a b) b a))
(defun a64-sabd (a b) (a64-sel (s< a b) (- b a) (- a b)))
(defun a64-uabd (a b) (a64-sel (< a b) (- b a) (- a b)))
(defun a64-abs (a) (a64-sel (msb a) (neg a) a))

(defun a64-sx1 (a) (cast-signed (+ (word-width a) 1) a))
(defun a64-ux1 (a) (cast-unsigned (+ (word-width a) 1) a))
(defun a64-sx2 (a) (cast-signed (* 2 (word-width a)) a))
(defun a64-ux2 (a) (cast-unsigned (* 2 (word-width a)) a))
(defun a64-one (x) (cast-unsigned (word-width x) 1))
(defun a64-half (a) (/ (word-width a) 2))

(defun a64-halving (x) (extract (- (word-width x) 1) 1 x))

(defun a64-sat-s (x n)
  "saturates the wider X to the signed N bits"
  (let ((w (word-width x))
        (hi (cast-signed w (lnot (lshift (lnot (cast-unsigned n 0)) (- n 1)))))
        (lo (cast-signed w (lshift (lnot (cast-unsigned n 0)) (- n 1)))))
    (cast-low n (a64-sel (s< hi x) hi (a64-sel (s< x lo) lo x)))))

(defun a64-sat-u (x n)
  "saturates the wider signed X to the unsigned N bits"
  (let ((w (word-width x))
        (hi (cast-unsigned w (lnot (cast-unsigned n 0)))))
    (cast-low n (a64-sel (s< hi x) hi (a64-sel (msb x) (a64-zero x) x)))))

(defun a64-ux2-1 (a) (a64-ux1 (a64-ux1 a)))

(defun a64-cls (a)
  (cast-low (word-width a)
            (- (clz (logxor (rshift a 1)
                            (cast-unsigned (word-width a)
                                           (cast-low (- (word-width a) 1) a))))
               1)))

;; the shifts by a register, the amount is the signed lowest byte of
;; the lane of the second operand, a negative one shifts to the right
(defun a64-sshl (a b)
  (let ((s (cast-low 8 b))
        (r (cast-unsigned (word-width a) (neg s)))
        (w (cast-unsigned (word-width a) (- (word-width a) 1))))
    (a64-sel (msb s)
             (arshift a (a64-sel (< w r) w r))
             (lshift a (cast-unsigned (word-width a) s)))))

(defun a64-ushl (a b)
  (let ((s (cast-low 8 b)))
    (a64-sel (msb s)
             (rshift a (cast-unsigned (word-width a) (neg s)))
             (lshift a (cast-unsigned (word-width a) s)))))

;; the shifts by an immediate, which is static
(defun a64-sshr (a k)
  (if (= k (word-width a)) (arshift a (- k 1)) (arshift a k)))
(defun a64-ushr (a k)
  (if (= k (word-width a)) (a64-zero a) (rshift a k)))
(defun a64-round-bit (x k)
  "1 << (k - 1) in the size of x"
  (if (= k 0) (a64-zero x) (lshift (a64-one x) (- k 1))))
(defun a64-srshr (a k)
  (let ((x (a64-sx1 a)))
    (cast-low (word-width a) (arshift (+ x (a64-round-bit x k)) k))))
(defun a64-urshr (a k)
  (let ((x (a64-ux1 a)))
    (cast-low (word-width a) (rshift (+ x (a64-round-bit x k)) k))))
(defun a64-sli (d a k)
  (let ((m (lshift (a64-ones a) k)))
    (logor (logand d (lnot m)) (lshift a k))))
(defun a64-sri (d a k)
  (let ((m (a64-ushr (a64-ones a) k)))
    (logor (logand d (lnot m)) (a64-ushr a k))))

(defun a64-tbl-byte (i d table)
  "the byte I of TABLE, or D if I is out of its range"
  (let ((n (/ (word-width table) 8)))
    (a64-sel (< (cast-unsigned 16 i) (cast-unsigned 16 n))
             (cast-low 8 (rshift table (* (cast-unsigned (word-width table) i) 8)))
             d)))

(defun a64-op1 (op a)
  (case op
    'neg (neg a)
    'abs (a64-abs a)
    'sqabs (a64-sat-s (a64-abs (a64-sx1 a)) (word-width a))
    'sqneg (a64-sat-s (neg (a64-sx1 a)) (word-width a))
    'cnt (cast-low (word-width a) (popcount a))
    'clz (cast-low (word-width a) (clz a))
    'cls (a64-cls a)
    'rbit (reverse-bits a)
    'cmeqz (a64-mask (is-zero a) (word-width a))
    'cmgtz (a64-mask (s> a (a64-zero a)) (word-width a))
    'cmgez (a64-mask (not (msb a)) (word-width a))
    'cmlez (a64-mask (s<= a (a64-zero a)) (word-width a))
    'cmltz (a64-mask (msb a) (word-width a))
    'sx2 (a64-sx2 a)
    'ux2 (a64-ux2 a)
    'xtn (cast-low (a64-half a) a)
    'sqxtn (a64-sat-s a (a64-half a))
    'uqxtn (a64-sat-u (a64-ux1 a) (a64-half a))
    'sqxtun (a64-sat-u a (a64-half a))
    (a64-fop1 op a)))

(defun a64-op2 (op a b)
  (case op
    'add (+ a b)
    'sub (- a b)
    'mul (* a b)
    'smin (a64-smin a b)
    'smax (a64-smax a b)
    'umin (a64-umin a b)
    'umax (a64-umax a b)
    'sabd (a64-sabd a b)
    'uabd (a64-uabd a b)
    'shadd (a64-halving (+ (a64-sx1 a) (a64-sx1 b)))
    'uhadd (a64-halving (+ (a64-ux1 a) (a64-ux1 b)))
    'srhadd (a64-halving (+ (a64-sx1 a) (a64-sx1 b) (a64-one (a64-sx1 a))))
    'urhadd (a64-halving (+ (a64-ux1 a) (a64-ux1 b) (a64-one (a64-ux1 a))))
    'shsub (a64-halving (- (a64-sx1 a) (a64-sx1 b)))
    'uhsub (a64-halving (- (a64-ux1 a) (a64-ux1 b)))
    'sqadd (a64-sat-s (+ (a64-sx1 a) (a64-sx1 b)) (word-width a))
    'uqadd (a64-sat-u (+ (a64-ux2-1 a) (a64-ux2-1 b)) (word-width a))
    'sqsub (a64-sat-s (- (a64-sx1 a) (a64-sx1 b)) (word-width a))
    'uqsub (a64-sat-u (- (a64-ux2-1 a) (a64-ux2-1 b)) (word-width a))
    'cmeq (a64-mask (= a b) (word-width a))
    'cmgt (a64-mask (s> a b) (word-width a))
    'cmge (a64-mask (s>= a b) (word-width a))
    'cmhi (a64-mask (> a b) (word-width a))
    'cmhs (a64-mask (>= a b) (word-width a))
    'cmtst (a64-mask (not (is-zero (logand a b))) (word-width a))
    'sshl (a64-sshl a b)
    'ushl (a64-ushl a b)
    'sshr (a64-sshr a b)
    'ushr (a64-ushr a b)
    'shl (lshift a b)
    'srshr (a64-srshr a b)
    'urshr (a64-urshr a b)
    'sshll (lshift (a64-sx2 a) b)
    'ushll (lshift (a64-ux2 a) b)
    'shrn (cast-low (a64-half a) (rshift a b))
    'rshrn (cast-low (a64-half a) (a64-urshr a b))
    'smull (* (a64-sx2 a) (a64-sx2 b))
    'umull (* (a64-ux2 a) (a64-ux2 b))
    'saddl (+ (a64-sx2 a) (a64-sx2 b))
    'uaddl (+ (a64-ux2 a) (a64-ux2 b))
    'ssubl (- (a64-sx2 a) (a64-sx2 b))
    'usubl (- (a64-ux2 a) (a64-ux2 b))
    'sabdl (a64-ux2 (a64-sabd a b))
    'uabdl (a64-ux2 (a64-uabd a b))
    'saddw (+ a (a64-sx2 b))
    'uaddw (+ a (a64-ux2 b))
    'ssubw (- a (a64-sx2 b))
    'usubw (- a (a64-ux2 b))
    'addhn (cast-high (a64-half a) (+ a b))
    'subhn (cast-high (a64-half a) (- a b))
    'raddhn (cast-high (a64-half a) (+ a b (lshift (a64-one a) (- (a64-half a) 1))))
    'rsubhn (cast-high (a64-half a) (+ (- a b) (lshift (a64-one a) (- (a64-half a) 1))))
    (a64-fop2 op a b)))

(defun a64-op3 (op d a b)
  (case op
    'mla (+ d (* a b))
    'mls (- d (* a b))
    'saba (+ d (a64-sabd a b))
    'uaba (+ d (a64-uabd a b))
    'smlal (+ d (a64-op2 'smull a b))
    'umlal (+ d (a64-op2 'umull a b))
    'smlsl (- d (a64-op2 'smull a b))
    'umlsl (- d (a64-op2 'umull a b))
    'sabal (+ d (a64-op2 'sabdl a b))
    'uabal (+ d (a64-op2 'uabdl a b))
    'ssra (+ d (a64-sshr a b))
    'usra (+ d (a64-ushr a b))
    'srsra (+ d (a64-srshr a b))
    'ursra (+ d (a64-urshr a b))
    'sli (a64-sli d a b)
    'sri (a64-sri d a b)
    'tbl (a64-tbl-byte d a b)
    (a64-fop3 op d a b)))

;; the three registers of the same arrangement
(defun ADDv8i8 (rd rn rm) (a64-setd rd (a64-map2 'add 8 8 rn rm)))
(defun ADDv16i8 (rd rn rm) (set$ rd (a64-map2 'add 8 16 rn rm)))
(defun ADDv4i16 (rd rn rm) (a64-setd rd (a64-map2 'add 16 4 rn rm)))
(defun ADDv8i16 (rd rn rm) (set$ rd (a64-map2 'add 16 8 rn rm)))
(defun ADDv2i32 (rd rn rm) (a64-setd rd (a64-map2 'add 32 2 rn rm)))
(defun ADDv4i32 (rd rn rm) (set$ rd (a64-map2 'add 32 4 rn rm)))
(defun ADDv1i64 (rd rn rm) (a64-setd rd (a64-map2 'add 64 1 rn rm)))
(defun ADDv2i64 (rd rn rm) (set$ rd (a64-map2 'add 64 2 rn rm)))
(defun SUBv8i8 (rd rn rm) (a64-setd rd (a64-map2 'sub 8 8 rn rm)))
(defun SUBv16i8 (rd rn rm) (set$ rd (a64-map2 'sub 8 16 rn rm)))
(defun SUBv4i16 (rd rn rm) (a64-setd rd (a64-map2 'sub 16 4 rn rm)))
(defun SUBv8i16 (rd rn rm) (set$ rd (a64-map2 'sub 16 8 rn rm)))
(defun SUBv2i32 (rd rn rm) (a64-setd rd (a64-map2 'sub 32 2 rn rm)))
(defun SUBv4i32 (rd rn rm) (set$ rd (a64-map2 'sub 32 4 rn rm)))
(defun SUBv1i64 (rd rn rm) (a64-setd rd (a64-map2 'sub 64 1 rn rm)))
(defun SUBv2i64 (rd rn rm) (set$ rd (a64-map2 'sub 64 2 rn rm)))
(defun MULv8i8 (rd rn rm) (a64-setd rd (a64-map2 'mul 8 8 rn rm)))
(defun MULv16i8 (rd rn rm) (set$ rd (a64-map2 'mul 8 16 rn rm)))
(defun MULv4i16 (rd rn rm) (a64-setd rd (a64-map2 'mul 16 4 rn rm)))
(defun MULv8i16 (rd rn rm) (set$ rd (a64-map2 'mul 16 8 rn rm)))
(defun MULv2i32 (rd rn rm) (a64-setd rd (a64-map2 'mul 32 2 rn rm)))
(defun MULv4i32 (rd rn rm) (set$ rd (a64-map2 'mul 32 4 rn rm)))
(defun SMINv8i8 (rd rn rm) (a64-setd rd (a64-map2 'smin 8 8 rn rm)))
(defun SMINv16i8 (rd rn rm) (set$ rd (a64-map2 'smin 8 16 rn rm)))
(defun SMINv4i16 (rd rn rm) (a64-setd rd (a64-map2 'smin 16 4 rn rm)))
(defun SMINv8i16 (rd rn rm) (set$ rd (a64-map2 'smin 16 8 rn rm)))
(defun SMINv2i32 (rd rn rm) (a64-setd rd (a64-map2 'smin 32 2 rn rm)))
(defun SMINv4i32 (rd rn rm) (set$ rd (a64-map2 'smin 32 4 rn rm)))
(defun SMAXv8i8 (rd rn rm) (a64-setd rd (a64-map2 'smax 8 8 rn rm)))
(defun SMAXv16i8 (rd rn rm) (set$ rd (a64-map2 'smax 8 16 rn rm)))
(defun SMAXv4i16 (rd rn rm) (a64-setd rd (a64-map2 'smax 16 4 rn rm)))
(defun SMAXv8i16 (rd rn rm) (set$ rd (a64-map2 'smax 16 8 rn rm)))
(defun SMAXv2i32 (rd rn rm) (a64-setd rd (a64-map2 'smax 32 2 rn rm)))
(defun SMAXv4i32 (rd rn rm) (set$ rd (a64-map2 'smax 32 4 rn rm)))
(defun UMINv8i8 (rd rn rm) (a64-setd rd (a64-map2 'umin 8 8 rn rm)))
(defun UMINv16i8 (rd rn rm) (set$ rd (a64-map2 'umin 8 16 rn rm)))
(defun UMINv4i16 (rd rn rm) (a64-setd rd (a64-map2 'umin 16 4 rn rm)))
(defun UMINv8i16 (rd rn rm) (set$ rd (a64-map2 'umin 16 8 rn rm)))
(defun UMINv2i32 (rd rn rm) (a64-setd rd (a64-map2 'umin 32 2 rn rm)))
