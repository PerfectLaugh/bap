(defun a64-vt-reg (l k)
  "(a64-vt-reg L K) is the symbol of the Q register of the K-th register of L"
  (if (= k 0) (a64-vt-first l) (a64-vt-next (a64-vt-reg l (- k 1)))))

(defun a64-vt-get (l k) (unquote (a64-vt-reg l k)))
(defun a64-vt-set (l k x) (set-symbol-value (a64-vt-reg l k) (cast-unsigned 128 x)))

(defun a64-vt-table (l n)
  "(a64-vt-table L N) is the concatenation of the N registers of L, the
   first one is the lowest"
  (if (= n 1) (a64-vt-get l 0)
    (concat (a64-vt-get l (- n 1)) (a64-vt-table l (- n 1)))))

(defun a64-post (rm size)
  "the post-index offset: SIZE if RM is XZR, and RM otherwise"
  (if (= (symbol rm) 'XZR) size rm))

;;; LOADS AND STORES OF THE STRUCTURES
;;
;; LDn and STn of N registers of L lanes access N * L elements, the
;; element E of the register R is at the index E * N + R in the memory,
;; and LD1 and ST1 of several registers access the registers one after
;; another. The access is a load or a store of the whole block of the
;; elements, which are gathered from the block and scattered to it, the
;; registers of the lists are numbered from 0 here.

(defun a64-gather (b es n step i)
  "the N lanes of B, from the lane I, every STEP lanes"
  (if (= n 1) (a64-lane b es i)
    (concat (a64-gather b es (- n 1) step (+ i step)) (a64-lane b es i))))

(defun a64-element (l es n regs interleaved j)
  "the element J of the block of the REGS registers of the list L"
  (if interleaved
      (a64-lane (a64-vt-get l (mod j regs)) es (/ j regs))
    (a64-lane (a64-vt-get l (/ j n)) es (mod j n))))

(defun a64-scatter (l es n regs interleaved j)
  "the elements from J down to 0 of the block"
  (if (= j 0) (a64-element l es n regs interleaved 0)
    (concat (a64-element l es n regs interleaved j)
            (a64-scatter l es n regs interleaved (- j 1)))))

(defun a64-load-regs (l b es n regs interleaved r)
  (when (< r regs)
    (a64-vt-set l r (if interleaved
                         (a64-gather b es n regs r)
                       (a64-gather b es n 1 (* r n))))
    (a64-load-regs l b es n regs interleaved (+ r 1))))

(defun a64-ld (l a es n regs interleaved)
  (a64-load-regs l (load-bits (* es n regs) a) es n regs interleaved 0))

(defun a64-store-pieces (a b i n)
  "stores the 64-bit pieces from I to N - 1 of B, the stores wider than
   256 bits, or of a size that is not a power of 2, are not stored right"
  (when (< i n)
    (store-word (+ a (* 8 i)) (extract (+ (* 64 i) 63) (* 64 i) b))
    (a64-store-pieces a b (+ i 1) n)))

(defun a64-st (l a es n regs interleaved)
  (let ((b (a64-scatter l es n regs interleaved (- (* n regs) 1))))
    (a64-store-pieces a b 0 (/ (* es n regs) 64))))

