;;; ADVANCED SIMD FLOATING-POINT INSTRUCTIONS
;;
;; The operations of the lanes, which a64-fop1, a64-fop2 and a64-fop3
;; apply, see aarch64-simd.lisp for the maps.

(defun a64-fexp-bits (x) (case (word-width x) 16 5 32 8 11))

(defun a64-fconst (x h s d)
  "(a64-fconst X H S D) is the constant H, S or D of the format of X"
  (case (word-width x)
    16 (cast-low 16 h)
    32 (cast-low 32 s)
    (cast-low 64 d)))

(defun a64-fone (x) (a64-fconst x 0x3c00 0x3f800000 0x3ff0000000000000))
(defun a64-fhalf (x) (a64-fconst x 0x3800 0x3f000000 0x3fe0000000000000))
(defun a64-ftwo (x) (a64-fconst x 0x4000 0x40000000 0x4000000000000000))
(defun a64-fthree (x) (a64-fconst x 0x4200 0x40400000 0x4008000000000000))
(defun a64-fthree-halves (x) (a64-fconst x 0x3e00 0x3fc00000 0x3ff8000000000000))

(defun a64-fspecial (a b)
  "true if A and B are an infinity and a zero, which are not NaNs"
  (a64-inf-times-zero a b))

;; the square root of a negative number is the default NaN
(defun a64-fsqrt (a)
  (fp-select (logand (msb a) (not (is-fzero a)) (not (is-nan a)))
             (a64-default-nan a)
             (fsqrt :rne a)))

;; FMULX is FMUL, except that the product of an infinity and a zero is
;; 2.0, negative if one of them is, FRECPS is 2.0 - a * b and FRSQRTS
;; is (3.0 - a * b) / 2, fused, of an infinity and a zero they are 2.0
;; and 1.5
(defun a64-fmulx (a b)
  (fp-select (a64-fspecial a b)
             (fp-select (logxor (msb a) (msb b)) (fp-neg (a64-ftwo a)) (a64-ftwo a))
             (*. :rne a b)))

(defun a64-frecps (a b)
  (fp-select (a64-fspecial a b) (a64-ftwo a)
             (a64-muladd (a64-ftwo a) (fp-neg a) b)))

(defun a64-frsqrts (a b)
  (fp-select (a64-fspecial a b) (a64-fthree-halves a)
             (*. :rne (a64-fhalf a) (a64-muladd (a64-fthree a) (fp-neg a) b))))

(defun a64-frint (mode a)
  "rounds to an integral value, FRINTX and FRINTI use the rounding
   mode of FPCR, which is assumed to be to nearest"
  (fp-round-integral mode a (a64-fone a) (a64-fhalf a)
                     (a64-fexp-bits a) (a64-frac-bits a)))

(defun a64-fcvt-int (signed mode a)
  "converts A to the integer of its size, rounded by MODE"
  (fp-to-int signed (word-width a) (if (= mode 'z) a (a64-frint mode a))
             (a64-fexp-bits a) (a64-frac-bits a)))

(defun a64-fpow2 (a n)
  "2^N in the format of A"
  (cast-float :rne (word-width a) (lshift (cast-unsigned 128 1) n)))

(defun a64-fcmp (c a) (a64-mask c (word-width a)))

(defun a64-ordered (a b) (not (logor (is-nan a) (is-nan b))))

(defun a64-dnan (r a b)
  "R, or the default NaN, if R is a NaN and A and B are not"
  (fp-select (logand (is-nan r) (a64-ordered a b)) (a64-default-nan r) r))

(defun a64-fixed-to-fp (signed a n)
  "the fixed-point A of N fraction bits, rounded once, the lanes narrower
   than 64 bits are converted exactly to double precision first"
  (if (= (word-width a) 64)
      (/. :rne (if signed (cast-sfloat :rne 64 a) (cast-float :rne 64 a))
          (a64-fpow2 a n))
    (let ((x (if signed (cast-sfloat :rne 64 a) (cast-float :rne 64 a))))
      (fconvert :rne (word-width a)
                (/. :rne x (cast-float :rne 64 (lshift (cast-unsigned 128 1) n)))))))

(defun a64-fop1 (op a)
  (case op
    'fneg (fp-neg a)
    'fabs (fp-abs a)
    'fsqrt (a64-fsqrt a)
    'frintn (a64-frint 'n a)
    'frinta (a64-frint 'a a)
    'frintp (a64-frint 'p a)
    'frintm (a64-frint 'm a)
    'frintz (a64-frint 'z a)
    'scvtf (cast-sfloat :rne (word-width a) a)
    'ucvtf (cast-float :rne (word-width a) a)
    'fcvtzs (a64-fcvt-int true 'z a)
    'fcvtzu (a64-fcvt-int false 'z a)
    'fcvtns (a64-fcvt-int true 'n a)
    'fcvtnu (a64-fcvt-int false 'n a)
    'fcvtas (a64-fcvt-int true 'a a)
    'fcvtau (a64-fcvt-int false 'a a)
    'fcvtps (a64-fcvt-int true 'p a)
    'fcvtpu (a64-fcvt-int false 'p a)
    'fcvtms (a64-fcvt-int true 'm a)
    'fcvtmu (a64-fcvt-int false 'm a)
    'fcvtn (fconvert :rne (/ (word-width a) 2) a)
    'fcvtl (fconvert :rne (* (word-width a) 2) a)
    'fcmeqz (a64-fop2 'fcmeq a (fp-zero a))
    'fcmgez (a64-fop2 'fcmge a (fp-zero a))
    'fcmgtz (a64-fop2 'fcmgt a (fp-zero a))
    'fcmlez (a64-fop2 'fcmge (fp-zero a) a)
    'fcmltz (a64-fop2 'fcmgt (fp-zero a) a)
    a))

(defun a64-fop2 (op a b)
  (case op
    'fadd (a64-dnan (+. :rne a b) a b)
    'fsub (a64-dnan (-. :rne a b) a b)
    'fmul (a64-dnan (*. :rne a b) a b)
    'fdiv (a64-dnan (/. :rne a b) a b)
    'fmax (fp-max a b (a64-frac-bits a))
    'fmin (fp-min a b (a64-frac-bits a))
    'fmaxnm (fp-maxnm a b (a64-frac-bits a))
    'fminnm (fp-minnm a b (a64-frac-bits a))
    'fabd (fp-abs (a64-dnan (-. :rne a b) a b))
    'fmulx (a64-fmulx a b)
    'frecps (a64-frecps a b)
    'frsqrts (a64-frsqrts a b)
    'fcmeq (a64-fcmp (logand (a64-ordered a b) (=. a b)) a)
    'fcmge (a64-fcmp (logand (a64-ordered a b) (>=. a b)) a)
    'fcmgt (a64-fcmp (logand (a64-ordered a b) (>. a b)) a)
    'facge (a64-fcmp (logand (a64-ordered a b) (>=. (fp-abs a) (fp-abs b))) a)
    'facgt (a64-fcmp (logand (a64-ordered a b) (>. (fp-abs a) (fp-abs b))) a)
    'scvtf-fixed (a64-fixed-to-fp true a b)
    'ucvtf-fixed (a64-fixed-to-fp false a b)
    'fcvtzs-fixed (a64-fcvt-int true 'z (*. :rne a (a64-fpow2 a b)))
    'fcvtzu-fixed (a64-fcvt-int false 'z (*. :rne a (a64-fpow2 a b)))
    a))

(defun a64-fop3 (op d a b)
  (case op
    'fmla (a64-muladd d a b)
    'fmls (a64-muladd d (fp-neg a) b)
    d))

