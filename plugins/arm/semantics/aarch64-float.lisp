(declare (context (target arm-family)
                  (bits 64)))

(in-package aarch64)

(require arm-float)

;;; SCALAR FLOATING-POINT INSTRUCTIONS
;;
;; The operations round to nearest with ties to even, which is the
;; rounding mode FPCR resets to; FPCR itself is not modeled, so the
;; FZ, DN and AHP controls and the exception flags are ignored. The
;; helpers are in arm-float.lisp.

(defun fp-compare (x y) (set-nzcv (fp-nzcv x y)))

;; ARITHMETIC

(defun FADDSrr (rd rn rm) (setd rd (a64-fop2 'fadd rn rm)))
(defun FADDDrr (rd rn rm) (setd rd (a64-fop2 'fadd rn rm)))
(defun FSUBSrr (rd rn rm) (setd rd (a64-fop2 'fsub rn rm)))
(defun FSUBDrr (rd rn rm) (setd rd (a64-fop2 'fsub rn rm)))
(defun FMULSrr (rd rn rm) (setd rd (a64-fop2 'fmul rn rm)))
(defun FMULDrr (rd rn rm) (setd rd (a64-fop2 'fmul rn rm)))
(defun FDIVSrr (rd rn rm) (setd rd (a64-fop2 'fdiv rn rm)))
(defun FDIVDrr (rd rn rm) (setd rd (a64-fop2 'fdiv rn rm)))
(defun FNMULSrr (rd rn rm) (setd rd (fp-neg (a64-fop2 'fmul rn rm))))
(defun FNMULDrr (rd rn rm) (setd rd (fp-neg (a64-fop2 'fmul rn rm))))

;; The multiply-add instructions are fused, i.e., they round only once,
;; the product is computed with the fmad intrinsic. The NaNs are
;; processed as by FPMulAdd: a signaling NaN of the addend, of the
;; first and of the second factor, in that order, then a quiet one,
;; and the default NaN, when the addend is a quiet NaN and the product
;; is of an infinity and a zero. The negated forms negate the operands
;; before, as the Arm ARM does, so the sign of a NaN is negated too.

(defun a64-fsize-symbol (x)
  (case (word-width x)
    16 '16
    32 '32
    64 '64
    'unknown))

(defun a64-default-nan (x)
  "(a64-default-nan X) is the default NaN in the format of X"
  (case (word-width x)
    16 (cast-low 16 0x7e00)
    32 (cast-low 32 0x7fc00000)
    0x7ff8000000000000))

(defun a64-frac-bits (x)
  (case (word-width x)
    16 10
    32 23
    52))

(defun a64-is-snan (x)
  (logand (is-nan x) (is-zero (select (- (a64-frac-bits x) 1) x))))

(defun a64-quiet-nan (x) (fp-quiet x (a64-frac-bits x)))

(defun a64-inf-times-zero (x y)
  (logor (logand (is-inf x) (is-fzero y))
         (logand (is-fzero x) (is-inf y))))

(defun a64-muladd (a x y)
  "(a64-muladd A X Y) is A + X * Y rounded once"
  (let ((r (intrinsic (symbol-concat 'fmad 'rne 'ieee754_binary
                                     (a64-fsize-symbol a) :sep '_)
                      x y a :result (word-width a))))
    (fp-select (a64-is-snan a) (a64-quiet-nan a)
      (fp-select (a64-is-snan x) (a64-quiet-nan x)
        (fp-select (a64-is-snan y) (a64-quiet-nan y)
          (fp-select (is-nan a)
                     (fp-select (a64-inf-times-zero x y) (a64-default-nan a) a)
            (fp-select (is-nan x) x
              (fp-select (is-nan y) y r))))))))

(defun FMADDSrrr (rd rn rm ra) (setd rd (a64-muladd ra rn rm)))
(defun FMADDDrrr (rd rn rm ra) (setd rd (a64-muladd ra rn rm)))
