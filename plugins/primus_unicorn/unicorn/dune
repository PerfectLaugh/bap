; The bindings to the Unicorn that libunicorn builds from its sources.

(library
 (name bap_unicorn)
 (public_name bap-primus-unicorn.unicorn)
 (foreign_stubs
  (language c)
  (names unicorn_stubs unicorn_regs)
  (extra_deps unicorn_regs.h ../libunicorn/unicorn)
  (flags :standard -I../libunicorn/unicorn/include))
 ; the archive of Unicorn, which it also installs as unicorn.o, so that it
 ; is a dependency of the links, and they are redone when it changes; it is
 ; linked from the flags too, which the linker sees before the extra objects,
 ; so that the runtime that follows it in the flags resolves its symbols
 (extra_objects ../libunicorn/unicorn/lib/unicorn)
 (c_library_flags
  plugins/primus_unicorn/libunicorn/unicorn/lib/libunicorn.a
  (:include runtime.flags)
  -lm))

; the threads and the runtime of the compiler that Unicorn uses, which on
; Windows are linked statically, as for C++, see
; lib/bap_disasm/config/cxx_runtime.ml, so that the plugin doesn't depend
; on the DLLs of the mingw-w64 toolchain, which are not in the path

(rule
 (enabled_if
  (<> %{os_type} Win32))
 (action
  (with-stdout-to
   runtime.flags
   (echo "(-lpthread)"))))

(rule
 (enabled_if
  (= %{os_type} Win32))
 (action
  (copy %{project_root}/lib/bap_disasm/cxx_runtime.flags runtime.flags)))

(rule
 (targets unicorn_regs.c)
 (deps ../libunicorn/unicorn)
 (action
  (with-stdout-to
   %{targets}
   (run
    gen/gen_regs.exe
    ../libunicorn/unicorn/include/unicorn
    x86:x86.h:UC_X86_REG_
    arm:arm.h:UC_ARM_REG_
    arm64:arm64.h:UC_ARM64_REG_
    mips:mips.h:UC_MIPS_REG_
    ppc:ppc.h:UC_PPC_REG_
    riscv:riscv.h:UC_RISCV_REG_))))
