; The library, with which the scripts run the programs in Unicorn, see
; bap_emu.mli.

(library
 (name bap_emu)
 (public_name bap-primus-native.emu)
 (foreign_stubs
  (language c)
  (names process_stubs))
 (c_library_flags
  (:include threads.flags))
 (preprocess
  (pps ppx_bap))
 (libraries
  bap
  bap-c
  bap-core-theory
  bap-knowledge
  bap-primus
  bap-primus-native.plugin
  bap-primus-lisp.plugin
  bap-primus-native.engine
  bap-primus-native-jni.jni
  bap-primus-symbolic-executor.symbolic
  bap-taint
  core))

(rule
 (enabled_if
  (<> %{os_type} Win32))
 (action
  (with-stdout-to
   threads.flags
   (echo "(-lpthread)"))))

(rule
 (enabled_if
  (= %{os_type} Win32))
 (action
  (with-stdout-to
   threads.flags
   (echo "()"))))
