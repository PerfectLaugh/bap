(library
 (name bap_recompile)
 (public_name bap-recompile)
 (modules bap_recompile recompile_llvm recompile_optimize recompile_runtime)
 (libraries bap core unix))

(library
 (name bap_recompile_plugin)
 (public_name bap-recompile.plugin)
 (modules recompile_main)
 (libraries bap bap-main bap-recompile core))

(plugin
 (name recompile)
 (package bap-recompile)
 (libraries bap-recompile.plugin)
 (site
  (bap-common plugins)))

; the runtime, that the pass writes next to the program, is a C file,
; which is embedded in the plugin

(rule
 (target recompile_runtime.ml)
 (deps recompile_runtime.c)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let source = {xx|")
    (cat %{deps})
    (echo "|xx}\n")))))
