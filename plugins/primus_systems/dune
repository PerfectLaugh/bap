(library
 (name bap_primus_systems_plugin)
 (public_name bap-primus-systems.plugin)
 (libraries bap-knowledge bap-main bap-primus core core_kernel.caml_unix))

(plugin
 (name primus-systems)
 (package bap-primus-systems)
 (libraries bap-primus-systems.plugin)
 (site
  (bap-common plugins)))

(rule
 (target primus_systems_sites.ml)
 (deps
  (:input primus_systems_sites.ml.ab)
  (alias ../../config)
  ../../config.status)
 (action
  (with-stdin-from
   %{input}
   (with-stdout-to
    %{target}
    (chdir
     %{workspace_root}
     (run ./tools/rewrite.exe -filename %{input}))))))
