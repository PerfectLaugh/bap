(library
 (name bap_cxxfilt_plugin)
 (public_name bap-cxxfilt.plugin)
 (libraries bap bap-demangle core))

(plugin
 (name cxxfilt)
 (package bap-cxxfilt)
 (libraries bap-cxxfilt.plugin)
 (site
  (bap-common plugins)))

(rule
 (target cxxfilt_config.ml)
 (deps
  (:input cxxfilt_config.ml.ab)
  (alias ../../config)
  ../../config.status)
 (action
  (with-stdin-from
   %{input}
   (with-stdout-to
    %{target}
    (chdir
     %{workspace_root}
     (run ./tools/rewrite.exe -filename %{input}))))))
