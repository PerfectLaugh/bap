(library
 (optional)
 (name bap_primus_symbolic_executor_plugin)
 (public_name bap-primus-symbolic-executor.plugin)
 (modules primus_symbolic_executor_main)
 (preprocess
  (pps ppx_bap))
 (libraries
  bap
  bap-main
  bap-primus
  bap-primus-track-visited
  bitvec
  core
  monads
  regular
  zarith
  z3
  bap-core-theory))

(plugin
 (optional)
 (name primus-symbolic-executor)
 (package bap-primus-symbolic-executor)
 (libraries bap-primus-symbolic-executor.plugin)
 (site
  (bap-common plugins)))

;; Z3 is vendored (git submodule) and built from its sources with its CMake
;; build by build-z3.cmake, which also generates the sources of its OCaml
;; bindings, whose own build requires a global ocamlfind, so they are an
;; ordinary local library below. Z3 is linked statically, and on Windows
;; the runtime of C++ too, see build-z3.cmake.

(rule
 (targets
  (dir libz3))
 (deps
  build-z3.cmake
  (source_tree z3))
 (action
  (run
   cmake
   -DSRC=z3
   -DOUT=libz3
   -DLINK_PREFIX=plugins/primus_symbolic_executor/libz3
   "-DCC=%{cc}"
   "-DCXX=%{cxx}"
   -P
   %{dep:build-z3.cmake})))

(rule
 (targets
  z3enums.ml
  z3native.ml
  z3.ml
  z3.mli
  z3native_stubs.c
  z3native_stubs.h
  c.flags
  link.flags)
 (action
  (progn
   (copy libz3/ml/z3enums.ml z3enums.ml)
   (copy libz3/ml/z3native.ml z3native.ml)
   (copy libz3/ml/z3.ml z3.ml)
   (copy libz3/ml/z3.mli z3.mli)
   (copy libz3/ml/z3native_stubs.c z3native_stubs.c)
   (copy libz3/ml/z3native_stubs.h z3native_stubs.h)
   (copy libz3/c.flags c.flags)
   (copy libz3/link.flags link.flags))))

(library
 (name z3)
 (public_name bap-primus-symbolic-executor.z3)
 (wrapped false)
 (modules z3enums z3native z3)
 (libraries zarith)
 (foreign_stubs
  (language c)
  (names z3native_stubs)
  (flags
   :standard
   -I.
   -Ilibz3/include
   (:include c.flags)))
 (c_library_flags
  (:include link.flags)))
