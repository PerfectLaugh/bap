; The arithmetic of IEEE 754, see primus_lisp_softfloat.ml, which the
; Lisp intrinsics and the lifted engine, see Bap_lifted, run. It has no
; options, as the plugins, that link it, may load before primus-lisp.

(library
 (name primus_lisp_softfloat)
 (public_name bap-primus-lisp.softfloat)
 (preprocess
  (pps ppx_bap))
 (inline_tests)
 (libraries core zarith))
