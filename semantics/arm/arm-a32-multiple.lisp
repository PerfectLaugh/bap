;;; THE MULTIPLE LOADS AND STORES
;;
;; The A32 and T32 LDM and STM instructions take the registers of the
;; list as their last operands, in the ascending order, and the lowest
;; register is at the lowest address. The base is written back before
;; the registers are loaded, so a loaded base keeps the loaded value,
;; and after they are stored. A load to PC is a branch.
;;
;; A definition has a fixed number of parameters, so each instruction
;; has a definition for each length of the list.

(defmacro a32-count (r) 1)
(defmacro a32-count (r rs) (+ 1 (a32-count rs)))

(defmacro a32-load-regs (a r) (a32-set r (load-word a)))
(defmacro a32-load-regs (a r rs)
  (prog (a32-load-regs a r) (a32-load-regs (+ a 4) rs)))

(defmacro a32-store-regs (a r) (store-word a (a32-reg r)))
(defmacro a32-store-regs (a r rs)
  (prog (a32-store-regs a r) (a32-store-regs (+ a 4) rs)))

(defun a32-first (mode rn n)
  "the lowest address of N registers"
  (case mode
    'ia rn
    'ib (+ rn 4)
    'da (- rn (* 4 (- n 1)))
    'db (- rn (* 4 n))))

(defun a32-after (mode rn n)
  "the base after the access to N registers"
  (case mode
    'ia (+ rn (* 4 n))
    'ib (+ rn (* 4 n))
    'da (- rn (* 4 n))
    'db (- rn (* 4 n))))

(defmacro a32-ldm (mode rn cnd rs)
  (when (condition-holds cnd)
    (let ((base rn) (a (a32-first mode base (a32-count rs))))
      (a32-load-regs a rs))))

(defmacro a32-ldm-upd (mode wb rn cnd rs)
  (when (condition-holds cnd)
    (let ((base rn) (a (a32-first mode base (a32-count rs))))
      (set$ wb (a32-after mode base (a32-count rs)))
      (a32-load-regs a rs))))

(defmacro a32-stm (mode rn cnd rs)
  (when (condition-holds cnd)
    (let ((a (a32-first mode rn (a32-count rs))))
      (a32-store-regs a rs))))

(defmacro a32-stm-upd (mode wb rn cnd rs)
  (when (condition-holds cnd)
    (let ((base rn) (a (a32-first mode base (a32-count rs))))
      (a32-store-regs a rs)
      (set$ wb (a32-after mode base (a32-count rs))))))

