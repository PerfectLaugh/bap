(declare (context (target arm-family)
                  (bits 64)))

(in-package aarch64)

(require bits)
(require arm-bits)
(require arm-float)
(require aarch64-helper)
(require aarch64-simd)
(require aarch64-float)
(require aarch64-sve)

;;; THE SCALABLE VECTOR EXTENSION 2 (SVE2)
;;
;; At the vector length of aarch64-sve.lisp, of whose helpers these are
;; made, and as much of the integer arithmetic is that of Advanced SIMD,
;; of the lane functions of aarch64-simd.lisp.
;;
;; Many of its instructions work on halves: of the even elements of a
;; vector, its bottom, or the odd ones, its top. A widening one takes the
;; elements of ES/2 bits of the bottom or the top and gives a vector of
;; ES bits; a narrowing one takes elements of ES bits and gives those of
;; ES/2 bits to the bottom, with the top zero, or to the top, with the
;; bottom as it was. What is indexed takes the element of its index in
;; each segment of 128 bits.
;;
;; What is not modeled is what aarch64-sve.lisp doesn't model: FPCR and
;; FPSR, and the order of LDNT1 and STNT1.

;; the elements

(defun sve2-at (x es i part)
  "the element I of the bottom (PART 0) or the top (PART 1) of X"
  (a64-lane x es (+ (* 2 i) part)))

(defun sve2-segment-lane (x es index i ds)
  "the element INDEX of ES bits, in the segment of 128 bits of the element I
   of DS bits, of X"
  (a64-lane x es (+ (* (/ (* i ds) 128) (/ 128 es)) index)))

;; of the same size as the operands

(defun sve2-map2r/i (op es x y i)
  (let ((r (a64-op2 op (a64-lane y es i) (a64-lane x es i))))
    (if (= i 0) r (concat r (sve2-map2r/i op es x y (- i 1))))))

;; the shifts by a vector, of the whole of an element as a signed amount,
;; which a byte holds as far as it matters: an amount past the size of an
;; element shifts all of it out, either way, as Advanced SIMD's lane
;; functions have it of the byte that they take
(defun sve2-amount8 (b)
  (let ((w (word-width b)))
    (if (= w 8) b
      (cast-low 8 (fp-select (s< (cast-signed w 127) b) (cast-signed w 127)
                             (fp-select (s< b (cast-signed w -128)) (cast-signed w -128) b))))))

(defun sve2-shift/i (op es x y reversed i)
  (let ((a (a64-lane (if reversed y x) es i))
        (b (a64-lane (if reversed x y) es i))
        (r (a64-op2 op a (cast-unsigned es (sve2-amount8 b)))))
    (if (= i 0) r (concat r (sve2-shift/i op es x y reversed (- i 1))))))

(defun sve2-shift (op es zdn pg zm reversed)
  "SQSHL, UQSHL, SRSHL, URSHL, SQRSHL and UQRSHL by a vector, and the forms of them that are reversed"
  (set$ zdn (sve-merge pg es (sve2-shift/i op es zdn zm reversed (- (sve-lanes es) 1)) zdn)))

(defun sve2-binr (op es zdn pg zm)
  "the operation of ZM and ZDN, which is reversed"
  (set$ zdn (sve-merge pg es (sve2-map2r/i op es zdn zm (- (sve-lanes es) 1)) zdn)))

(defun sve2-acc/i (op es d x y i)
  (let ((r (a64-op3 op (a64-lane d es i) (a64-lane x es i) (a64-lane y es i))))
    (if (= i 0) r (concat r (sve2-acc/i op es d x y (- i 1))))))

(defun sve2-acc (op es zda zn zm)
  "the operation of three operands, the first of which is ZDA, of the lane functions of Advanced SIMD"
  (set$ zda (sve2-acc/i op es zda zn zm (- (sve-lanes es) 1))))

(defun sve2-acck/i (op es d x k i)
  (let ((r (a64-op3 op (a64-lane d es i) (a64-lane x es i) k)))
    (if (= i 0) r (concat r (sve2-acck/i op es d x k (- i 1))))))

(defun sve2-acck (op es zda zn k)
  "of an immediate K, which is static"
  (set$ zda (sve2-acck/i op es zda zn k (- (sve-lanes es) 1))))

(defun sve2-index2/i (op es x y index i)
  (let ((r (a64-op2 op (a64-lane x es i) (sve2-segment-lane y es index i es))))
    (if (= i 0) r (concat r (sve2-index2/i op es x y index (- i 1))))))

(defun sve2-index2 (op es zd zn zm index)
  "of the element INDEX of each segment of ZM"
  (set$ zd (sve2-index2/i op es zn zm index (- (sve-lanes es) 1))))

(defun sve2-index3/i (op es d x y index i)
  (let ((r (a64-op3 op (a64-lane d es i) (a64-lane x es i) (sve2-segment-lane y es index i es))))
    (if (= i 0) r (concat r (sve2-index3/i op es d x y index (- i 1))))))

(defun sve2-index3 (op es zda zn zm index)
  (set$ zda (sve2-index3/i op es zda zn zm index (- (sve-lanes es) 1))))

;; widening: of the elements of HS bits, to those of twice that

(defun sve2-long/i (op hs x y px py i)
  (let ((r (a64-op2 op (sve2-at x hs i px) (sve2-at y hs i py))))
    (if (= i 0) r (concat r (sve2-long/i op hs x y px py (- i 1))))))

(defun sve2-long (op hs zd zn zm px py)
  "of the bottom or the top of ZN, by PX, and of ZM, by PY"
  (set$ zd (sve2-long/i op hs zn zm px py (- (sve-lanes (* 2 hs)) 1))))

(defun sve2-longk/i (op hs x part k i)
  (let ((r (a64-op2 op (sve2-at x hs i part) k)))
    (if (= i 0) r (concat r (sve2-longk/i op hs x part k (- i 1))))))

(defun sve2-longk (op hs zd zn part k)
  (set$ zd (sve2-longk/i op hs zn part k (- (sve-lanes (* 2 hs)) 1))))

(defun sve2-long-index/i (op hs x y part index i)
  (let ((r (a64-op2 op (sve2-at x hs i part) (sve2-segment-lane y hs index i (* 2 hs)))))
    (if (= i 0) r (concat r (sve2-long-index/i op hs x y part index (- i 1))))))

(defun sve2-long-index (op hs zd zn zm part index)
  (set$ zd (sve2-long-index/i op hs zn zm part index (- (sve-lanes (* 2 hs)) 1))))

(defun sve2-wide/i (op hs x y part i)
  (let ((r (a64-op2 op (a64-lane x (* 2 hs) i) (sve2-at y hs i part))))
    (if (= i 0) r (concat r (sve2-wide/i op hs x y part (- i 1))))))

(defun sve2-wide (op hs zd zn zm part)
  "of the elements of ZN, of twice HS bits, and of the bottom or the top of ZM"
  (set$ zd (sve2-wide/i op hs zn zm part (- (sve-lanes (* 2 hs)) 1))))

(defun sve2-longacc/i (op hs d x y px py i)
  (let ((r (a64-op3 op (a64-lane d (* 2 hs) i) (sve2-at x hs i px) (sve2-at y hs i py))))
    (if (= i 0) r (concat r (sve2-longacc/i op hs d x y px py (- i 1))))))

(defun sve2-longacc (op hs zda zn zm px py)
  "accumulates into ZDA, of twice HS bits, what OP has of the halves of ZN and ZM"
  (set$ zda (sve2-longacc/i op hs zda zn zm px py (- (sve-lanes (* 2 hs)) 1))))

(defun sve2-longacc-index/i (op hs d x y part index i)
  (let ((r (a64-op3 op (a64-lane d (* 2 hs) i) (sve2-at x hs i part) (sve2-segment-lane y hs index i (* 2 hs)))))
    (if (= i 0) r (concat r (sve2-longacc-index/i op hs d x y part index (- i 1))))))

(defun sve2-longacc-index (op hs zda zn zm part index)
  (set$ zda (sve2-longacc-index/i op hs zda zn zm part index (- (sve-lanes (* 2 hs)) 1))))

;; narrowing: of the elements of ES bits, to the bottom or the top of a
;; vector of those of ES/2 bits

(defun sve2-place (old r part i hs)
  "the pair of elements I of HS bits: R in the bottom, with zero above, or
   in the top, with the bottom of OLD below"
  (if (= part 0) (concat (cast-unsigned hs 0) r)
    (concat r (sve2-at old hs i 0))))

(defun sve2-narrow2/i (op es old x y part i)
  (let ((r (sve2-place old (a64-op2 op (a64-lane x es i) (a64-lane y es i)) part i (/ es 2))))
    (if (= i 0) r (concat r (sve2-narrow2/i op es old x y part (- i 1))))))

(defun sve2-narrow2 (op es zd zn zm part)
  (set$ zd (sve2-narrow2/i op es zd zn zm part (- (sve-lanes es) 1))))

(defun sve2-narrowk/i (op es old x k part i)
  (let ((r (sve2-place old (a64-op2 op (a64-lane x es i) k) part i (/ es 2))))
    (if (= i 0) r (concat r (sve2-narrowk/i op es old x k part (- i 1))))))

(defun sve2-narrowk (op es zd zn k part)
  (set$ zd (sve2-narrowk/i op es zd zn k part (- (sve-lanes es) 1))))

(defun sve2-narrow1/i (op es old x part i)
  (let ((r (sve2-place old (a64-op1 op (a64-lane x es i)) part i (/ es 2))))
    (if (= i 0) r (concat r (sve2-narrow1/i op es old x part (- i 1))))))

(defun sve2-narrow1 (op es zd zn part)
  (set$ zd (sve2-narrow1/i op es zd zn part (- (sve-lanes es) 1))))

;; pairwise: of an even element, it and the next of the first operand; of
;; an odd one, it and the one before of the second

(defun sve2-pair (op es x y i)
  (if (= (mod i 2) 0)
      (a64-op2 op (a64-lane x es i) (a64-lane x es (+ i 1)))
    (a64-op2 op (a64-lane y es (- i 1)) (a64-lane y es i))))

(defun sve2-pairs/i (op es x y i)
  (let ((r (sve2-pair op es x y i)))
    (if (= i 0) r (concat r (sve2-pairs/i op es x y (- i 1))))))

(defun sve2-pairwise (op es zdn pg zm)
  (set$ zdn (sve-merge pg es (sve2-pairs/i op es zdn zm (- (sve-lanes es) 1)) zdn)))

(defun sve2-adalp/i (signed hs x y i)
  (let ((a (sve2-at y hs i 0))
        (b (sve2-at y hs i 1))
        (extend (if signed (+ (a64-sx2 a) (a64-sx2 b)) (+ (a64-ux2 a) (a64-ux2 b))))
        (r (+ (a64-lane x (* 2 hs) i) extend)))
    (if (= i 0) r (concat r (sve2-adalp/i signed hs x y (- i 1))))))

(defun sve2-adalp (signed hs zda pg zn)
  "adds the pairs of elements of HS bits of ZN to those of twice that of ZDA"
  (let ((es (* 2 hs)))
    (set$ zda (sve-merge pg es (sve2-adalp/i signed hs zda zn (- (sve-lanes es) 1)) zda))))

;; the bitwise ones of three operands, and of the halves

(defun sve2-bsl (zdn zm zk n1 n2 negate)
  "(ZDN AND ZK) OR (ZM AND NOT ZK), of ZDN inverted by N1 and ZM by N2, and
   all of it by NEGATE"
  (let ((a (if n1 (lnot zdn) zdn))
        (b (if n2 (lnot zm) zm))
        (r (logor (logand a zk) (logand b (lnot zk)))))
    (set$ zdn (if negate (lnot r) r))))

(defun sve2-eorx/i (es d x y part i)
  "of the pair I: the element of PART of X exclusive or the other of Y, and
   the other of D as it was"
  (let ((r (logxor (sve2-at x es i part) (sve2-at y es i (- 1 part))))
        (kept (sve2-at d es i (- 1 part))))
    (let ((pair (if (= part 0) (concat kept r) (concat r kept))))
      (if (= i 0) pair (concat pair (sve2-eorx/i es d x y part (- i 1)))))))

(defun sve2-eorx (es zd zn zm part)
  (set$ zd (sve2-eorx/i es zd zn zm part (- (sve-lanes (* 2 es)) 1))))

(defun sve2-xar/i (es x y k i)
  (let ((v (logxor (a64-lane x es i) (a64-lane y es i)))
        (r (if (= k es) v (logor (rshift v k) (lshift v (- es k))))))
    (if (= i 0) r (concat r (sve2-xar/i es x y k (- i 1))))))

(defun sve2-xar (es zdn zm k) (set$ zdn (sve2-xar/i es zdn zm k (- (sve-lanes es) 1))))

;; of the carries: the bottom or the top of ZN added to ZDA's bottom, with
;; the carry from the bit 0 of the top of ZM, which the carry out goes to

(defun sve2-adcl/i (es d x y part subtract i)
  (let ((a (sve2-at x es i part))
        (b (if subtract (lnot a) a))
        (carry (cast-unsigned (+ es 1) (select 0 (sve2-at y es i 1))))
        (sum (+ (cast-unsigned (+ es 1) (sve2-at d es i 0)) (cast-unsigned (+ es 1) b) carry))
        (pair (concat (cast-unsigned es (select es sum)) (cast-low es sum))))
    (if (= i 0) pair (concat pair (sve2-adcl/i es d x y part subtract (- i 1))))))

(defun sve2-adcl (es zda zn zm part subtract)
  (set$ zda (sve2-adcl/i es zda zn zm part subtract (- (sve-lanes (* 2 es)) 1))))

;; complex numbers, of the pairs of elements: the even one real, the odd
;; one imaginary. ROT is the field of the rotation, 0 to 3 of 0 to 270
;; degrees, or of CADD 0 and 1 of 90 and 270

(defun sve2-cadd/i (es x y rot sat i)
  (let ((xr (sve2-at x es i 0)) (xi (sve2-at x es i 1))
        (yr (sve2-at y es i 0)) (yi (sve2-at y es i 1))
        (r (if (= rot 0) (if sat (a64-op2 'sqsub xr yi) (- xr yi))
             (if sat (a64-op2 'sqadd xr yi) (+ xr yi))))
        (im (if (= rot 0) (if sat (a64-op2 'sqadd xi yr) (+ xi yr))
              (if sat (a64-op2 'sqsub xi yr) (- xi yr))))
        (pair (concat im r)))
    (if (= i 0) pair (concat pair (sve2-cadd/i es x y rot sat (- i 1))))))

(defun sve2-cadd (es zdn zm rot sat)
  (set$ zdn (sve2-cadd/i es zdn zm rot sat (- (sve-lanes (* 2 es)) 1))))

(defun sve2-cmla-part (es acc a b negate rounding)
  "ACC plus or minus A times B, of the elements of ES bits: of CMLA modulo
   their size, and of SQRDCMLAH doubled, rounded and saturated"
  (if rounding
      (let ((w (+ (* 2 es) 3))
            (p (* (cast-signed w a) (cast-signed w b) (cast-signed w 2)))
            (s (+ (lshift (cast-signed w acc) es)
                  (if negate (neg p) p)
                  (lshift (cast-unsigned w 1) (- es 1)))))
        (a64-sat-s (arshift s es) es))
    (let ((p (* a b)))
      (if negate (- acc p) (+ acc p)))))

(defun sve2-cmla-pair (es d x y i j rot rounding)
  "of the pair I of D and X, with the pair J of Y"
  (let ((sel (mod rot 2))
        (a (sve2-at x es i sel))
        (yr (sve2-at y es j sel))
        (yi (sve2-at y es j (- 1 sel)))
        (r (sve2-cmla-part es (sve2-at d es i 0) a yr (not (= sel (/ rot 2))) rounding))
        (im (sve2-cmla-part es (sve2-at d es i 1) a yi (= (/ rot 2) 1) rounding)))
    (concat im r)))

(defun sve2-cmla/i (es d x y rot rounding i)
  (let ((pair (sve2-cmla-pair es d x y i i rot rounding)))
    (if (= i 0) pair (concat pair (sve2-cmla/i es d x y rot rounding (- i 1))))))

(defun sve2-cmla (es zda zn zm rot rounding)
  (set$ zda (sve2-cmla/i es zda zn zm rot rounding (- (sve-lanes (* 2 es)) 1))))

(defun sve2-cmla-index/i (es d x y index rot rounding i)
  "of the pair INDEX of each segment of Y"
  (let ((j (+ (* (/ (* i 2 es) 128) (/ 128 (* 2 es))) index))
        (pair (sve2-cmla-pair es d x y i j rot rounding)))
    (if (= i 0) pair (concat pair (sve2-cmla-index/i es d x y index rot rounding (- i 1))))))

(defun sve2-cmla-index (es zda zn zm index rot rounding)
  (set$ zda (sve2-cmla-index/i es zda zn zm index rot rounding (- (sve-lanes (* 2 es)) 1))))

;; CDOT: of each element of four times QS bits, the sum of two complex
;; products of the elements of QS bits, of the second conjugated as the
;; rotation says: of 0 degrees the real part of the products, rr - ii, of
;; 90 the imaginary, ri + ir, of 180 rr + ii and of 270 ri - ir
(defun sve2-cdot-terms (qs x y e ye sel)
  "the products of the real elements of X, of the element E, with those of
   the element YE of Y, by SEL"
  (+ (* (cast-signed (* 4 qs) (a64-lane x qs (* 4 e)))
        (cast-signed (* 4 qs) (a64-lane y qs (+ (* 4 ye) sel))))
     (* (cast-signed (* 4 qs) (a64-lane x qs (+ (* 4 e) 2)))
        (cast-signed (* 4 qs) (a64-lane y qs (+ (* 4 ye) 2 sel))))))

(defun sve2-cdot/i (qs d x y indexed index rot i)
  "of the element I, of Y's element INDEX of its segment if INDEXED, or of its own"
  (let ((ye (if indexed (+ (* (/ (* i 4 qs) 128) (/ 128 (* 4 qs))) index) i))
        (sel (mod rot 2))
        (t1 (sve2-cdot-terms qs x y i ye sel))
        (u0 (* (cast-signed (* 4 qs) (a64-lane x qs (+ (* 4 i) 1)))
               (cast-signed (* 4 qs) (a64-lane y qs (+ (* 4 ye) (- 1 sel))))))
        (u1 (* (cast-signed (* 4 qs) (a64-lane x qs (+ (* 4 i) 3)))
               (cast-signed (* 4 qs) (a64-lane y qs (+ (* 4 ye) 2 (- 1 sel))))))
        (t2 (+ u0 u1))
        (r (+ (a64-lane d (* 4 qs) i) t1 (if (= sel (/ rot 2)) (neg t2) t2))))
    (if (= i 0) r (concat r (sve2-cdot/i qs d x y indexed index rot (- i 1))))))

(defun sve2-cdot (qs zda zn zm indexed index rot)
  (set$ zda (sve2-cdot/i qs zda zn zm indexed index rot (- (sve-lanes (* 4 qs)) 1))))

;; the floating point ones

(defun sve2-fpairwise (op es zdn pg zm)
  (set$ zdn (sve-merge pg es (sve2-pairs/i op es zdn zm (- (sve-lanes es) 1)) zdn)))

(defun sve2-fmuladd-h (acc a b)
  "ACC plus A times B, of halves of precision A and B, which are exact as
   singles, rounded once, as FPMulAddH has it: a NaN of the operands as they
   are, signaling ones first, of ACC, A and B in turn, converted"
  (let ((w (word-width acc))
        (wa (fconvert :rne w a))
        (wb (fconvert :rne w b)))
    (fp-select (a64-is-snan acc) (a64-quiet-nan acc)
      (fp-select (a64-is-snan a) wa
        (fp-select (a64-is-snan b) wb
          (fp-select (is-nan acc) (fp-select (a64-inf-times-zero a b) (a64-default-nan acc) acc)
            (fp-select (is-nan a) wa
              (fp-select (is-nan b) wb (a64-muladd acc wa wb)))))))))

(defun sve2-fmlal/i (hs d x y px py indexed index subtract i)
  "of the element I of D, of single precision, the product of the halves of
   precision of X and Y, the first negated to subtract, added"
  (let ((a (sve2-at x hs i px))
        (b (if indexed (sve2-segment-lane y hs index i (* 2 hs)) (sve2-at y hs i py)))
        (r (sve2-fmuladd-h (a64-lane d (* 2 hs) i) (if subtract (fp-neg a) a) b)))
    (if (= i 0) r (concat r (sve2-fmlal/i hs d x y px py indexed index subtract (- i 1))))))

(defun sve2-fmlal (hs zda zn zm part indexed index subtract)
  (set$ zda (sve2-fmlal/i hs zda zn zm part part indexed index subtract (- (sve-lanes (* 2 hs)) 1))))

(defun sve2-fcvtlt/i (hs x i)
  (let ((r (fconvert :rne (* 2 hs) (sve2-at x hs i 1))))
    (if (= i 0) r (concat r (sve2-fcvtlt/i hs x (- i 1))))))

(defun sve2-fcvtlt (hs zd pg zn)
  "the top of ZN, of HS bits, widened"
  (let ((es (* 2 hs)))
    (set$ zd (sve-merge pg es (sve2-fcvtlt/i hs zn (- (sve-lanes es) 1)) zd))))

(defun sve2-fcvtn/i (es old x odd mode i)
  (let ((r (if (= mode 0) (fconvert :rne (/ es 2) (a64-lane x es i))
             (fconvert :rod (/ es 2) (a64-lane x es i))))
        (pair (if odd (concat r (sve2-at old (/ es 2) i 0))
                (concat (cast-unsigned (/ es 2) 0) r))))
    (if (= i 0) pair (concat pair (sve2-fcvtn/i es old x odd mode (- i 1))))))

(defun sve2-fcvtn (es zd pg zn odd mode)
  "the elements of ZN narrowed, to the top or the bottom, of what is active
   by the elements of ES bits, rounded to nearest (MODE 0) or to odd"
  (set$ zd (sve-merge pg es (sve2-fcvtn/i es zd zn odd mode (- (sve-lanes es) 1)) zd)))

(defun sve2-flogb-lane (a)
  "the exponent of A, unbiased, as a signed integer: of a subnormal by its
   highest bit, of zero and a NaN the least integer, and of an infinity the
   greatest"
  (let ((es (word-width a))
        (fb (a64-frac-bits a))
        (bias (- (lshift 1 (- (a64-fexp-bits a) 1)) 1))
        (e (cast-unsigned es (extract (- es 2) fb a)))
        (frac (cast-unsigned es (cast-low fb a)))
        (least (lshift (a64-one a) (- es 1)))
        (normal (- e (cast-unsigned es bias)))
        (sub (- (cast-unsigned es es) (cast-unsigned es (+ bias fb)) (cast-unsigned es (clz frac)))))
    (fp-select (logor (is-nan a) (is-fzero a)) least
      (fp-select (is-inf a) (lnot least)
        (fp-select (is-zero e) sub normal)))))

(defun sve2-flogb/i (es x i)
  (let ((r (sve2-flogb-lane (a64-lane x es i))))
    (if (= i 0) r (concat r (sve2-flogb/i es x (- i 1))))))

(defun sve2-flogb (es zd pg zn)
  (set$ zd (sve-merge pg es (sve2-flogb/i es zn (- (sve-lanes es) 1)) zd)))

;; the elements that match, and the histograms

(defun sve2-in-segment (x es v i ds j)
  "whether V is one of the elements of ES bits, from J down, of the segment
   of 128 bits of X of the element I of DS bits"
  (let ((c (= v (sve2-segment-lane x es j i ds))))
    (if (= j 0) c (logor c (sve2-in-segment x es v i ds (- j 1))))))

(defun sve2-match/i (es pg x y negate i)
  (let ((v (a64-lane x es i))
        (found (sve2-in-segment y es v i es (- (/ 128 es) 1)))
        (c (logand (sve-active pg es i) (if negate (lnot found) found)))
        (r (sve-pbit c es)))
    (if (= i 0) r (concat r (sve2-match/i es pg x y negate (- i 1))))))

(defun sve2-match (es pd pg zn zm negate)
  (let ((g pg)
        (r (sve2-match/i es g zn zm negate (- (sve-lanes es) 1))))
    (set$ pd r)
    (sve-flags g r es)))

(defun sve2-histcnt-count (es pg x y v j)
  "how many of the elements of Y from J down are active and equal to V"
  (let ((c (cast-unsigned es (logand (sve-active pg es j) (= v (a64-lane y es j))))))
    (if (= j 0) c (+ c (sve2-histcnt-count es pg x y v (- j 1))))))

(defun sve2-histcnt/i (es pg x y i)
  (let ((r (fp-select (sve-active pg es i)
                      (sve2-histcnt-count es pg x y (a64-lane x es i) i)
                      (cast-unsigned es 0))))
    (if (= i 0) r (concat r (sve2-histcnt/i es pg x y (- i 1))))))

(defun sve2-histcnt (es zd pg zn zm)
  (set$ zd (sve2-histcnt/i es pg zn zm (- (sve-lanes es) 1))))

(defun sve2-histseg-count (x v i j)
  (let ((c (cast-unsigned 8 (= v (sve2-segment-lane x 8 j i 8)))))
    (if (= j 0) c (+ c (sve2-histseg-count x v i (- j 1))))))

(defun sve2-histseg/i (x y i)
  (let ((r (sve2-histseg-count y (a64-lane x 8 i) i 15)))
    (if (= i 0) r (concat r (sve2-histseg/i x y (- i 1))))))

(defun sve2-histseg (zd zn zm) (set$ zd (sve2-histseg/i zn zm (- (sve-lanes 8) 1))))

;; the moves of more than one register

(defun sve2-splice (es zd pg zn zm)
  "SPLICE of ZN, the first of a list, and ZM, its second"
  (let ((n (sve-lanes es))
        (last (sve-last-index pg es (- n 1)))
        (first (sve-first-index pg es 0))
        (count (cast-unsigned *sve-vl* (- (+ last (cast-unsigned 64 1)) first)))
        (bits (* count (cast-unsigned *sve-vl* es)))
        (keep (lnot (lshift (lnot (sve-zeros)) bits))))
    (set$ zd (logor (logand keep (rshift zn (* (cast-unsigned *sve-vl* first)
                                               (cast-unsigned *sve-vl* es))))
                    (lshift zm bits)))))

(defun sve2-tbl/i (es table old zm i)
  "of the element I of ZM an index into the elements of TABLE, of two vectors,
   and of one past them the element of OLD"
  (let ((n (* 2 (sve-lanes es)))
        (w (* 2 *sve-vl*))
        (j (cast-unsigned w (a64-lane zm es i)))
        (big (>= j (cast-unsigned w n)))
        (r (fp-select big (a64-lane old es i)
                      (cast-low es (rshift table (* (fp-select big (cast-unsigned w 0) j)
                                                    (cast-unsigned w es)))))))
    (if (= i 0) r (concat r (sve2-tbl/i es table old zm (- i 1))))))

(defun sve2-tbl (es zd list zm)
  (set$ zd (sve2-tbl/i es (a64-vt-table list 2) (sve-zeros) zm (- (sve-lanes es) 1))))

(defun sve2-tbx/i (es zn old zm i)
  (let ((j (cast-unsigned *sve-vl* (a64-lane zm es i)))
        (big (>= j (cast-unsigned *sve-vl* (sve-lanes es))))
        (r (fp-select big (a64-lane old es i)
                      (cast-low es (rshift zn (* (fp-select big (sve-zeros) j)
                                                 (cast-unsigned *sve-vl* es)))))))
    (if (= i 0) r (concat r (sve2-tbx/i es zn old zm (- i 1))))))

(defun sve2-tbx (es zd zn zm) (set$ zd (sve2-tbx/i es zn zd zm (- (sve-lanes es) 1))))

;; WHILE of what goes down: the last element is of the first operand, and
;; each before it of one less, to the first that the condition doesn't hold of

(defun sve2-whiledown-cond (op a b)
  (case op
    'ge (s>= a b)
    'gt (s> a b)
    'hi (> a b)
    (>= a b)))

(defun sve2-whiledown/i (op es a b i last)
  (let ((k (- (sve-lanes es) 1 i))
        (c (logand last (sve2-whiledown-cond op (- a (cast-unsigned (word-width a) k)) b))))
    (if (= i 0)
        (sve-pbit c es)
      (concat (sve-pbit c es) (sve2-whiledown/i op es a b (- i 1) c)))))

(defun sve2-whiledown (op es bits pd rn rm)
  (let ((r (sve2-whiledown/i op es (cast-low bits rn) (cast-low bits rm) (- (sve-lanes es) 1) (cast-unsigned 1 1))))
    (set$ pd r)
    (sve-flags (lnot (cast-unsigned (sve-pl) 0)) r es)))

;; WHILERW and WHILEWR: of the elements before a conflict of the addresses

(defun sve2-whilerw/i (es diff any i)
  (let ((c (logor any (< (cast-unsigned 64 i) diff)))
        (r (sve-pbit c es)))
    (if (= i 0) r (concat r (sve2-whilerw/i es diff any (- i 1))))))

(defun sve2-while-conflict (es pd rn rm read)
  "of WHILERW (READ) the distance either way, and of WHILEWR that up, in elements"
  (let ((d (- rm rn))
        (size (cast-unsigned 64 (/ es 8)))
        (distance (if read (fp-select (msb d) (neg d) d) d))
        (diff (fp-select (msb distance) (neg (/ (neg distance) size)) (/ distance size)))
        (any (if read (is-zero diff) (logor (msb diff) (is-zero diff))))
        (r (sve2-whilerw/i es diff any (- (sve-lanes es) 1))))
    (set$ pd r)
    (sve-flags (lnot (cast-unsigned (sve-pl) 0)) r es)))

;; the loads and the stores of a vector of addresses and a scalar offset

(defun sve2-ldnt1 (es ms signed zt pg zn rm)
  (set$ zt (sve-gldi/i es ms signed pg zn rm (- (sve-lanes es) 1))))

(defun sve2-stnt1 (es ms zt pg zn rm) (sve-ssti/i es ms zt pg zn rm 0))

