(declare (context (target arm-family)
                  (bits 64)))

(in-package aarch64)

(require bits)
(require arm-bits)
(require arm-float)
(require aarch64-helper)
(require aarch64-simd)
(require aarch64-float)
(require aarch64-sve)
(require aarch64-sve2)

;;; THE SCALABLE MATRIX EXTENSION (SME AND SME2)
;;
;; The streaming vector length is that of SVE, *sve-vl*, 128 bits, so
;; that a vector of the streaming mode is the Zn it is out of it, and
;; the same semantics serve both. ZA is a variable of 16 rows of 128
;; bits, the row N in its bits 128N to 128N + 127, and ZT0 one of 512
;; bits. The tile T of elements of ES bits, ZA<ES>T, is the rows
;; I * ES/8 + T of ZA, for I below 128 / ES, its rows, so that a tile
;; is named by its number, see aarch64SmeRegister of
;; Bap/Target/LLVMLift.lean. To change the vector length, change both,
;; and the widths of ZA and ZT0 there.
;;
;; PSTATE.SM and PSTATE.ZA are PSTATE_SM and PSTATE_ZA, which SVCR is.
;; An instruction that is of the streaming mode is undefined out of it,
;; as is one of ZA or ZT0 while ZA is off, as the Arm ARM's
;; CheckStreamingSVEEnabled and CheckSMEAndZAEnabled have it. The
;; processor has no SVE2.1, so that what SVE2.1 shares with SME2 is of
;; the streaming mode only. It has FEAT_SME_FA64, as qemu's of -cpu max
;; has, so that all of SVE and Advanced SIMD is of the streaming mode
;; too, and nothing else is checked of it. A change of PSTATE.SM zeros
;; the Z and P registers and FFR and sets FPSR to 0x0800009f, which is
;; ResetSVEState, and a change of PSTATE.ZA zeros ZA and ZT0, which is
;; ResetSMEState: ZA is unseen while it is off, so that zeroing it as it
;; goes off is as zeroing it as it comes on.
;;
;; What is of ZA of floating point gives the default NaN and no flags,
;; as FPMulAdd_ZA and its kin, and the dot products of BFloat16 are as
;; BFDotAdd of FPCR.EBF 0: each product and sum is rounded to odd, to
;; infinity if it is too big, of a denormal input or result zero, and of
;; a NaN the default NaN.

;;; THE STATE

(defun sme-check-sm ()
  "of the streaming mode only"
  (when (is-zero PSTATE_SM) (a64-undefined)))

(defun sme-check-za ()
  "of ZA or ZT0, which are while ZA is on"
  (when (is-zero PSTATE_ZA) (a64-undefined)))

(defun sme-check-sm-za ()
  (when (logor (is-zero PSTATE_SM) (is-zero PSTATE_ZA)) (a64-undefined)))

(defun sme-zero-vectors (r n)
  "zeros N registers of the Q registers from the symbol R up"
  (set-symbol-value r (cast-unsigned 128 0))
  (when (> n 1) (sme-zero-vectors (a64-vt-next r) (- n 1))))

(defun sme-reset-sve ()
  "ResetSVEState"
  (sme-zero-vectors 'Q0 32)
  (set$ P0 0:16) (set$ P1 0:16) (set$ P2 0:16) (set$ P3 0:16)
  (set$ P4 0:16) (set$ P5 0:16) (set$ P6 0:16) (set$ P7 0:16)
  (set$ P8 0:16) (set$ P9 0:16) (set$ P10 0:16) (set$ P11 0:16)
  (set$ P12 0:16) (set$ P13 0:16) (set$ P14 0:16) (set$ P15 0:16)
  (set$ FFR 0:16)
  (set FPSR (cast-unsigned 32 0x0800009f)))

(defun sme-set-sm (v)
  (when (/= v PSTATE_SM)
    (sme-reset-sve)
    (set PSTATE_SM v)))

(defun sme-set-za (v)
  (when (/= v PSTATE_ZA)
    (set$ ZA (cast-unsigned 2048 0))
    (set$ ZT0 (cast-unsigned 512 0))
    (set PSTATE_ZA v)))

(defun sme-set-svcr (x)
  (sme-set-sm (select 0 x))
  (sme-set-za (select 1 x)))

(defun sme-svcr () (logor (cast-unsigned 64 PSTATE_SM) (lshift (cast-unsigned 64 PSTATE_ZA) 1)))

;;; ZA

(defun sme-row-mask () (cast-unsigned 2048 (lnot (cast-unsigned 128 0))))

(defun sme-row (r)
  "the row R of ZA"
  (cast-low 128 (rshift ZA (* (cast-unsigned 64 r) 128))))

(defun sme-set-bits (off n x)
  "sets the N bits of ZA from the bit OFF to X"
  (let ((o (cast-unsigned 64 off)))
    (set$ ZA (logor (logand ZA (lnot (lshift (cast-unsigned 2048 (lnot (cast-unsigned n 0))) o)))
                    (lshift (cast-unsigned 2048 x) o)))))

(defun sme-set-row (r x) (sme-set-bits (* (cast-unsigned 64 r) 128) 128 x))

(defun sme-tiles (es) (/ es 8))
(defun sme-dim (es) (/ 128 es))
(defun sme-tile-row (es t i)
  "the row of ZA of the row I of the tile T of ES bits"
  (+ (* i (sme-tiles es)) t))

(defun sme-index (wv imm n)
  "(Wv + IMM) modulo N, which is a power of two"
  (logand (+ (cast-unsigned 64 wv) (cast-unsigned 64 imm)) (cast-unsigned 64 (- n 1))))

(defun sme-vslice/i (es t s i)
  (let ((r (cast-low es (rshift ZA (+ (* (cast-unsigned 64 (sme-tile-row es t i)) 128)
                                      (* (cast-unsigned 64 s) es))))))
    (if (= i 0) r (concat r (sme-vslice/i es t s (- i 1))))))

(defun sme-slice (es t vertical s)
  "the horizontal or vertical slice S of the tile T of ES bits"
  (if vertical (sme-vslice/i es t s (- (sme-dim es) 1))
    (sme-row (sme-tile-row es t s))))

(defun sme-set-vslice/i (es t s x i)
  (sme-set-bits (+ (* (cast-unsigned 64 (sme-tile-row es t i)) 128) (* (cast-unsigned 64 s) es))
                es (a64-lane x es i))
  (when (> i 0) (sme-set-vslice/i es t s x (- i 1))))

(defun sme-set-slice (es t vertical s x)
  (if vertical (sme-set-vslice/i es t s x (- (sme-dim es) 1))
    (sme-set-row (sme-tile-row es t s) x)))

(defun sme-zero-tiles/i (mask i)
  "ZERO of the tiles of 64 bits of MASK: the tile I is the rows I and I + 8"
  (when (select i mask)
    (sme-set-row i (cast-unsigned 128 0))
    (sme-set-row (+ i 8) (cast-unsigned 128 0)))
  (when (> i 0) (sme-zero-tiles/i mask (- i 1))))

;; the vectors of ZA of a group: ZA.<T>[Wv, OFF, VGxN] is the rows
;; ((Wv + OFF) mod (16 / N)) + R * 16 / N of the vectors R of the group,
;; and of a group of K consecutive vectors, e.g., ZA.S[Wv, OFF:OFF+3],
;; the base is a multiple of K, as the Arm ARM has vec - vec MOD K

(defun sme-vg-stride (nreg) (/ 16 nreg))
(defun sme-vg-base (wv off nreg k)
  (logand (sme-index wv (* off k) (sme-vg-stride nreg)) (lnot (cast-unsigned 64 (- k 1)))))
(defun sme-vg-row (base nreg r i) (+ base (* r (sme-vg-stride nreg)) i))

;;; THE LISTS OF REGISTERS

(defun sme-nth (l k) (if (= k 0) (car l) (sme-nth (cdr l) (- k 1))))

(defun sme-z (l k)
  "the register K of a list of Z registers, consecutive or strided"
  (if (list? l) (sme-nth l k) (a64-vt-get l k)))

(defun sme-set-z (l k x)
  (if (list? l) (set$ (sme-nth l k) (cast-unsigned 128 x)) (a64-vt-set l k x)))

(defun sme-zs/i (l k)
  "the registers of L from K down, concatenated, the first lowest"
  (if (= k 0) (sme-z l 0) (concat (sme-z l k) (sme-zs/i l (- k 1)))))

(defun sme-zs (l n) (sme-zs/i l (- n 1)))

(defun sme-set-zs (l n x)
  "sets the N registers of L to the vectors of X, the first lowest"
  (sme-set-z l (- n 1) (cast-low 128 (rshift x (* (- n 1) 128))))
  (when (> n 1) (sme-set-zs l (- n 1) x)))

;;; THE PREDICATES AS COUNTERS

(defun sme-pn-elements (es nvl) (/ (* *sve-vl* nvl) es))

(defun sme-pn-mask (psize count inv)
  "the predicate of four vectors whose COUNT first elements of PSIZE bits
   of a predicate are active, or whose others are, if INV"
  (let ((pattern (replicate (cast-unsigned psize 1) (/ 64 psize)))
        (first (cast-low 64 (- (lshift (cast-unsigned 128 1) (* (cast-unsigned 64 count) psize))
                               (cast-unsigned 128 1)))))
    (logand pattern (fp-select inv (lnot first) first))))

(defun sme-pn-expand (pn)
  "CounterToPredicate of PN, of four vectors"
  (let ((inv (select 15 pn)))
    (fp-select (select 0 pn) (sme-pn-mask 1 (extract 6 1 pn) inv)
      (fp-select (select 1 pn) (sme-pn-mask 2 (extract 6 2 pn) inv)
        (fp-select (select 2 pn) (sme-pn-mask 4 (extract 6 3 pn) inv)
          (fp-select (select 3 pn) (sme-pn-mask 8 (extract 6 4 pn) inv)
            (cast-unsigned 64 0)))))))

(defun sme-pn-part (pn k)
  "the predicate of the vector K of PN"
  (cast-low 16 (rshift (sme-pn-expand pn) (* k 16))))

(defun sme-pn-encode (es elements count invert)
  "EncodePredCount: COUNT is of a static width, and INVERT static"
  (let ((n (cast-unsigned 16 count))
        (all (= n (cast-unsigned 16 elements)))
        (inv (if invert (cast-unsigned 16 1) (cast-unsigned 16 all)))
        (c (if invert (- (cast-unsigned 16 elements) n) (fp-select all (cast-unsigned 16 0) n)))
        (low (/ es 8))
        (p (logor (lshift inv 15)
                  (logor (logand (lshift c (+ (sme-log2 low) 1)) (cast-unsigned 16 0x7f))
                         (cast-unsigned 16 low)))))
    (fp-select (is-zero n) (cast-unsigned 16 0) p)))

(defun sme-log2 (n) (case n 1 0 2 1 4 2 8 3 16 4 0))

(defun sme-pn-flags (elements count invert)
  "PredCountTest"
  (let ((n (cast-unsigned 16 count))
        (all (= n (cast-unsigned 16 elements)))
        (none (is-zero n)))
    (set ZF none)
    (set VF (cast-unsigned 1 0))
    (if invert
        (prog (set NF all) (set CF none))
      (prog (set NF (lnot none)) (set CF (lnot all))))))

(defun sme-while-count/i (op es a b i n last)
  "the count of the first elements of the conditions of WHILE, up"
  (let ((c (logand last (sve-while-cond op (+ a (cast-unsigned (word-width a) i)) b)))
        (k (cast-unsigned 16 c)))
    (if (= i (- n 1)) k
      (+ k (sme-while-count/i op es a b (+ i 1) n c)))))

(defun sme-whiledown-count/i (op es a b i n last)
  "the count of the last elements of the conditions of WHILE, down"
  (let ((c (logand last (sve2-whiledown-cond op (- a (cast-unsigned (word-width a) i)) b)))
        (k (cast-unsigned 16 c)))
    (if (= i (- n 1)) k
      (+ k (sme-whiledown-count/i op es a b (+ i 1) n c)))))

(defun sme-while-down (op) (case op 'ge true 'gt true 'hi true 'hs true false))

(defun sme-while-pn (op es pd rn rm nvl)
  "WHILE of a predicate as a counter of NVL vectors"
  (sme-check-sm)
  (let ((n (sme-pn-elements es nvl))
        (down (sme-while-down op))
        (count (if down
                   (sme-whiledown-count/i op es rn rm 0 n (cast-unsigned 1 1))
                 (sme-while-count/i op es rn rm 0 n (cast-unsigned 1 1)))))
    (set$ pd (sme-pn-encode es n count down))
    (sme-pn-flags n count down)))

(defun sme-while-pair (op es pl rn rm)
  "WHILE of a pair of predicates, of the elements of two vectors"
  (sme-check-sm)
  (let ((n (sme-pn-elements es 2))
        (down (sme-while-down op))
        (count (if down
                   (sme-whiledown-count/i op es rn rm 0 n (cast-unsigned 1 1))
                 (sme-while-count/i op es rn rm 0 n (cast-unsigned 1 1))))
        (all (cast-low 32 (sme-pn-mask (/ es 8) (cast-unsigned 16 n) false)))
        (m (if down (sme-pn-mask (/ es 8) (- (cast-unsigned 16 n) count) true)
             (sme-pn-mask (/ es 8) count false)))
        (r (logand all (cast-low 32 m))))
    (set$ (sme-nth pl 0) (cast-low 16 r))
    (set$ (sme-nth pl 1) (cast-high 16 r))
    (sme-pred-flags (cast-unsigned 32 all) r es)))

(defun sme-pred-flags (mask x es)
  "PredTest of a predicate of two vectors"
  (let ((lsb (replicate (cast-unsigned (/ es 8) 1) (/ 32 (/ es 8))))
        (active (logand (logand mask x) lsb))
        (m (logand mask lsb)))
    (set NF (non-zero (logand active (sve-lowest m))))
    (set ZF (is-zero active))
    (set CF (is-zero (logand active (sve-highest m))))
    (set VF (cast-unsigned 1 0))))

;;; FLOATING POINT

(defun sme-dn (x)
  "X, or the default NaN if it is a NaN, as of what is of ZA"
  (fp-select (is-nan x) (a64-default-nan x) x))

(defun sme-fma (acc a b)
  "ACC + A * B rounded once, without its default NaN"
  (a64-muladd acc a b))

(defun sme-h2s (x) (fconvert :rne 32 x))
(defun sme-bf2s (x) (concat x (cast-unsigned 16 0)))

(defun sme-nan4 (a b c d)
  "of four halves, at least one of which is a NaN, the NaN of FPProcessNaNs4,
   as a single"
  (fp-select (a64-is-snan a) (a64-h-nan-to-s a)
    (fp-select (a64-is-snan b) (a64-h-nan-to-s b)
      (fp-select (a64-is-snan c) (a64-h-nan-to-s c)
        (fp-select (a64-is-snan d) (a64-h-nan-to-s d)
          (fp-select (is-nan a) (a64-h-nan-to-s a)
            (fp-select (is-nan b) (a64-h-nan-to-s b)
              (fp-select (is-nan c) (a64-h-nan-to-s c) (a64-h-nan-to-s d)))))))))

(defun sme-fdot2 (n0 n1 m0 m1)
  "FPDot: N0 * M0 + N1 * M1 of halves, rounded once to a single. The
   product of two halves is exact in a single, so that a fused
   multiply-add of the other two rounds the sum once"
  (let ((p (*. :rne (sme-h2s n0) (sme-h2s m0)))
        (r (intrinsic 'fmad_rne_ieee754_binary_32 (sme-h2s n1) (sme-h2s m1) p :result 32)))
    (fp-select (logor (is-nan n0) (is-nan n1) (is-nan m0) (is-nan m1))
               (sme-nan4 n0 n1 m0 m1)
               ;; the width of what an intrinsic gives isn't known as this is compiled
               (fp-select (is-nan r) (cast-unsigned 32 0x7fc00000) r))))

(defun sme-fdot-add (acc n0 n1 m0 m1)
  "FPDotAdd: the dot product added to ACC, which is not fused"
  (a64-fop2 'fadd acc (sme-fdot2 n0 n1 m0 m1)))

;; BFDotAdd of FPCR.EBF 0

(defun sme-bf-in (x)
  "a single of a BFloat16 operation: a denormal is a zero of its sign"
  (fp-select (logand (is-zero (extract 30 23 x)) (non-zero (extract 22 0 x)))
             (logand x (cast-unsigned 32 0x80000000)) x))

(defun sme-bf-narrow (x)
  "the double X, a result of a BFloat16 operation rounded to odd, to a
   single rounded to odd: of a NaN the default NaN, too big an infinity,
   and too small a zero, of its sign"
  (let ((sign (cast-unsigned 32 (lshift (cast-unsigned 32 (select 63 x)) 31)))
        (mag (logand x (cast-unsigned 64 0x7fffffffffffffff))))
    (fp-select (is-nan x) (cast-unsigned 32 0x7fc00000)
      (fp-select (>= mag (cast-unsigned 64 0x47f0000000000000))
                 (logor sign (cast-unsigned 32 0x7f800000))
        (fp-select (< mag (cast-unsigned 64 0x3810000000000000)) sign
          (fconvert :rod 32 x))))))

(defun sme-bf-mul (a b)
  "BFMul of singles: the product of two singles is exact in a double"
  (sme-bf-narrow (*. :rne (fconvert :rne 64 (sme-bf-in a)) (fconvert :rne 64 (sme-bf-in b)))))

(defun sme-bf-add (a b)
  "BFAdd of singles: rounded to odd in a double and then in a single,
   which is the sum rounded to odd once"
  (sme-bf-narrow (intrinsic 'fadd_rod_ieee754_binary_64
                            (fconvert :rne 64 (sme-bf-in a)) (fconvert :rne 64 (sme-bf-in b))
                            :result 64)))

(defun sme-bfdot-add (acc n0 n1 m0 m1)
  "BFDotAdd: ACC + (N0 * M0 + N1 * M1) of BFloat16"
  (sme-bf-add acc (sme-bf-add (sme-bf-mul (sme-bf2s n0) (sme-bf2s m0))
                              (sme-bf-mul (sme-bf2s n1) (sme-bf2s m1)))))

(defun sme-bfcvt (x)
  "the single X as a BFloat16, rounded to nearest: of a NaN quieted"
  (fp-select (is-nan x) (logor (cast-high 16 x) (cast-unsigned 16 0x40))
             (cast-high 16 (+ x (+ (cast-unsigned 32 0x7fff) (cast-unsigned 32 (select 16 x)))))))

;;; OPERATIONS OF LANES

(defun sme-vop2 (op es x y)
  "OP of the lanes of ES bits of the vectors X and Y"
  (case op
    'srshl (sve2-shift/i 'srshl es x y false (- (sve-lanes es) 1))
    'urshl (sve2-shift/i 'urshl es x y false (- (sve-lanes es) 1))
    (sve-map2 op es x y)))

(defun sme-vop1 (op es x)
  (case op
    'frinta (sve-map1 'frinta es x)
    'frintm (sve-map1 'frintm es x)
    'frintn (sve-map1 'frintn es x)
    'frintp (sve-map1 'frintp es x)
    'fcvtzs (sve-conv/i 'fcvtzs es es es x (- (sve-lanes es) 1))
    'fcvtzu (sve-conv/i 'fcvtzu es es es x (- (sve-lanes es) 1))
    'scvtf (sve-conv/i 'scvtf es es es x (- (sve-lanes es) 1))
    (sve-conv/i 'ucvtf es es es x (- (sve-lanes es) 1))))

;;; THE MULTI-VECTOR OPERATIONS OF Z REGISTERS
;;
;; What they write is computed of all that they read first.

(defun sme-results2/r (op es zdn zm single r)
  (let ((v (sme-vop2 op es (sme-z zdn r) (if single zm (sme-z zm r)))))
    (if (= r 0) v (concat v (sme-results2/r op es zdn zm single (- r 1))))))

(defun sme-multi2 (op es zdn nreg zm single)
  "OP of each register of ZDN and that of ZM, or the one ZM if SINGLE"
  (sme-check-sm)
  (let ((x (sme-results2/r op es zdn zm single (- nreg 1))))
    (sme-set-zs zdn nreg x)))

(defun sme-results1/r (op es zn r)
  (let ((v (sme-vop1 op es (sme-z zn r))))
    (if (= r 0) v (concat v (sme-results1/r op es zn (- r 1))))))

(defun sme-multi1 (op es zd nreg zn)
  (sme-check-sm)
  (let ((x (sme-results1/r op es zn (- nreg 1))))
    (sme-set-zs zd nreg x)))

(defun sme-clamp/i (op es d n m i)
  (let ((a (a64-lane d es i)) (lo (a64-lane n es i)) (hi (a64-lane m es i))
        (r (case op
             'sclamp (a64-op2 'smin (a64-op2 'smax a lo) hi)
             'uclamp (a64-op2 'umin (a64-op2 'umax a lo) hi)
             (a64-fop2 'fminnm (a64-fop2 'fmaxnm lo a) hi))))
    (if (= i 0) r (concat r (sme-clamp/i op es d n m (- i 1))))))

(defun sme-clamp-vec (op es d n m) (sme-clamp/i op es d n m (- (sve-lanes es) 1)))

(defun sme-clamps/r (op es zd zn zm r)
  (let ((v (sme-clamp-vec op es (sme-z zd r) zn zm)))
    (if (= r 0) v (concat v (sme-clamps/r op es zd zn zm (- r 1))))))

(defun sme-clamp (op es zd nreg zn zm)
  "SCLAMP, UCLAMP and FCLAMP of a list: each of ZD between ZN and ZM"
  (sme-check-sm)
  (let ((x (sme-clamps/r op es zd zn zm (- nreg 1))))
    (sme-set-zs zd nreg x)))

(defun sme-clamp1 (op es zd zn zm)
  (sme-check-sm)
  (set$ zd (sme-clamp-vec op es zd zn zm)))

(defun sme-sels/r (es pn zn zm r)
  (let ((v (sve-merge (sme-pn-part pn r) es (sme-z zn r) (sme-z zm r))))
    (if (= r 0) v (concat v (sme-sels/r es pn zn zm (- r 1))))))

(defun sme-sel (es zd nreg pn zn zm)
  (sme-check-sm)
  (let ((x (sme-sels/r es pn zn zm (- nreg 1))))
    (sme-set-zs zd nreg x)))

;; ZIP and UZP of two vectors, or of four: the elements of the
;; concatenation of the vectors, the first lowest

(defun sme-zip/i (es nreg x i)
  "the element I of the interleaving of the NREG vectors of X"
  (let ((n (sve-lanes es))
        (j (+ (* (mod i nreg) n) (/ i nreg))))
    (a64-lane x es j)))

(defun sme-uzp/i (es nreg x i)
  "the element I of the vectors of the elements of X by their index modulo NREG"
  (let ((n (sve-lanes es))
        (r (/ i n)) (e (mod i n)))
    (a64-lane x es (+ (* e nreg) r))))

(defun sme-perm/i (op es nreg x i)
  (let ((v (case op 'zip (sme-zip/i es nreg x i) (sme-uzp/i es nreg x i))))
    (if (= i 0) v (concat v (sme-perm/i op es nreg x (- i 1))))))

(defun sme-perm (op es zd nreg x)
  "of elements that NREG of are wider than a vector, undefined"
  (if (> (* nreg es) *sve-vl*) (a64-undefined)
    (prog
      (sme-check-sm)
      (let ((r (sme-perm/i op es nreg x (- (* nreg (sve-lanes es)) 1))))
        (sme-set-zs zd nreg r)))))

(defun sme-zip2 (op es zd zn zm) (sme-perm op es zd 2 (concat zm zn)))
(defun sme-zip4 (op es zd zn) (sme-perm op es zd 4 (sme-zs zn 4)))

;; SUNPK and UUNPK: each half of each source, widened

(defun sme-unpk (es signed zd nreg zn)
  (sme-check-sm)
  (let ((x (if (= nreg 2) zn (sme-zs zn 2)))
        (r (sve-unpk/i es signed x 0 (- (* nreg (sve-lanes es)) 1))))
    (sme-set-zs zd nreg r)))

;; the narrowings of two or four vectors, of their concatenation, or
;; interleaved: the element I of the vector R is at I * NREG + R

(defun sme-rshr (signed es a k)
  "A shifted right by K, rounded, of two more bits"
  (let ((w (+ es 2)))
    (arshift (+ (if signed (cast-signed w a) (cast-unsigned w a))
                (lshift (cast-unsigned w 1) (- k 1)))
             k)))

(defun sme-narrow-lane (op es w a k)
  "A of ES bits narrowed to W bits"
  (case op
    'sqcvt (a64-sat-s a w)
    'uqcvt (a64-sat-u (cast-unsigned (+ es 1) a) w)
    'sqcvtu (a64-sat-u a w)
    'sqrshr (a64-sat-s (sme-rshr true es a k) w)
    'uqrshr (a64-sat-u (sme-rshr false es a k) w)
    'sqrshru (a64-sat-u (sme-rshr true es a k) w)
    'fcvt (fconvert :rne w a)
    (sme-bfcvt a)))

(defun sme-narrow (op es zd zn nreg k interleaved)
  "the NREG vectors of ZN of ES bits narrowed to the vector ZD, of
   ES / NREG bits each, by OP of the shift K"
  (sme-check-sm)
  (let ((x (sme-zs zn nreg))
        (count (* nreg (sve-lanes es))))
    (set$ zd (sme-narrow-to es nreg op x k interleaved (- count 1)))))

(defun sme-narrow-to (es nreg op x k interleaved i)
  "the element I of the result, of ES / NREG bits: of the concatenation,
   the element I of X; interleaved, the element I / NREG of the vector
   I mod NREG"
  (let ((n (sve-lanes es))
        (j (if interleaved (+ (* (mod i nreg) n) (/ i nreg)) i))
        (r (sme-narrow-lane op es (/ es nreg) (a64-lane x es j) k)))
    (if (= i 0) r (concat r (sme-narrow-to es nreg op x k interleaved (- i 1))))))

;; LUTI2 and LUTI4: the elements of the indexes of ISIZE bits of ZN,
;; of a part of it, select those of 32 bits of ZT0, of which the low
;; ES bits are written

(defun sme-luti/e (es isize zn base e)
  (let ((index (cast-unsigned 64 (extract (- (* (+ base e) isize) 1 (- isize)) (* (+ base e) isize) zn)))
        (v (cast-low es (rshift ZT0 (* index 32)))))
    (if (= e 0) v (concat v (sme-luti/e es isize zn base (- e 1))))))

(defun sme-luti/r (es isize zn base r)
  (let ((n (sve-lanes es))
        (v (sme-luti/e es isize zn (+ base (* r n)) (- n 1))))
    (if (= r 0) v (concat v (sme-luti/r es isize zn base (- r 1))))))

(defun sme-luti (es isize zd nreg zn idx)
  (sme-check-sm-za)
  (let ((segments (/ es (* isize nreg)))
        (segment (mod idx segments))
        (base (* segment nreg (sve-lanes es)))
        (x (sme-luti/r es isize zn base (- nreg 1))))
    (if (= nreg 1) (set$ zd x) (sme-set-zs zd nreg x))))

;;; THE TILES

(defun sme-extract (es vertical zd pg t wv imm)
  "MOVA of a slice to a vector, merging"
  (sme-check-sm-za)
  (set$ zd (sve-merge pg es (sme-slice es t vertical (sme-index wv imm (sme-dim es))) zd)))

(defun sme-insert (es vertical t wv imm pg zn)
  "MOVA of a vector to a slice, merging"
  (sme-check-sm-za)
  (let ((s (sme-index wv imm (sme-dim es))))
    (sme-set-slice es t vertical s (sve-merge pg es zn (sme-slice es t vertical s)))))

(defun sme-mova-slice (es nreg wv off r)
  "the slice R of MOVA of NREG slices: Wv is rounded down to a multiple
   of NREG before the offset, which is a multiple of it, is added"
  (sme-index (logand (cast-unsigned 64 wv) (lnot (cast-unsigned 64 (- nreg 1)))) (+ (* off nreg) r) (sme-dim es)))

(defun sme-mova-get/r (es vertical t nreg wv off r)
  (let ((v (sme-slice es t vertical (sme-mova-slice es nreg wv off r))))
    (if (= r 0) v (concat v (sme-mova-get/r es vertical t nreg wv off (- r 1))))))

(defun sme-mova-to (es vertical zd nreg t wv off)
  "MOVA of NREG slices to vectors, undefined of more than the tile has"
  (when (> nreg (sme-dim es)) (a64-undefined))
  (sme-check-sm-za)
  (let ((x (sme-mova-get/r es vertical t nreg wv off (- nreg 1))))
    (sme-set-zs zd nreg x)))

(defun sme-mova-from/r (es vertical t nreg wv off x r)
  (sme-set-slice es t vertical (sme-mova-slice es nreg wv off r) (cast-low 128 (rshift x (* r 128))))
  (when (> r 0) (sme-mova-from/r es vertical t nreg wv off x (- r 1))))

(defun sme-mova-from (es vertical t nreg wv off zn)
  "MOVA of NREG vectors to slices, undefined of more than the tile has"
  (when (> nreg (sme-dim es)) (a64-undefined))
  (sme-check-sm-za)
  (let ((x (sme-zs zn nreg)))
    (sme-mova-from/r es vertical t nreg wv off x (- nreg 1))))

(defun sme-ld1 (es vertical t wv imm pg rn rm)
  "LD1 of a slice, all of whose inactive elements are zeros, as the Arm ARM
   has it: qemu 10.2 leaves those of a vertical slice after the last active
   one as they were, which its sme_ld1 doesn't clear"
  (sme-check-sm-za)
  (let ((s (sme-index wv imm (sme-dim es)))
        (a (+ rn (* rm (/ es 8))))
        (x (sve-ld1/i es es false pg a (- (sve-lanes es) 1))))
    (sme-set-slice es t vertical s x)))

(defun sme-st1 (es vertical t wv imm pg rn rm)
  (sme-check-sm-za)
  (let ((s (sme-index wv imm (sme-dim es)))
        (a (+ rn (* rm (/ es 8))))
        (x (sme-slice es t vertical s)))
    (sve-st1/i es es x pg a 0)))

(defun sme-ldr-za (wv imm rn off)
  (sme-check-za)
  (let ((r (sme-index wv imm 16))
        (x (load-bits 128 (+ rn (* (cast-unsigned 64 off) (sve-vl-bytes))))))
    (sme-set-row r x)))

(defun sme-str-za (wv imm rn off)
  (sme-check-za)
  (store-word (+ rn (* (cast-unsigned 64 off) (sve-vl-bytes))) (sme-row (sme-index wv imm 16))))

;; the outer products of a tile of singles, the element (I, J) of which
;; is of the row I of ZN and the column J of ZM

(defun sme-mop-pair-active (pn pm es k i j)
  "of the K-th element of ES bits of the row I and the column J, both active"
  (logand (sve-active pn es (+ (* i (/ 32 es)) k)) (sve-active pm es (+ (* j (/ 32 es)) k))))

(defun sme-mop-int/k (sn sm es zn zm pn pm i j k)
  "the sum of the products of the K first narrow elements of the row I and
   the column J that are active"
  (let ((g (/ 32 es))
        (x (a64-lane zn es (+ (* i g) k)))
        (y (a64-lane zm es (+ (* j g) k)))
        (p (fp-select (sme-mop-pair-active pn pm es k i j)
                      (* (if sn (cast-signed 32 x) (cast-unsigned 32 x))
                         (if sm (cast-signed 32 y) (cast-unsigned 32 y)))
                      (cast-unsigned 32 0))))
    (if (= k 0) p (+ p (sme-mop-int/k sn sm es zn zm pn pm i j (- k 1))))))

(defun sme-mop-elt (op acc pn pm zn zm i j)
  (let ((a (a64-lane zn 32 i)) (b (a64-lane zm 32 j))
        (both (logand (sve-active pn 32 i) (sve-active pm 32 j))))
    (case op
      'fmopa (fp-select both (sme-dn (sme-fma acc a b)) acc)
      'fmops (fp-select both (sme-dn (sme-fma acc (fp-neg a) b)) acc)
      'bmopa (fp-select both (+ acc (cast-unsigned 32 (sme-popcount (lnot (logxor a b))))) acc)
      'bmops (fp-select both (- acc (cast-unsigned 32 (sme-popcount (lnot (logxor a b))))) acc)
      'addha (fp-select both (+ acc b) acc)
      'addva (fp-select both (+ acc a) acc)
      'smopa (+ acc (sme-mop-int/k true true 8 zn zm pn pm i j 3))
      'smops (- acc (sme-mop-int/k true true 8 zn zm pn pm i j 3))
      'umopa (+ acc (sme-mop-int/k false false 8 zn zm pn pm i j 3))
      'umops (- acc (sme-mop-int/k false false 8 zn zm pn pm i j 3))
      'sumopa (+ acc (sme-mop-int/k true false 8 zn zm pn pm i j 3))
      'sumops (- acc (sme-mop-int/k true false 8 zn zm pn pm i j 3))
      'usmopa (+ acc (sme-mop-int/k false true 8 zn zm pn pm i j 3))
      'usmops (- acc (sme-mop-int/k false true 8 zn zm pn pm i j 3))
      'smopa2 (+ acc (sme-mop-int/k true true 16 zn zm pn pm i j 1))
      'smops2 (- acc (sme-mop-int/k true true 16 zn zm pn pm i j 1))
      'umopa2 (+ acc (sme-mop-int/k false false 16 zn zm pn pm i j 1))
      'umops2 (- acc (sme-mop-int/k false false 16 zn zm pn pm i j 1))
      'fmopal (sme-mop-wide false false acc pn pm zn zm i j)
      'fmopsl (sme-mop-wide false true acc pn pm zn zm i j)
      'bfmopa (sme-mop-wide true false acc pn pm zn zm i j)
      (sme-mop-wide true true acc pn pm zn zm i j))))

(defun sme-popcount (x)
  (if (= (word-width x) 1) (cast-unsigned 8 x)
    (let ((h (/ (word-width x) 2)))
      (+ (sme-popcount (cast-low h x)) (sme-popcount (cast-high h x))))))

(defun sme-mop-wide (bf sub acc pn pm zn zm i j)
  "FMOPA and BFMOPA of halves to singles: of the two pairs, the inactive
   halves zero, the dot product, if any pair is active, as qemu has it"
  (let ((n0 (a64-lane zn 16 (* 2 i))) (n1 (a64-lane zn 16 (+ (* 2 i) 1)))
        (m0 (a64-lane zm 16 (* 2 j))) (m1 (a64-lane zm 16 (+ (* 2 j) 1)))
        (a0 (if sub (fp-neg n0) n0)) (a1 (if sub (fp-neg n1) n1))
        (x0 (fp-select (sve-active pn 16 (* 2 i)) a0 (cast-unsigned 16 0)))
        (x1 (fp-select (sve-active pn 16 (+ (* 2 i) 1)) a1 (cast-unsigned 16 0)))
        (y0 (fp-select (sve-active pm 16 (* 2 j)) m0 (cast-unsigned 16 0)))
        (y1 (fp-select (sve-active pm 16 (+ (* 2 j) 1)) m1 (cast-unsigned 16 0)))
        (any (logor (sme-mop-pair-active pn pm 16 0 i j) (sme-mop-pair-active pn pm 16 1 i j))))
    (fp-select any
               (if bf (sme-bfdot-add acc x0 x1 y0 y1) (sme-dn (sme-fdot-add acc x0 x1 y0 y1)))
               acc)))

(defun sme-mop/j (op row pn pm zn zm i j)
  (let ((e (sme-mop-elt op (a64-lane row 32 j) pn pm zn zm i j)))
    (if (= j 0) e (concat e (sme-mop/j op row pn pm zn zm i (- j 1))))))

(defun sme-mop/i (op t pn pm zn zm i)
  (let ((r (sme-tile-row 32 t i)))
    (sme-set-row r (sme-mop/j op (sme-row r) pn pm zn zm i 3)))
  (when (> i 0) (sme-mop/i op t pn pm zn zm (- i 1))))

(defun sme-mop (op t pn pm zn zm)
  "an outer product, or ADDHA or ADDVA, of the tile T of singles"
  (sme-check-sm-za)
  (sme-mop/i op t pn pm zn zm 3))

;;; THE VECTORS OF ZA OF SME2
;;
;; M is a list of NREG registers, if MFORM is 'multi, the one register
;; that is with each of them, if 'single, or that one with the element
;; IDX of GS bits of each of its segments of 128 bits repeated, if
;; 'index.

(defun sme-mvec (mform zm r gs idx)
  (case mform
    'multi (sme-z zm r)
    'single zm
    (replicate (a64-lane zm gs idx) (/ 128 gs))))

(defun sme-za-lane (op es acc n m)
  "of a lane of ES bits of a vector of ZA: ACC, N and M of the same width"
  (case op
    'add (+ acc n)
    'sub (- acc n)
    'fadd (sme-dn (a64-fop2 'fadd acc n))
    'fsub (sme-dn (a64-fop2 'fsub acc n))
    'fmla (sme-dn (sme-fma acc n m))
    'fmls (sme-dn (sme-fma acc (fp-neg n) m))
    'addr (+ n m)
    (- n m)))

(defun sme-za-vec/i (op es acc n m i)
  (let ((r (sme-za-lane op es (a64-lane acc es i) (a64-lane n es i) (a64-lane m es i))))
    (if (= i 0) r (concat r (sme-za-vec/i op es acc n m (- i 1))))))

(defun sme-za-op/r (op es base nreg zn zm mform gs idx r)
  (let ((row (sme-vg-row base nreg r 0)))
    (sme-set-row row (sme-za-vec/i op es (sme-row row) (sme-z zn r) (sme-mvec mform zm r gs idx)
                                   (- (sve-lanes es) 1))))
  (when (> r 0) (sme-za-op/r op es base nreg zn zm mform gs idx (- r 1))))

(defun sme-za-op (op es wv off nreg zn zm mform idx)
  "ADD, SUB, FADD and FSUB of the vectors of ZA and those of ZN, or ADD and
   SUB of those of ZN and ZM to them, or FMLA and FMLS of them"
  (sme-check-sm-za)
  (let ((base (sme-vg-base wv off nreg 1)))
    (sme-za-op/r op es base nreg zn zm mform es idx (- nreg 1))))

;; the dot products: of each lane of 32 bits, the sum of the products of
;; the narrow elements in it

(defun sme-idot/k (sn sm es n m e k)
  (let ((g (/ 32 es))
        (x (a64-lane n es (+ (* e g) k)))
        (y (a64-lane m es (+ (* e g) k)))
        (p (* (if sn (cast-signed 32 x) (cast-unsigned 32 x))
              (if sm (cast-signed 32 y) (cast-unsigned 32 y)))))
    (if (= k 0) p (+ p (sme-idot/k sn sm es n m e (- k 1))))))

(defun sme-dot-lane (op acc n m e)
  "the lane E of the dot product OP of N and M added to ACC"
  (case op
    'sdot (+ acc (sme-idot/k true true 8 n m e 3))
    'udot (+ acc (sme-idot/k false false 8 n m e 3))
    'usdot (+ acc (sme-idot/k false true 8 n m e 3))
    'sudot (+ acc (sme-idot/k true false 8 n m e 3))
    'sdot2 (+ acc (sme-idot/k true true 16 n m e 1))
    'udot2 (+ acc (sme-idot/k false false 16 n m e 1))
    'fdot (sme-fdot-add acc (a64-lane n 16 (* 2 e)) (a64-lane n 16 (+ (* 2 e) 1))
                        (a64-lane m 16 (* 2 e)) (a64-lane m 16 (+ (* 2 e) 1)))
    'fdotza (sme-dn (sme-fdot-add acc (a64-lane n 16 (* 2 e)) (a64-lane n 16 (+ (* 2 e) 1))
                                  (a64-lane m 16 (* 2 e)) (a64-lane m 16 (+ (* 2 e) 1))))
    (sme-bfdot-add acc (a64-lane n 16 (* 2 e)) (a64-lane n 16 (+ (* 2 e) 1))
                   (a64-lane m 16 (* 2 e)) (a64-lane m 16 (+ (* 2 e) 1)))))

(defun sme-dot/e (op acc n m e)
  (let ((r (sme-dot-lane op (a64-lane acc 32 e) n m e)))
    (if (= e 0) r (concat r (sme-dot/e op acc n m (- e 1))))))

(defun sme-dot-vec (op acc n m) (sme-dot/e op acc n m 3))

(defun sme-za-dot/r (op base nreg zn zm mform idx r)
  (let ((row (sme-vg-row base nreg r 0))
        (x (sme-dot-vec op (sme-row row) (sme-z zn r) (sme-mvec mform zm r 32 idx))))
    (sme-set-row row x))
  (when (> r 0) (sme-za-dot/r op base nreg zn zm mform idx (- r 1))))

(defun sme-za-dot (op wv off nreg zn zm mform idx)
  "a dot product to ZA, which of floating point gives the default NaN"
  (sme-check-sm-za)
  (sme-za-dot/r (case op 'fdot 'fdotza op) (sme-vg-base wv off nreg 1) nreg zn zm mform idx (- nreg 1)))

;; the vertical dot products: the lane E of the vector R of the group is
;; of the elements G * E + R of the G registers of ZN

(defun sme-vdot-n/k (es zn e r k)
  "the narrow elements of the lane E of the vertical operand, the first lowest"
  (let ((g (/ 32 es))
        (x (a64-lane (sme-z zn k) es (+ (* g e) r))))
    (if (= k 0) x (concat x (sme-vdot-n/k es zn e r (- k 1))))))

(defun sme-vdot/e (op es acc zn m r e)
  (let ((g (/ 32 es))
        (n (sme-vdot-n/k es zn e r (- g 1)))
        (x (sme-dot-lane op (a64-lane acc 32 e) n (a64-lane m 32 e) 0)))
    (if (= e 0) x (concat x (sme-vdot/e op es acc zn m r (- e 1))))))

(defun sme-za-vdot/r (op es base nreg zn m r)
  (let ((row (sme-vg-row base nreg r 0))
        (x (sme-vdot/e op es (sme-row row) zn m r 3)))
    (sme-set-row row x))
  (when (> r 0) (sme-za-vdot/r op es base nreg zn m (- r 1))))

(defun sme-za-vdot (op es wv off nreg zn zm idx)
  (sme-check-sm-za)
  (sme-za-vdot/r (case op 'fdot 'fdotza op) es (sme-vg-base wv off nreg 1) nreg zn (sme-mvec 'index zm 0 32 idx) (- nreg 1)))

;; the long multiply-adds: the K vectors of a group, the vector I of which
;; has of its lane E the product of the elements K * E + I

(defun sme-long-lane (op acc x y)
  (case op
    'smlal (+ acc (* (cast-signed 32 x) (cast-signed 32 y)))
    'smlsl (- acc (* (cast-signed 32 x) (cast-signed 32 y)))
    'umlal (+ acc (* (cast-unsigned 32 x) (cast-unsigned 32 y)))
    'umlsl (- acc (* (cast-unsigned 32 x) (cast-unsigned 32 y)))
    'usmlal (+ acc (* (cast-unsigned 32 x) (cast-signed 32 y)))
    'sumlal (+ acc (* (cast-signed 32 x) (cast-unsigned 32 y)))
    'fmlal (sme-dn (sme-fma acc (sme-h2s x) (sme-h2s y)))
    'fmlsl (sme-dn (sme-fma acc (sme-h2s (fp-neg x)) (sme-h2s y)))
    'bfmlal (sme-dn (sme-fma acc (sme-bf2s x) (sme-bf2s y)))
    (sme-dn (sme-fma acc (sme-bf2s (fp-neg x)) (sme-bf2s y)))))

(defun sme-long/e (op es k acc n m i e)
  (let ((r (sme-long-lane op (a64-lane acc 32 e) (a64-lane n es (+ (* k e) i)) (a64-lane m es (+ (* k e) i)))))
    (if (= e 0) r (concat r (sme-long/e op es k acc n m i (- e 1))))))

(defun sme-za-long/i (op es k base nreg n m r i)
  (let ((row (sme-vg-row base nreg r i)))
    (sme-set-row row (sme-long/e op es k (sme-row row) n m i 3)))
  (when (> i 0) (sme-za-long/i op es k base nreg n m r (- i 1))))

(defun sme-za-long/r (op es k base nreg zn zm mform idx r)
  (sme-za-long/i op es k base nreg (sme-z zn r) (sme-mvec mform zm r es idx) r (- k 1))
  (when (> r 0) (sme-za-long/r op es k base nreg zn zm mform idx (- r 1))))

(defun sme-za-long (op es wv off nreg zn zm mform idx)
  "SMLAL and its kin of elements of ES bits to singles, of the vectors of ZA
   of groups of 32 / ES consecutive vectors"
  (sme-check-sm-za)
  (let ((k (/ 32 es)))
    (sme-za-long/r op es k (sme-vg-base wv off nreg k) nreg zn zm mform idx (- nreg 1))))

;; MOVA of the vectors of ZA

(defun sme-mova-array-get/r (base nreg r)
  (let ((v (sme-row (sme-vg-row base nreg r 0))))
    (if (= r 0) v (concat v (sme-mova-array-get/r base nreg (- r 1))))))

(defun sme-mova-array-to (zd nreg wv off)
  (sme-check-sm-za)
  (let ((x (sme-mova-array-get/r (sme-vg-base wv off nreg 1) nreg (- nreg 1))))
    (sme-set-zs zd nreg x)))

(defun sme-mova-array-from/r (base nreg x r)
  (sme-set-row (sme-vg-row base nreg r 0) (cast-low 128 (rshift x (* r 128))))
  (when (> r 0) (sme-mova-array-from/r base nreg x (- r 1))))

(defun sme-mova-array-from (nreg wv off zn)
  (sme-check-sm-za)
  (let ((x (sme-zs zn nreg)))
    (sme-mova-array-from/r (sme-vg-base wv off nreg 1) nreg x (- nreg 1))))

;;; THE LOADS AND THE STORES OF MULTIPLE VECTORS
;;
;; The elements of the vectors are consecutive in memory, of a list of
;; consecutive registers or a strided one, and those of the vector R are
;; active by the part R of the predicate as a counter.

(defun sme-ldn/r (es zl pn a r)
  (let ((v (sve-ld1/i es es false (sme-pn-part pn r) (+ a (* r (sve-vl-bytes))) (- (sve-lanes es) 1))))
    (if (= r 0) v (concat v (sme-ldn/r es zl pn a (- r 1))))))

(defun sme-ldn (es zl nreg pn rn offset)
  (sme-check-sm)
  (let ((a (+ rn offset))
        (x (sme-ldn/r es zl pn a (- nreg 1))))
    (sme-set-zs zl nreg x)))

(defun sme-stn/r (es zl pn a r)
  (sve-st1/i es es (sme-z zl r) (sme-pn-part pn r) (+ a (* r (sve-vl-bytes))) 0)
  (when (> r 0) (sme-stn/r es zl pn a (- r 1))))

(defun sme-stn (es zl nreg pn rn offset)
  (sme-check-sm)
  (let ((a (+ rn offset)))
    (sme-stn/r es zl pn a (- nreg 1))))

(defun sme-ld-scalar (es rm) (* rm (/ es 8)))
(defun sme-ld-imm (nreg imm) (* (cast-signed 64 (cast-low 4 imm)) (* nreg (sve-vl-bytes))))

;;; PREDICATES

(defun sme-psel (pd pn pm es wv imm)
  "PSEL: PN, if the element (Wv + IMM) mod the elements of PM is active, else none"
  (sme-check-sm)
  (let ((n (sve-lanes es))
        (i (sme-index wv imm n))
        (bit (select 0 (rshift pm (* i (/ es 8))))))
    (set$ pd (fp-select bit pn (cast-unsigned 16 0)))))

(defun sme-pext (es pd pn k)
  (sme-check-sm)
  (set$ pd (logand (sve-lsb es) (sme-pn-part pn k))))

(defun sme-pext2 (es pl pn k)
  "PEXT of a pair, whose first may be the counter itself, which is read first"
  (sme-check-sm)
  (let ((x (cast-low 32 (rshift (sme-pn-expand pn) (* k 32)))))
    (set$ (sme-nth pl 0) (logand (sve-lsb es) (cast-low 16 x)))
    (set$ (sme-nth pl 1) (logand (sve-lsb es) (cast-high 16 x)))))

(defun sme-ptrue-c (es pd)
  (sme-check-sm)
  (set$ pd (logor (cast-unsigned 16 0x8000) (cast-unsigned 16 (/ es 8)))))

(defun sme-cntp-c (es rd pn nvl)
  "CNTP of a predicate as a counter, of NVL vectors, of elements of ES bits"
  (sme-check-sm)
  (let ((x (sme-pn-expand pn))
        (n (sme-pn-elements es nvl))
        (all (cast-low 64 (- (lshift (cast-unsigned 128 1) (* n (/ es 8))) (cast-unsigned 128 1))))
        (bits (logand (logand x all) (replicate (cast-unsigned (/ es 8) 1) (/ 64 (/ es 8))))))
    (set$ rd (cast-unsigned 64 (sme-popcount bits)))))

;;; WHAT SME2 SHARES WITH SVE2.1, AND OF SME

(defun sme-revd (zd pg zn)
  "REVD: the doublewords of each quadword swapped"
  (sme-check-sm)
  (set$ zd (sve-merge pg 128 (concat (cast-low 64 zn) (cast-high 64 zn)) zd)))

(defun sme-zdot (op zda zn zm mform idx)
  "a dot product of the lanes of 32 bits of a Z register"
  (sme-check-sm)
  (set$ zda (sme-dot-vec op zda zn (sme-mvec mform zm 0 32 idx))))

(defun sme-bfmlsl (zda zn zm part mform idx)
  "BFMLSLB and BFMLSLT: the products of the even or odd BFloat16 elements
   subtracted from the singles, fused"
  (sme-check-sm)
  (set$ zda (sme-bfmlal/e true zda zn (sme-mvec mform zm 0 16 idx) part 3)))

;;; BFLOAT16 OF ADVANCED SIMD AND SVE

(defun sme-bfmlal/e (sub acc n m part e)
  (let ((x (a64-lane n 16 (+ (* 2 e) part)))
        (r (sme-fma (a64-lane acc 32 e) (sme-bf2s (if sub (fp-neg x) x))
                    (sme-bf2s (a64-lane m 16 (+ (* 2 e) part))))))
    (if (= e 0) r (concat r (sme-bfmlal/e sub acc n m part (- e 1))))))

(defun sme-bfmlal (zda zn zm part mform idx)
  "BFMLALB and BFMLALT, of Advanced SIMD and SVE"
  (set$ zda (sme-bfmlal/e false zda zn (sme-mvec mform zm 0 16 idx) part 3)))

(defun sme-bfdot/e (acc n m e)
  (let ((r (sme-dot-lane 'bfdot (a64-lane acc 32 e) n m e)))
    (if (= e 0) r (concat r (sme-bfdot/e acc n m (- e 1))))))

(defun sme-bfdot (zda zn zm lanes mform idx)
  "BFDOT of the LANES lanes of ZDA"
  (let ((r (sme-bfdot/e zda zn (sme-mvec mform zm 0 32 idx) (- lanes 1))))
    (if (= lanes 4) (set$ zda r) (a64-setd zda r))))

(defun sme-bfmmla-elt (acc n m i j)
  (let ((a (a64-lane acc 32 (+ (* 2 i) j)))
        (s (sme-bfdot-add a (a64-lane n 16 (* 4 i)) (a64-lane n 16 (+ (* 4 i) 1))
                          (a64-lane m 16 (* 4 j)) (a64-lane m 16 (+ (* 4 j) 1)))))
    (sme-bfdot-add s (a64-lane n 16 (+ (* 4 i) 2)) (a64-lane n 16 (+ (* 4 i) 3))
                   (a64-lane m 16 (+ (* 4 j) 2)) (a64-lane m 16 (+ (* 4 j) 3)))))

(defun sme-bfmmla (zda zn zm)
  "BFMMLA: the matrix of 2 by 2 singles plus the product of the matrices of
   2 by 4 of ZN and 4 by 2 of ZM, the rows of which ZM has"
  (set$ zda (concat (sme-bfmmla-elt zda zn zm 1 1) (sme-bfmmla-elt zda zn zm 1 0)
                    (sme-bfmmla-elt zda zn zm 0 1) (sme-bfmmla-elt zda zn zm 0 0))))

(defun sme-bfcvt/e (x e)
  (let ((r (sme-bfcvt (a64-lane x 32 e))))
    (if (= e 0) r (concat r (sme-bfcvt/e x (- e 1))))))

(defun sme-bfcvt-sve/e (old x odd e)
  (let ((r (sme-bfcvt (a64-lane x 32 e)))
        (pair (if odd (concat r (a64-lane old 16 (* 2 e))) (concat (cast-unsigned 16 0) r))))
    (if (= e 0) pair (concat pair (sme-bfcvt-sve/e old x odd (- e 1))))))

(defun sme-bfcvt-sve (zd pg zn odd)
  "BFCVT and BFCVTNT of SVE, merging by the singles"
  (set$ zd (sve-merge pg 32 (sme-bfcvt-sve/e zd zn odd 3) zd)))

;;; THE REST OF THE STATE

(defun sme-rdsvl (rd imm) (set$ rd (* (cast-signed 64 (cast-low 6 imm)) (sve-vl-bytes))))
(defun sme-addsvl (rd rn imm) (set$ rd (+ rn (* (cast-signed 64 (cast-low 6 imm)) (sve-vl-bytes)))))
(defun sme-addspl (rd rn imm) (set$ rd (+ rn (* (cast-signed 64 (cast-low 6 imm)) (/ (sve-pl) 8)))))

