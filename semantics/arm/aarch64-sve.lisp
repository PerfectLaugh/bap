(declare (context (target arm-family)
                  (bits 64)))

(in-package aarch64)

(require bits)
(require arm-bits)
(require arm-float)
(require aarch64-helper)
(require aarch64-simd)
(require aarch64-float)

;;; SCALABLE VECTOR EXTENSION (SVE)
;;
;; The vector length is *sve-vl*, in bits, and the lanes are computed
;; from it. Code that is vector-length agnostic, which asks RDVL or CNT*
;; and loops with WHILE*, runs correctly at any length, so here too.
;; Code that assumes a longer vector than this one does not. To change
;; the length, change *sve-vl*, and in aarch64SveRegister of
;; Bap/Target/LLVMLift.lean the widths of Zn, Pn and FFR. A length above
;; 128 bits needs Zn apart from Qn there, as a base of its own, and
;; every write of a Vn to clear the bits above it, and to be a power of
;; two for the reductions to be the Reduce of the Arm ARM.
;;
;; At 128 bits Zn is Vn with nothing above it: both are the variable Qn,
;; so a write of a Zn is a write of the whole of Vn, and a write of a Vn
;; by Advanced SIMD leaves no bits of Zn behind. Pn and FFR have a bit
;; for each byte of a vector, an element of ES bits is active if the
;; lowest of its ES / 8 bits is set, as ElemP of the Arm ARM.
;;
;; A lane function is applied to all the lanes, the results of the
;; inactive ones are dropped by a mask, so the lanes are computed as
;; aarch64-simd.lisp does, statically unfolded. The loads and the stores
;; are the exception: they access only what is active, by a branch, as an
;; inactive element must not fault.
;;
;; What is not modeled:
;; - FPCR and FPSR, as in aarch64-float.lisp: the rounding is to nearest
;;   with ties to even, and FZ, DN, AHP and the exception flags are
;;   ignored. The operations of the inactive floating-point lanes are
;;   computed too and dropped, which would only be seen in those flags.
;; - Faults of memory, which a program in BIL doesn't have. LDFF1 and
;;   LDNF1 load all their active elements and leave FFR as it is, which
;;   is what an access that doesn't fault does. An element at or after
;;   a clear bit of FFR is CONSTRAINED UNPREDICTABLE in the Arm ARM: its
;;   data, zero, or its old value; this is the first of those.
;; - The ordering of LDNT1 and STNT1, which are as LD1 and ST1, and
;;   the alignment checks.
;; - MOVPRFX is the move it is on its own. That it combines with the next
;;   instruction is only a hint to an implementation.
;; - The tables of FEXPA and FTMAD and the estimates of FRECPE, FRSQRTE,
;;   and FRECPX and the scaling of FSCALE are intrinsics named after them.

(defparameter *sve-vl* 128)

(defun sve-pl () (/ *sve-vl* 8))
(defun sve-vl-bytes () (/ *sve-vl* 8))
(defun sve-lanes (es) (/ *sve-vl* es))
(defun sve-zeros () (cast-unsigned *sve-vl* 0))

;; the predicates

(defun sve-active (pg es i)
  "(sve-active PG ES I) is the bit of the element I of ES bits of PG"
  (select (* i (/ es 8)) pg))

(defun sve-lsb (es)
  "the predicate with all the elements of ES bits active, and only the
   lowest bit of each one set"
  (replicate (cast-unsigned (/ es 8) 1) (sve-lanes es)))

(defun sve-pbit (c es)
  "the bits of a predicate of an element of ES bits, whose activity is C"
  (cast-unsigned (/ es 8) c))

(defun sve-mask/lanes (pg es i)
  (if (= i 0) (a64-mask (sve-active pg es 0) es)
    (concat (a64-mask (sve-active pg es i) es)
            (sve-mask/lanes pg es (- i 1)))))

(defun sve-mask (pg es)
  "the vector with ones in the active elements of ES bits of PG"
  (sve-mask/lanes pg es (- (sve-lanes es) 1)))

(defun sve-merge (pg es new old)
  (let ((m (sve-mask pg es)))
    (logor (logand m new) (logand (lnot m) old))))

(defun sve-zeroing (pg es new) (logand (sve-mask pg es) new))

(defun sve-smear/k (x k)
  (if (>= k (word-width x)) x
    (let ((s (logor x (rshift x k)))) (sve-smear/k s (* 2 k)))))

(defun sve-smear (x)
  "X with ones from its highest set bit down"
  (sve-smear/k x 1))

(defun sve-lowest (x) (logand x (neg x)))

(defun sve-highest (x)
  (let ((s (sve-smear x))) (logxor s (rshift s 1))))

(defun sve-first-active (mask x es)
  "FirstActive: the element of X at the first active element of MASK"
  (non-zero (logand (sve-lowest (logand mask (sve-lsb es))) x)))

(defun sve-last-active (mask x es)
  "LastActive: the element of X at the last active element of MASK"
  (non-zero (logand (sve-highest (logand mask (sve-lsb es))) x)))

(defun sve-flags (mask x es)
  "sets NZCV to PredTest(MASK, X, ES), which must be frozen"
  (set NF (sve-first-active mask x es))
  (set ZF (is-zero (logand mask x (sve-lsb es))))
  (set CF (lnot (sve-last-active mask x es)))
  (set VF (cast-unsigned 1 0)))

(defun sve-setp/flags (pd mask x es)
  "sets PD to X and the flags, MASK can be PD itself"
  (let ((m mask) (r x))
    (set$ pd r)
    (sve-flags m r es)))

(defun sve-any (pg es) (non-zero (logand pg (sve-lsb es))))

(defun sve-last-index (pg es i)
  "the index of the last active element of PG from the element I, or -1"
  (if (= i 0)
      (fp-select (sve-active pg es 0) (cast-unsigned 64 0) (lnot (cast-unsigned 64 0)))
    (fp-select (sve-active pg es i) (cast-unsigned 64 i) (sve-last-index pg es (- i 1)))))

(defun sve-first-index (pg es i)
  "the index of the first active element of PG from the element I, or 0"
  (if (= i (- (sve-lanes es) 1))
      (fp-select (sve-active pg es i) (cast-unsigned 64 i) (cast-unsigned 64 0))
    (fp-select (sve-active pg es i) (cast-unsigned 64 i) (sve-first-index pg es (+ i 1)))))

(defun sve-count-active (mask x es i)
  "how many of the elements from I down to 0 are active in both"
  (let ((c (cast-unsigned 64 (logand (sve-active mask es i) (sve-active x es i)))))
    (if (= i 0) c (+ c (sve-count-active mask x es (- i 1))))))

(defun sve-cntp (pg pn es) (sve-count-active pg pn es (- (sve-lanes es) 1)))
(defun sve-popcnt (pg es) (sve-cntp pg pg es))

;; DecodePredCount
(defun sve-pow2/k (k n) (if (> (* 2 k) n) k (sve-pow2/k (* 2 k) n)))
(defun sve-vlk (k n) (if (>= n k) k 0))

(defun sve-count (pat es)
  "the number of elements of ES bits of the pattern PAT, which is static"
  (let ((n (sve-lanes es)))
    (case pat
      0 (sve-pow2/k 1 n)
      1 (sve-vlk 1 n)
      2 (sve-vlk 2 n)
      3 (sve-vlk 3 n)
      4 (sve-vlk 4 n)
      5 (sve-vlk 5 n)
      6 (sve-vlk 6 n)
      7 (sve-vlk 7 n)
      8 (sve-vlk 8 n)
      9 (sve-vlk 16 n)
      10 (sve-vlk 32 n)
      11 (sve-vlk 64 n)
      12 (sve-vlk 128 n)
      13 (sve-vlk 256 n)
      29 (- n (mod n 4))
      30 (- n (mod n 3))
      31 n
      0)))

(defun sve-ptrue-bits (es count)
  (let ((pl (sve-pl)))
    (logand (sve-lsb es)
            (cast-low pl (- (lshift (cast-unsigned (+ pl 1) 1) (* count (/ es 8)))
                            (cast-unsigned (+ pl 1) 1))))))

(defun sve-ptrue (es pd pat) (set$ pd (sve-ptrue-bits es (sve-count pat es))))
(defun sve-ptrues (es pd pat)
  (let ((r (sve-ptrue-bits es (sve-count pat es))))
    (set$ pd r)
    (sve-flags r r es)))

(defun sve-while-cond (op a b)
  (case op
    'lt (s< a b)
    'le (s<= a b)
    'lo (< a b)
    (<= a b)))

(defun sve-while/i (op es a b i last)
  (let ((c (logand last (sve-while-cond op (+ a (cast-unsigned (word-width a) i)) b))))
    (if (= i (- (sve-lanes es) 1))
        (sve-pbit c es)
      (concat (sve-while/i op es a b (+ i 1) c) (sve-pbit c es)))))

(defun sve-while (op es bits pd rn rm)
  "WHILE*: operand 1 is incremented in BITS and wraps, as the Arm ARM says,
   and WZR, which is the register of 64 bits here, is cut to BITS"
  (let ((r (sve-while/i op es (cast-low bits rn) (cast-low bits rm) 0 (cast-unsigned 1 1))))
    (set$ pd r)
    (sve-flags (lnot (cast-unsigned (sve-pl) 0)) r es)))

(defun sve-plog (op pg pn pm)
  (let ((g pg))
    (logand g (case op
                'and (logand pn pm)
                'bic (logand pn (lnot pm))
                'eor (logxor pn pm)
                'nand (lnot (logand pn pm))
                'nor (lnot (logor pn pm))
                'orn (logor pn (lnot pm))
                (logor pn pm)))))

(defun sve-psel (pg pn pm)
  (logor (logand pg pn) (logand (lnot pg) pm)))

(defun sve-pnext (es pdn pg)
  (let ((m (logand pg (sve-lsb es)))
        (above (lnot (sve-smear (logand pdn (sve-lsb es)))))
        (r (sve-lowest (logand m above))))
    (set$ pdn r)
    (sve-flags m r es)))

(defun sve-pfirst (pdn pg)
  (let ((m pg)
        (r (logor pdn (sve-lowest m))))
    (set$ pdn r)
    (sve-flags m r 8)))

;; the breaks, of one bit a byte: UPTO are the bits up to the first active
;; bit of PN, without it, and with it if INCLUSIVE
(defun sve-break-bits (pg pn inclusive)
  (let ((low (sve-lowest (logand pg pn)))
        (below (- low (a64-one low))))
    (logand pg (if inclusive (logor below low) below))))

(defun sve-brk-m (pd pg pn inclusive)
  (set$ pd (logor (sve-break-bits pg pn inclusive) (logand (lnot pg) pd))))

(defun sve-brk-z (pd pg pn inclusive) (set$ pd (sve-break-bits pg pn inclusive)))

(defun sve-brks (pd pg pn inclusive)
  (sve-setp/flags pd pg (sve-break-bits pg pn inclusive) 8))

(defun sve-brkn (pdm pg pn)
  (fp-select (sve-last-active pg pn 8) pdm (cast-unsigned (sve-pl) 0)))

(defun sve-brkp (pg pn pm inclusive)
  (fp-select (sve-last-active pg pn 8)
             (sve-break-bits pg pm inclusive)
             (cast-unsigned (sve-pl) 0)))

(defun sve-rev/i (es x i)
  "the lanes of X in the reverse order, of the lane I down to 0"
  (let ((j (- (/ (word-width x) es) i 1)))
    (if (= i 0) (a64-lane x es j)
      (concat (a64-lane x es j) (sve-rev/i es x (- i 1))))))

(defun sve-rev (es x) (sve-rev/i es x (- (/ (word-width x) es) 1)))

(defun sve-punpk/i (pn k i)
  (let ((b (cast-unsigned 2 (select (+ k i) pn))))
    (if (= i 0) b (concat b (sve-punpk/i pn k (- i 1))))))

(defun sve-punpk (pd pn hi)
  (let ((half (/ (sve-pl) 2)))
    (set$ pd (sve-punpk/i pn (if hi half 0) (- half 1)))))

(defun sve-ppermute (op es pd pn pm)
  (let ((e (/ es 8)) (n (/ (sve-pl) e)))
    (set$ pd (a64-permute op e n (- n 1) (concat pm pn)))))

(defun sve-permute (op es zd zn zm)
  (let ((n (sve-lanes es)))
    (set$ zd (a64-permute op es n (- n 1) (concat zm zn)))))

(defun sve-cterm (eq bits rn rm)
  (let ((a (cast-low bits rn))
        (b (cast-low bits rm))
        (term (if eq (= a b) (/= a b))))
    (set NF term)
    (set VF (logand (lnot term) (lnot CF)))))

;; the operations of the lanes, in addition to those of aarch64-simd.lisp

(defun sve-fintrinsic (name a)
  (intrinsic (symbol-concat name 'ieee754_binary (a64-fsize-symbol a) :sep '_)
             a :result (word-width a)))

(defun sve-big-shift (s es)
  "whether the amount S is out of the range of an element of ES bits"
  (< (cast-unsigned (word-width s) (- es 1)) s))

(defun sve-amount (s es)
  "the amount S in ES bits, or 0 if it is out of the range"
  (fp-select (sve-big-shift s es) (cast-unsigned es 0) (cast-low es s)))

(defun sve-asr (a s)
  (let ((es (word-width a)))
    (arshift a (fp-select (sve-big-shift s es)
                          (cast-unsigned es (- es 1))
                          (cast-low es s)))))

(defun sve-lsr (a s)
  (let ((es (word-width a)))
    (fp-select (sve-big-shift s es) (cast-unsigned es 0)
               (rshift a (sve-amount s es)))))

(defun sve-lsl (a s)
  (let ((es (word-width a)))
    (fp-select (sve-big-shift s es) (cast-unsigned es 0)
               (lshift a (sve-amount s es)))))

(defun sve-sdiv (a b)
  (fp-select (is-zero b) (cast-unsigned (word-width a) 0) (s/ a b)))

(defun sve-udiv (a b)
  (fp-select (is-zero b) (cast-unsigned (word-width a) 0) (/ a b)))

(defun sve-asrd (a k)
  "ASRD: the division by 2^K, which rounds toward zero"
  (let ((x (a64-sx1 a))
        (m (- (lshift (a64-one x) k) (a64-one x))))
    (cast-low (word-width a)
              (arshift (+ x (fp-select (msb a) m (a64-zero x))) k))))

(defun sve-ftsmul (a b)
  "FPTrigSMul: the sign of the square is the bit 0 of B, unless it is a NaN"
  (let ((r (a64-fop2 'fmul a a)))
    (fp-select (is-nan r) r
               (concat (select 0 b) (cast-low (- (word-width r) 1) r)))))

(defun sve-ftssel (a b)
  "FTSSEL: the bit 0 of B selects 1.0, the bit 1 negates the result"
  (let ((r (fp-select (select 0 b) (a64-fone a) a)))
    (fp-select (select 1 b) (fp-neg r) r)))

(defun sve-op1 (op a)
  (case op
    'not (lnot a)
    'cnot (cast-unsigned (word-width a) (is-zero a))
    'sxtb (cast-signed (word-width a) (cast-low 8 a))
    'sxth (cast-signed (word-width a) (cast-low 16 a))
    'sxtw (cast-signed (word-width a) (cast-low 32 a))
    'uxtb (cast-unsigned (word-width a) (cast-low 8 a))
    'uxth (cast-unsigned (word-width a) (cast-low 16 a))
    'uxtw (cast-unsigned (word-width a) (cast-low 32 a))
    'revb (sve-rev 8 a)
    'revh (sve-rev 16 a)
    'revw (sve-rev 32 a)
    'frintx (a64-frint 'n a)
    'frinti (a64-frint 'n a)
    'frecpx (sve-fintrinsic 'frecpx a)
    'frecpe (sve-fintrinsic 'frecpe a)
    'frsqrte (sve-fintrinsic 'frsqrte a)
    'fexpa (sve-fintrinsic 'fexpa a)
    (a64-op1 op a)))

(defun sve-op2 (op a b)
  (case op
    'and (logand a b)
    'orr (logor a b)
    'eor (logxor a b)
    'bic (logand a (lnot b))
    'subr (- b a)
    'smulh (cast-high (word-width a) (* (a64-sx2 a) (a64-sx2 b)))
    'umulh (cast-high (word-width a) (* (a64-ux2 a) (a64-ux2 b)))
    'sdiv (sve-sdiv a b)
    'udiv (sve-udiv a b)
    'sdivr (sve-sdiv b a)
    'udivr (sve-udiv b a)
    'asr (sve-asr a b)
    'lsr (sve-lsr a b)
    'lsl (sve-lsl a b)
    'asrr (sve-asr b a)
    'lsrr (sve-lsr b a)
    'lslr (sve-lsl b a)
    'asrd (sve-asrd a b)
    'sqaddu (a64-sat-s (+ (cast-signed (+ (word-width a) 2) a)
                          (cast-unsigned (+ (word-width a) 2) b))
                       (word-width a))
    'sqsubu (a64-sat-s (- (cast-signed (+ (word-width a) 2) a)
                          (cast-unsigned (+ (word-width a) 2) b))
                       (word-width a))
    'fsubr (a64-fop2 'fsub b a)
    'fdivr (a64-fop2 'fdiv b a)
    'fscale (intrinsic (symbol-concat 'fscale 'rne 'ieee754_binary
                                      (a64-fsize-symbol a) :sep '_)
                       a b :result (word-width a))
    'ftsmul (sve-ftsmul a b)
    'ftssel (sve-ftssel a b)
    (a64-op2 op a b)))

(defun sve-op3 (op a b c)
  (case op
    'mla (+ a (* b c))
    'mls (- a (* b c))
    'fmla (a64-muladd a b c)
    'fmls (a64-muladd a (fp-neg b) c)
    'fnmla (a64-muladd (fp-neg a) (fp-neg b) c)
    'fnmls (a64-muladd (fp-neg a) b c)
    a))

;; the maps of the lanes of the whole of a vector

(defun sve-map1/i (op es x i)
  (let ((r (sve-op1 op (a64-lane x es i))))
    (if (= i 0) r (concat r (sve-map1/i op es x (- i 1))))))

(defun sve-map2/i (op es x y i)
  (let ((r (sve-op2 op (a64-lane x es i) (a64-lane y es i))))
    (if (= i 0) r (concat r (sve-map2/i op es x y (- i 1))))))

(defun sve-map3/i (op es x y z i)
  (let ((r (sve-op3 op (a64-lane x es i) (a64-lane y es i) (a64-lane z es i))))
    (if (= i 0) r (concat r (sve-map3/i op es x y z (- i 1))))))

(defun sve-mapk/i (op es x k i)
  (let ((r (sve-op2 op (a64-lane x es i) k)))
    (if (= i 0) r (concat r (sve-mapk/i op es x k (- i 1))))))

(defun sve-mapw/i (op es x y i)
  (let ((r (sve-op2 op (a64-lane x es i) (a64-lane y 64 (/ (* i es) 64)))))
    (if (= i 0) r (concat r (sve-mapw/i op es x y (- i 1))))))

(defun sve-map1 (op es x) (sve-map1/i op es x (- (sve-lanes es) 1)))
(defun sve-map2 (op es x y) (sve-map2/i op es x y (- (sve-lanes es) 1)))
(defun sve-map3 (op es x y z) (sve-map3/i op es x y z (- (sve-lanes es) 1)))
(defun sve-mapk (op es x k) (sve-mapk/i op es x k (- (sve-lanes es) 1)))
(defun sve-mapw (op es x y) (sve-mapw/i op es x y (- (sve-lanes es) 1)))

(defun sve-un (op es zd pg zn) (set$ zd (sve-merge pg es (sve-map1 op es zn) zd)))
(defun sve-bin (op es zd pg zm) (set$ zd (sve-merge pg es (sve-map2 op es zd zm) zd)))
(defun sve-bink (op es zd pg k) (set$ zd (sve-merge pg es (sve-mapk op es zd k) zd)))
(defun sve-binw (op es zd pg zm) (set$ zd (sve-merge pg es (sve-mapw op es zd zm) zd)))
(defun sve-tern (op es zd pg a b c) (set$ zd (sve-merge pg es (sve-map3 op es a b c) zd)))

;; the 8-bit immediates, which the decoder may give either way
(defun sve-uimm (es imm sh) (cast-low es (lshift (cast-unsigned 64 (cast-low 8 imm)) sh)))
(defun sve-simm (es imm sh) (cast-low es (lshift (cast-signed 64 (cast-low 8 imm)) sh)))

(defun sve-sel-imm (es zd pg k)
  (set$ zd (sve-merge pg es (replicate k (sve-lanes es)) zd)))

(defun sve-all (es zd x) (set$ zd (replicate (cast-low es x) (sve-lanes es))))

(defun sve-logical-imm (imm)
  (replicate (cast-low 64 (immediate-from-bitmask imm 64)) (/ *sve-vl* 64)))

(defun sve-fpimm8 (es imm)
  (case es
    16 (vfp-expand-imm imm 5 10)
    32 (vfp-expand-imm imm 8 23)
    (vfp-expand-imm imm 11 52)))

(defun sve-fp-half-one (es i) (sve-fpimm8 es (if (= i 0) 0x60 0x70)))
(defun sve-fp-half-two (es i) (sve-fpimm8 es (if (= i 0) 0x60 0x00)))
(defun sve-fp-zero-one (es i)
  (if (= i 0) (cast-unsigned es 0) (sve-fpimm8 es 0x70)))

;; the moves

(defun sve-dup-lane (es zd zn idx)
  (if (>= idx (sve-lanes es))
      (set$ zd (sve-zeros))
    (set$ zd (replicate (a64-lane zn es idx) (sve-lanes es)))))

(defun sve-index/i (es base step i)
  (let ((r (+ base (* (cast-unsigned es i) step))))
    (if (= i 0) r (concat r (sve-index/i es base step (- i 1))))))

(defun sve-index (es zd base step)
  (let ((b (cast-low es base)) (s (cast-low es step)))
    (set$ zd (sve-index/i es b s (- (sve-lanes es) 1)))))

(defun sve-ext (zd zn zm imm)
  (let ((pos (if (>= imm (sve-vl-bytes)) 0 imm)))
    (set$ zd (cast-low *sve-vl* (rshift (concat zm zn) (* pos 8))))))

(defun sve-insr (es zd v)
  (set$ zd (logor (lshift zd es) (cast-unsigned *sve-vl* (cast-low es v)))))

(defun sve-unpk (es signed zd zn hi)
  (let ((n (sve-lanes es)))
    (set$ zd (sve-unpk/i es signed zn (if hi n 0) (- n 1)))))

(defun sve-unpk/i (es signed zn k i)
  (let ((a (a64-lane zn (/ es 2) (+ k i)))
        (r (if signed (cast-signed es a) (cast-unsigned es a))))
    (if (= i 0) r (concat r (sve-unpk/i es signed zn k (- i 1))))))

(defun sve-tbl/i (es zn zm i)
  (let ((j (cast-unsigned *sve-vl* (a64-lane zm es i)))
        (big (>= j (cast-unsigned *sve-vl* (sve-lanes es))))
        (r (fp-select big (cast-unsigned es 0)
                      (cast-low es (rshift zn (* (fp-select big (sve-zeros) j)
                                                 (cast-unsigned *sve-vl* es)))))))
    (if (= i 0) r (concat r (sve-tbl/i es zn zm (- i 1))))))

(defun sve-tbl (es zd zn zm) (set$ zd (sve-tbl/i es zn zm (- (sve-lanes es) 1))))

(defun sve-compact/i (es pg zn i acc)
  (let ((r (fp-select (sve-active pg es i)
                      (logor (lshift acc es) (cast-unsigned *sve-vl* (a64-lane zn es i)))
                      acc)))
    (if (= i 0) r (sve-compact/i es pg zn (- i 1) r))))

(defun sve-compact (es zd pg zn)
  (set$ zd (sve-compact/i es pg zn (- (sve-lanes es) 1) (sve-zeros))))

(defun sve-splice (es zd pg zm)
  (let ((n (sve-lanes es))
        (last (sve-last-index pg es (- n 1)))
        (first (sve-first-index pg es 0))
        (count (cast-unsigned *sve-vl* (- (+ last (cast-unsigned 64 1)) first)))
        (bits (* count (cast-unsigned *sve-vl* es)))
        (keep (lnot (lshift (lnot (sve-zeros)) bits))))
    (set$ zd (logor (logand keep (rshift zd (* (cast-unsigned *sve-vl* first)
                                               (cast-unsigned *sve-vl* es))))
                    (lshift zm bits)))))

(defun sve-element (es zn index)
  "the element of the dynamic INDEX, of 64 bits, of ZN"
  (cast-low es (rshift zn (* (cast-unsigned *sve-vl* index) (cast-unsigned *sve-vl* es)))))

(defun sve-after-last (es pg)
  (let ((next (+ (sve-last-index pg es (- (sve-lanes es) 1)) (cast-unsigned 64 1))))
    (fp-select (= next (cast-unsigned 64 (sve-lanes es))) (cast-unsigned 64 0) next)))

(defun sve-at-last (es pg)
  (let ((last (sve-last-index pg es (- (sve-lanes es) 1))))
    (fp-select (msb last) (cast-unsigned 64 (- (sve-lanes es) 1)) last)))

(defun sve-set-scalar (rd v)
  "writes the zero extension of V to the whole of the base of RD, so it
   clears the rest of Vn, or the upper half of Xn"
  (set$ (alias-base-register rd)
        (cast-unsigned (word-width (alias-base-register rd)) v)))

(defun sve-lasta (es rd pg zn) (sve-set-scalar rd (sve-element es zn (sve-after-last es pg))))
(defun sve-lastb (es rd pg zn) (sve-set-scalar rd (sve-element es zn (sve-at-last es pg))))

(defun sve-clast-scalar (es rd pg zm after)
  (let ((e (sve-element es zm (if after (sve-after-last es pg) (sve-at-last es pg)))))
    (sve-set-scalar rd (fp-select (sve-any pg es) e (cast-low es rd)))))

(defun sve-clast-vector (es zd pg zm after)
  (let ((e (sve-element es zm (if after (sve-after-last es pg) (sve-at-last es pg)))))
    (set$ zd (fp-select (sve-any pg es) (replicate e (sve-lanes es)) zd))))

;; the reductions, by halves as Reduce of the Arm ARM, the inactive
;; elements are the identity of the operation

(defun sve-reduce/tree (op es x i n)
  (if (= n 1) (a64-lane x es i)
    (let ((l (sve-reduce/tree op es x i (/ n 2)))
          (h (sve-reduce/tree op es x (+ i (/ n 2)) (/ n 2))))
      (sve-op2 op l h))))

(defun sve-fidentity (op es)
  (let ((zero (cast-unsigned es 0))
        (one (a64-one zero))
        (inf (lshift (- (lshift one (a64-fexp-bits zero)) one) (a64-frac-bits zero))))
    (case op
      'fadd zero
      'fmax (fp-neg inf)
      'fmin inf
      (a64-default-nan zero))))

(defun sve-identity (op es)
  (let ((zero (cast-unsigned es 0))
        (top (lshift (a64-one zero) (- es 1))))
    (case op
      'and (lnot zero)
      'orr zero
      'eor zero
      'smax top
      'smin (lnot top)
      'umax zero
      'umin (lnot zero)
      (sve-fidentity op es))))

(defun sve-reduce (op es vd pg zn)
  (let ((x (sve-merge pg es zn (replicate (sve-identity op es) (sve-lanes es)))))
    (sve-set-scalar vd (sve-reduce/tree op es x 0 (sve-lanes es)))))

(defun sve-addv/i (signed es pg zn i)
  (let ((a (a64-lane zn es i))
        (e (fp-select (sve-active pg es i)
                      (if signed (cast-signed 64 a) (cast-unsigned 64 a))
                      (cast-unsigned 64 0))))
    (if (= i 0) e (+ e (sve-addv/i signed es pg zn (- i 1))))))

(defun sve-addv (signed es vd pg zn)
  (sve-set-scalar vd (sve-addv/i signed es pg zn (- (sve-lanes es) 1))))

(defun sve-fadda/i (es pg zm i acc)
  (if (= i (sve-lanes es)) acc
    (let ((r (fp-select (sve-active pg es i)
                        (a64-fop2 'fadd acc (a64-lane zm es i))
                        acc)))
      (sve-fadda/i es pg zm (+ i 1) r))))

(defun sve-fadda (es vd pg zm)
  (sve-set-scalar vd (sve-fadda/i es pg zm 0 (cast-low es vd))))

;; the comparisons, whose results are a bit of the lowest of the bits of
;; an element, the predicate holds only that bit

(defun sve-cmp-cond (op a b)
  (case op
    'eq (= a b)
    'ne (/= a b)
    'ge (s>= a b)
    'gt (s> a b)
    'le (s<= a b)
    'lt (s< a b)
    'hi (> a b)
    'hs (>= a b)
    'lo (< a b)
    (<= a b)))

(defun sve-cmp-signed (op)
  (case op
    'hi false
    'hs false
    'lo false
    'ls false
    true))

(defun sve-cmp/i (op es pg x y i)
  (let ((c (sve-pbit (logand (sve-active pg es i)
                             (sve-cmp-cond op (a64-lane x es i) (a64-lane y es i)))
                     es)))
    (if (= i 0) c (concat c (sve-cmp/i op es pg x y (- i 1))))))

(defun sve-cmpi/i (op es pg x k i)
  (let ((c (sve-pbit (logand (sve-active pg es i)
                             (sve-cmp-cond op (a64-lane x es i) k))
                     es)))
    (if (= i 0) c (concat c (sve-cmpi/i op es pg x k (- i 1))))))

(defun sve-cmpw/i (op es pg x y i)
  (let ((a (a64-lane x es i))
        (w (if (sve-cmp-signed op) (cast-signed 64 a) (cast-unsigned 64 a)))
        (c (sve-pbit (logand (sve-active pg es i)
                             (sve-cmp-cond op w (a64-lane y 64 (/ (* i es) 64))))
                     es)))
    (if (= i 0) c (concat c (sve-cmpw/i op es pg x y (- i 1))))))

(defun sve-cmp (op es pd pg zn zm)
  (sve-setp/flags pd pg (sve-cmp/i op es pg zn zm (- (sve-lanes es) 1)) es))
(defun sve-cmpi (op es pd pg zn imm)
  (sve-setp/flags pd pg (sve-cmpi/i op es pg zn (cast-low es imm) (- (sve-lanes es) 1)) es))
(defun sve-cmpw (op es pd pg zn zm)
  (sve-setp/flags pd pg (sve-cmpw/i op es pg zn zm (- (sve-lanes es) 1)) es))

(defun sve-fcmp-cond (op a b)
  (case op
    'fcmne (lnot (select 0 (a64-fop2 'fcmeq a b)))
    'fcmuo (logor (is-nan a) (is-nan b))
    (select 0 (a64-fop2 op a b))))

(defun sve-fcmp/i (op es pg x y i)
  (let ((c (sve-pbit (logand (sve-active pg es i)
                             (sve-fcmp-cond op (a64-lane x es i) (a64-lane y es i)))
                     es)))
    (if (= i 0) c (concat c (sve-fcmp/i op es pg x y (- i 1))))))

(defun sve-fcmp (op es pd pg zn zm)
  (set$ pd (sve-fcmp/i op es pg zn zm (- (sve-lanes es) 1))))

;; the counts and the increments

(defun sve-sat (signed sub x c w)
  "X plus or minus the count C, saturated to W bits, in a width that holds it"
  (let ((a (if signed (cast-signed 128 x) (cast-unsigned 128 x)))
        (d (cast-unsigned 128 c))
        (r (if sub (- a d) (+ a d))))
    (if signed (a64-sat-s r w) (a64-sat-u r w))))

(defun sve-qinc64 (signed sub rd c)
  (set$ (alias-base-register rd) (sve-sat signed sub (cast-low 64 rd) c 64)))

(defun sve-qinc32 (signed sub rd c)
  "the 32-bit forms, the result is extended to 64 bits as the operand is"
  (let ((r (sve-sat signed sub (cast-low 32 rd) c 32)))
    (set$ (alias-base-register rd)
          (if signed (cast-signed 64 r) (cast-unsigned 64 r)))))

(defun sve-qincz/i (signed sub es zn c i)
  (let ((r (sve-sat signed sub (a64-lane zn es i) c es)))
    (if (= i 0) r (concat r (sve-qincz/i signed sub es zn c (- i 1))))))

(defun sve-qincz (signed sub es zdn c)
  (let ((k c))
    (set$ zdn (sve-qincz/i signed sub es zdn k (- (sve-lanes es) 1)))))

(defun sve-incz (op es zdn c)
  (set$ zdn (sve-mapk op es zdn (cast-low es c))))

(defun sve-adr/i (es zn zm kind k i)
  (let ((m (a64-lane zm es i))
        (off (case kind
               'sxtw (cast-signed es (cast-low 32 m))
               'uxtw (cast-unsigned es (cast-low 32 m))
               m))
        (r (+ (a64-lane zn es i) (lshift off k))))
    (if (= i 0) r (concat r (sve-adr/i es zn zm kind k (- i 1))))))

(defun sve-adr (es zd zn zm kind k)
  (set$ zd (sve-adr/i es zn zm kind k (- (sve-lanes es) 1))))

;; the dot products

(defun sve-dot/j (es sn sm a b ia ib j)
  (let ((e (/ es 4))
        (x (a64-lane a e (+ ia j)))
        (y (a64-lane b e (+ ib j)))
        (p (* (if sn (cast-signed es x) (cast-unsigned es x))
              (if sm (cast-signed es y) (cast-unsigned es y)))))
    (if (= j 0) p (+ p (sve-dot/j es sn sm a b ia ib (- j 1))))))

(defun sve-dot/i (es sn sm zda zn zm i)
  (let ((r (+ (a64-lane zda es i) (sve-dot/j es sn sm zn zm (* 4 i) (* 4 i) 3))))
    (if (= i 0) r (concat r (sve-dot/i es sn sm zda zn zm (- i 1))))))

(defun sve-dot (es sn sm zda zn zm)
  (set$ zda (sve-dot/i es sn sm zda zn zm (- (sve-lanes es) 1))))

(defun sve-segment (es i idx)
  "the lane of the index IDX in the segment of 128 bits of the lane I"
  (+ (- i (mod i (/ 128 es))) idx))

(defun sve-doti/i (es sn sm zda zn zm idx i)
  (let ((r (+ (a64-lane zda es i)
              (sve-dot/j es sn sm zn zm (* 4 i) (* 4 (sve-segment es i idx)) 3))))
    (if (= i 0) r (concat r (sve-doti/i es sn sm zda zn zm idx (- i 1))))))

(defun sve-doti (es sn sm zda zn zm idx)
  (set$ zda (sve-doti/i es sn sm zda zn zm idx (- (sve-lanes es) 1))))

;; the multiplications by an element

(defun sve-mul2i/i (op es zn zm idx i)
  (let ((r (sve-op2 op (a64-lane zn es i) (a64-lane zm es (sve-segment es i idx)))))
    (if (= i 0) r (concat r (sve-mul2i/i op es zn zm idx (- i 1))))))

(defun sve-mul2i (op es zd zn zm idx)
  (set$ zd (sve-mul2i/i op es zn zm idx (- (sve-lanes es) 1))))

(defun sve-mul3i/i (op es zda zn zm idx i)
  (let ((r (sve-op3 op (a64-lane zda es i) (a64-lane zn es i)
                    (a64-lane zm es (sve-segment es i idx)))))
    (if (= i 0) r (concat r (sve-mul3i/i op es zda zn zm idx (- i 1))))))

(defun sve-mul3i (op es zda zn zm idx)
  (set$ zda (sve-mul3i/i op es zda zn zm idx (- (sve-lanes es) 1))))

;; the complex numbers: an element is two lanes, the real one first

(defun sve-fcadd/p (es zdn pg zm rot p)
  (let ((nr (a64-lane zdn es (* 2 p)))
        (ni (a64-lane zdn es (+ (* 2 p) 1)))
        (mr (a64-lane zm es (* 2 p)))
        (mi (a64-lane zm es (+ (* 2 p) 1)))
        ;; FPNeg, then FPAdd: the negated operand can be a NaN, which has that sign
        (r (if (= rot 0) (a64-fop2 'fadd nr (fp-neg mi)) (a64-fop2 'fadd nr mi)))
        (i (if (= rot 0) (a64-fop2 'fadd ni mr) (a64-fop2 'fadd ni (fp-neg mr))))
        (v (concat (fp-select (sve-active pg es (+ (* 2 p) 1)) i ni)
                   (fp-select (sve-active pg es (* 2 p)) r nr))))
    (if (= p 0) v (concat v (sve-fcadd/p es zdn pg zm rot (- p 1))))))

(defun sve-fcadd (es zdn pg zm rot)
  (set$ zdn (sve-fcadd/p es zdn pg zm rot (- (/ (sve-lanes es) 2) 1))))

(defun sve-cmla-pair (es da pg nr ni mr mi rot p)
  "one element of FCMLA, of the lanes 2P and 2P + 1 of DA, PG is its activity"
  (let ((sel (= (logand rot 1) 1))
        (neg-i (= (logand rot 2) 2))
        (neg-r (/= (= (logand rot 1) 1) (= (logand rot 2) 2)))
        (n (if sel ni nr))
        (ma (if sel mi mr))
        (mb (if sel mr mi))
        (dr (a64-lane da es (* 2 p)))
        (di (a64-lane da es (+ (* 2 p) 1)))
        (r (a64-muladd dr n (if neg-r (fp-neg ma) ma)))
        (i (a64-muladd di n (if neg-i (fp-neg mb) mb))))
    (concat (fp-select (sve-active pg es (+ (* 2 p) 1)) i di)
            (fp-select (sve-active pg es (* 2 p)) r dr))))

(defun sve-fcmla/p (es zda pg zn zm rot p)
  (let ((v (sve-cmla-pair es zda pg
                          (a64-lane zn es (* 2 p)) (a64-lane zn es (+ (* 2 p) 1))
                          (a64-lane zm es (* 2 p)) (a64-lane zm es (+ (* 2 p) 1))
                          rot p)))
    (if (= p 0) v (concat v (sve-fcmla/p es zda pg zn zm rot (- p 1))))))

(defun sve-fcmla (es zda pg zn zm rot)
  (set$ zda (sve-fcmla/p es zda pg zn zm rot (- (/ (sve-lanes es) 2) 1))))

(defun sve-fcmlai/p (es zda pg zn zm idx rot p)
  (let ((j (sve-segment (* 2 es) p idx))
        (v (sve-cmla-pair es zda pg
                          (a64-lane zn es (* 2 p)) (a64-lane zn es (+ (* 2 p) 1))
                          (a64-lane zm es (* 2 j)) (a64-lane zm es (+ (* 2 j) 1))
                          rot p)))
    (if (= p 0) v (concat v (sve-fcmlai/p es zda pg zn zm idx rot (- p 1))))))

(defun sve-fcmlai (es zda zn zm idx rot)
  (set$ zda (sve-fcmlai/p es zda (lnot (cast-unsigned (sve-pl) 0)) zn zm idx rot
                          (- (/ (sve-lanes es) 2) 1))))

;; FTMAD's table is an intrinsic, of the two operands and the index
(defun sve-ftmad/i (es zdn zm imm i)
  (let ((a (a64-lane zdn es i))
        (r (intrinsic (symbol-concat 'ftmad 'ieee754_binary (a64-fsize-symbol a) :sep '_)
                      a (a64-lane zm es i) (cast-low 8 imm) :result es)))
    (if (= i 0) r (concat r (sve-ftmad/i es zdn zm imm (- i 1))))))

(defun sve-ftmad (es zdn zm imm)
  (set$ zdn (sve-ftmad/i es zdn zm imm (- (sve-lanes es) 1))))

;; the conversions: an element of ES bits holds a value of SB bits, and
;; gets one of DB bits, extended to ES bits as the Arm ARM says

(defun sve-conv-lane (kind es sb db x)
  (let ((s (cast-low sb x)))
    (case kind
      'fcvt (cast-unsigned es (fconvert :rne db s))
      'scvtf (cast-unsigned es (cast-sfloat :rne db s))
      'ucvtf (cast-unsigned es (cast-float :rne db s))
      'fcvtzs (cast-signed es (a64-fcvt-to true 'z db s))
      (cast-unsigned es (a64-fcvt-to false 'z db s)))))

(defun sve-conv/i (kind es sb db zn i)
  (let ((r (sve-conv-lane kind es sb db (a64-lane zn es i))))
    (if (= i 0) r (concat r (sve-conv/i kind es sb db zn (- i 1))))))

(defun sve-conv (kind es sb db zd pg zn)
  (set$ zd (sve-merge pg es (sve-conv/i kind es sb db zn (- (sve-lanes es) 1)) zd)))

;; the loads and the stores: of the elements of MS bits in memory, each
;; in a lane of ES bits. An inactive element isn't accessed, which is why
;; the let: it makes the branch of the load a branch of the program

(defun sve-load-element (c a es ms signed)
  (if c
      (let ((v (load-bits ms a)))
        (if signed (cast-signed es v) (cast-unsigned es v)))
    (cast-unsigned es 0)))

(defun sve-ld1/i (es ms signed pg a i)
  (let ((r (sve-load-element (sve-active pg es i)
                             (+ a (* i (/ ms 8))) es ms signed)))
    (if (= i 0) r (concat r (sve-ld1/i es ms signed pg a (- i 1))))))

(defun sve-ld1 (es ms signed zt pg addr)
  (let ((a addr))
    (set$ zt (sve-ld1/i es ms signed pg a (- (sve-lanes es) 1)))))

(defun sve-st1/i (es ms zt pg a i)
  (when (< i (sve-lanes es))
    (when (sve-active pg es i)
      (store-word (+ a (* i (/ ms 8))) (cast-low ms (a64-lane zt es i))))
    (sve-st1/i es ms zt pg a (+ i 1))))

(defun sve-st1 (es ms zt pg addr)
  (let ((a addr))
    (sve-st1/i es ms zt pg a 0)))

(defun sve-vl-offset (es ms imm)
  "the offset of a contiguous access of IMM times the elements of a vector"
  (* imm (* (sve-lanes es) (/ ms 8))))

;; LD1R*: an element is loaded once, if any is active
(defun sve-ld1r (es ms signed zt pg addr)
  (let ((a addr)
        (v (sve-load-element (sve-any pg es) a es ms signed)))
    (set$ zt (sve-zeroing pg es (replicate v (sve-lanes es))))))

;; LD1RQ*: a segment of 128 bits, of which the lowest elements of PG are
;; loaded, repeated. At 128 bits that is one segment
(defun sve-ld1rq (es zt pg addr)
  (let ((a addr)
        (s (sve-ld1rq/i es pg a (- (/ 128 es) 1))))
    (set$ zt (replicate s (/ *sve-vl* 128)))))

(defun sve-ld1rq/i (es pg a i)
  (let ((r (sve-load-element (sve-active pg es i) (+ a (* i (/ es 8))) es es false)))
    (if (= i 0) r (concat r (sve-ld1rq/i es pg a (- i 1))))))

;; LDn and STn: the element E of the register R is at E * N + R

(defun sve-ldn/e (es pg a n r e)
  (let ((v (sve-load-element (sve-active pg es e)
                             (+ a (* (+ (* e n) r) (/ es 8))) es es false)))
    (if (= e 0) v (concat v (sve-ldn/e es pg a n r (- e 1))))))

(defun sve-ldn/r (es zt pg a n r)
  (when (< r n)
    (let ((v (sve-ldn/e es pg a n r (- (sve-lanes es) 1))))
      (sve-ldn/r es zt pg a n (+ r 1))
      (a64-vt-set zt r v))))

(defun sve-ldn (es n zt pg addr)
  (let ((a addr))
    (sve-ldn/r es zt pg a n 0)))

(defun sve-stn/e (es zt pg a n e r)
  (when (< e (sve-lanes es))
    (when (< r n)
      (when (sve-active pg es e)
        (store-word (+ a (* (+ (* e n) r) (/ es 8)))
                    (a64-lane (a64-vt-get zt r) es e)))
      (sve-stn/e es zt pg a n e (+ r 1)))
    (when (= r n) (sve-stn/e es zt pg a n (+ e 1) 0))))

(defun sve-stn (es n zt pg addr)
  (let ((a addr))
    (sve-stn/e es zt pg a n 0 0)))

(defun sve-ldr-z (zt rn imm)
  (set$ zt (load-bits *sve-vl* (+ rn (* imm (sve-vl-bytes))))))

(defun sve-ldr-p (pt rn imm)
  (set$ pt (load-bits (sve-pl) (+ rn (* imm (/ (sve-pl) 8))))))

(defun sve-str-z (zt rn imm)
  (a64-store-pieces (+ rn (* imm (sve-vl-bytes))) zt 0 (/ *sve-vl* 64)))

(defun sve-str-p (pt rn imm)
  (store-word (+ rn (* imm (/ (sve-pl) 8))) pt))

;; the gathers and the scatters: the address of the element I is RN and
;; the offset in ZM, of KIND, shifted by SCALE, or the element of ZN and
;; an immediate

(defun sve-goffset (es zm kind scale i)
  (let ((m (a64-lane zm es i)))
    (lshift (case kind
              'sxtw (cast-signed 64 (cast-low 32 m))
              'uxtw (cast-unsigned 64 (cast-low 32 m))
              (cast-unsigned 64 m))
            scale)))

(defun sve-gld/i (es ms signed pg rn zm kind scale i)
  (let ((v (sve-load-element (sve-active pg es i)
                             (+ rn (sve-goffset es zm kind scale i)) es ms signed)))
    (if (= i 0) v (concat v (sve-gld/i es ms signed pg rn zm kind scale (- i 1))))))

(defun sve-gld (es ms signed zt pg rn zm kind scale)
  (let ((a rn))
    (set$ zt (sve-gld/i es ms signed pg a zm kind scale (- (sve-lanes es) 1)))))

(defun sve-gldi/i (es ms signed pg zn k i)
  (let ((v (sve-load-element (sve-active pg es i)
                             (+ (cast-unsigned 64 (a64-lane zn es i)) k) es ms signed)))
    (if (= i 0) v (concat v (sve-gldi/i es ms signed pg zn k (- i 1))))))

(defun sve-gldi (es ms signed zt pg zn imm)
  (set$ zt (sve-gldi/i es ms signed pg zn (* imm (/ ms 8)) (- (sve-lanes es) 1))))

(defun sve-sst/i (es ms zt pg rn zm kind scale i)
  (when (< i (sve-lanes es))
    (when (sve-active pg es i)
      (store-word (+ rn (sve-goffset es zm kind scale i)) (cast-low ms (a64-lane zt es i))))
    (sve-sst/i es ms zt pg rn zm kind scale (+ i 1))))

(defun sve-sst (es ms zt pg rn zm kind scale)
  (let ((a rn))
    (sve-sst/i es ms zt pg a zm kind scale 0)))

(defun sve-ssti/i (es ms zt pg zn k i)
  (when (< i (sve-lanes es))
    (when (sve-active pg es i)
      (store-word (+ (cast-unsigned 64 (a64-lane zn es i)) k) (cast-low ms (a64-lane zt es i))))
    (sve-ssti/i es ms zt pg zn k (+ i 1))))

(defun sve-ssti (es ms zt pg zn imm)
  (sve-ssti/i es ms zt pg zn (* imm (/ ms 8)) 0))

;;; THE INSTRUCTIONS

;; PREDICATES

