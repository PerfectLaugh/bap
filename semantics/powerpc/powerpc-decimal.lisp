;;; THE DECIMAL FLOATING POINT
;;
;; The values are in the DPD format, in a floating-point register, the
;; quad ones in a pair of them. As with the binary floating point, the
;; operations are named intrinsics: there is no theory of the decimals
;; here. Each takes the operands of the instruction and gives its result.
;; The exceptions and the modes of FPSCR are not modeled, and the record
;; forms set CR1 as the binary ones do.

(defmacro decimal2 (name rt ra rb)
  (set$ rt (intrinsic name ra rb :result (word-width rt))))
(defmacro decimal1 (name rt rb)
  (set$ rt (intrinsic name rb :result (word-width rt))))
(defmacro decimal3 (name rt ra rb c)
  (set$ rt (intrinsic name ra rb c :result (word-width rt))))

