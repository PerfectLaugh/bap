;;; BINARY-CODED DECIMAL IN THE VECTOR REGISTERS
;;
;; They are intrinsics with the names of the instructions as well, which
;; give the result and the field CR6.

(defun bcd2 (name vd va vb ps)
  (let ((r (intrinsic name va vb ps :result 132)))
    (set$ vd (cast-low 128 r))
    (set CR6 (cast-high 4 r))))
(defun bcd1 (name vd vb ps)
  (let ((r (intrinsic name vb ps :result 132)))
    (set$ vd (cast-low 128 r))
    (set CR6 (cast-high 4 r))))

(defun BCDADD_rec (vd va vb ps) (bcd2 'bcdadd vd va vb ps))
