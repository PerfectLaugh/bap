;;; THE DECIMAL FLOATING POINT
;;
;; The values are in the DPD format, in a floating-point register, the
;; quad ones in a pair of them. There is no theory of the decimals here:
;; the operations are the intrinsics powerpc-<name of the instruction>,
;; which a machine serves (Bap.Decimal). Each takes the rounding mode,
;; DRN of FPSCR, and the operands of the instruction, and gives a word
;; of its result, in the low 128 bits, and above them the bits of FPSCR
;; that it raises, at their places, the class of the result, FPRF, and
;; FR and FI, with a bit for each of FPRF, of FR and FI, and of FPCC
;; alone, that says that the instruction sets it. The exceptions that
;; are enabled aren't taken, as those of the binary floating point
;; aren't. The record forms set CR1 as the binary ones do.

(defun decimal-rounding () (cast-low 8 (logand (rshift FPSCR 32) 7:64)))

(defun decimal-status (r)
  "sets FPSCR by what the result R of an intrinsic of the decimals says"
  (let ((status (cast-unsigned 64 (extract 159 128 r)))
        (old (fpscr))
        (kept (logand old (lnot (logor (pick (select 160 r) 0x1f000:64 0:64)
                                       (pick (select 161 r) 0x60000:64 0:64)
                                       (pick (select 162 r) 0xf000:64 0:64)))))
        (new (logor kept status))
        (fresh (logand new (lnot old) 0x1ff80700:64)))
    (set-fpscr (logor new (lshift (u64 (non-zero fresh)) 31)))))

;; a pair of floating point registers is written as each of them is: the
;; other doublewords of their VSX registers are zeros
(defun clear-pair (first second)
  (set-symbol-value first (cast-unsigned 64 0:1))
  (set-symbol-value second (cast-unsigned 64 0:1)))
(defun set-fpair (rt x)
  (set$ rt x)
  (case (symbol rt)
    'Fpair0 (clear-pair 'F0L 'F1L)
    'Fpair2 (clear-pair 'F2L 'F3L)
    'Fpair4 (clear-pair 'F4L 'F5L)
    'Fpair6 (clear-pair 'F6L 'F7L)
    'Fpair8 (clear-pair 'F8L 'F9L)
    'Fpair10 (clear-pair 'F10L 'F11L)
    'Fpair12 (clear-pair 'F12L 'F13L)
    'Fpair14 (clear-pair 'F14L 'F15L)
    'Fpair16 (clear-pair 'F16L 'F17L)
    'Fpair18 (clear-pair 'F18L 'F19L)
    'Fpair20 (clear-pair 'F20L 'F21L)
    'Fpair22 (clear-pair 'F22L 'F23L)
    'Fpair24 (clear-pair 'F24L 'F25L)
    'Fpair26 (clear-pair 'F26L 'F27L)
    'Fpair28 (clear-pair 'F28L 'F29L)
    'Fpair30 (clear-pair 'F30L 'F31L)))

