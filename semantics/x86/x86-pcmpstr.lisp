;;; PCMPISTRI, PCMPISTRM, PCMPESTRI AND PCMPESTRM
;;
;; The packed string comparisons of SSE4.2, see the section 4.1 of the
;; volume 2 of the Intel SDM. The bits of the immediate select the
;; elements, bytes or words (0), signed or not (1), the aggregation (3-2):
;; equal any, ranges, equal each or equal ordered, the polarity (5-4) and
;; the least or the most significant index, or the bit or the element
;; mask (6). The strings end with the first zero element (I) or have the
;; lengths in EAX and EDX (E). The first operand is the set or the
;; pattern, the second is the string, IntRes1 and IntRes2 are 16-bit,
;; the words use the low 8 bits.

(defun pstr-words (n) (non-zero (logand n 1)))
(defun pstr-signed (n) (non-zero (logand n 2)))
(defun pstr-agg (n) (logand (rshift n 2) 3))
(defun pstr-polarity (n) (logand (rshift n 4) 3))
(defun pstr-msb (n) (non-zero (logand n 64)))

(defun pstr-elt (s x i) (extract-lane s x i))
(defun pstr-valid (len i) (< (resize 8 i) len))
(defun pstr-le (sg x y) (if sg (s<= x y) (<= x y)))
(defun pstr-eq (s a b i j) (= (pstr-elt s a i) (pstr-elt s b j)))
(defun pstr-in (s sg a b i j)
  (let ((x (pstr-elt s b j)))
    (logand (pstr-le sg (pstr-elt s a i) x) (pstr-le sg x (pstr-elt s a (+ i 1))))))

;; the explicit length is the absolute value of the register saturated
;; to the number of elements
(defun pstr-explicit (n x)
  (let ((a (if (msb x) (neg x) x))
