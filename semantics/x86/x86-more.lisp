(defun MMX_PACKUSWBrm (rd x b s i off seg) (set$ rd (let ((y (mmx-mem b s i off seg))) (mmx-pack signed-to-unsigned-8 8 16 x y))))
(defun MMX_PACKSSDWrr (rd x y) (set$ rd (mmx-pack signed-to-signed-16 16 32 x y)))
(defun MMX_PACKSSDWrm (rd x b s i off seg) (set$ rd (let ((y (mmx-mem b s i off seg))) (mmx-pack signed-to-signed-16 16 32 x y))))

(defun MMX_PEXTRWrri (rd x imm) (set-gpr rd (cast-unsigned (word-width rd) (evex-lane 16 x (logand imm 3)))))
(defun mmx-pinsr-lane (x y n _ _ _ _ i) (if (= i n) y (evex-lane 16 x i)))
(defun mmx-pinsrw (x y imm) (evex-lanes 0 0 0 16 mmx-pinsr-lane x (cast-low 16 y) (logand imm 3) 0 0 0 0 0 4))
(defun MMX_PINSRWrri (rd x y imm) (set$ rd (mmx-pinsrw x y imm)))
(defun MMX_PINSRWrmi (rd x b s i off seg imm) (set$ rd (mmx-pinsrw x (load-n 16 (ea b s i off seg)) imm)))
(defun mmx-pmuludq (x y) (* (cast-unsigned 64 (cast-low 32 x)) (cast-unsigned 64 (cast-low 32 y))))
(defun MMX_PMULUDQrr (rd x y) (set$ rd (mmx-pmuludq x y)))
(defun MMX_PMULUDQrm (rd x b s i off seg) (set$ rd (mmx-pmuludq x (mmx-mem b s i off seg))))
(defun mmx-pshuf-lane (x imm _ _ _ _ _ i) (evex-lane 16 x (logand (rshift imm (* 2 i)) 3)))
(defun mmx-pshufw (x imm) (evex-lanes 0 0 0 16 mmx-pshuf-lane x imm 0 0 0 0 0 0 4))
(defun MMX_PSHUFWri (rd x imm) (set$ rd (mmx-pshufw x imm)))
(defun MMX_PSHUFWmi (rd b s i off seg imm) (set$ rd (let ((x (mmx-mem b s i off seg))) (mmx-pshufw x imm))))

;; the conversions, with the kinds of `evex-cvt`

(defun mmx-cvt-lane (kind es ed y _ _ _ i) (evex-cvt kind es ed (evex-lane es y i)))
(defun mmx-cvt (kind es ed y) (evex-lanes 0 0 0 ed mmx-cvt-lane kind es ed y 0 0 0 0 2))
(defun MMX_CVTPI2PSrr (rd x y) (set$ rd (concat (extract 127 64 x) (mmx-cvt 1 32 32 y))))
(defun MMX_CVTPI2PSrm (rd x b s i off seg) (set$ rd (let ((y (mmx-mem b s i off seg))) (concat (extract 127 64 x) (mmx-cvt 1 32 32 y)))))
(defun MMX_CVTPI2PDrr (rd y) (set$ rd (mmx-cvt 1 32 64 y)))
(defun MMX_CVTPI2PDrm (rd b s i off seg) (set$ rd (let ((y (mmx-mem b s i off seg))) (mmx-cvt 1 32 64 y))))
(defun MMX_CVTPS2PIrr (rd y) (set$ rd (mmx-cvt 3 32 32 y)))
(defun MMX_CVTPS2PIrm (rd b s i off seg) (set$ rd (let ((y (mmx-mem b s i off seg))) (mmx-cvt 3 32 32 y))))
(defun MMX_CVTTPS2PIrr (rd y) (set$ rd (mmx-cvt 5 32 32 y)))
(defun MMX_CVTTPS2PIrm (rd b s i off seg) (set$ rd (let ((y (mmx-mem b s i off seg))) (mmx-cvt 5 32 32 y))))
(defun MMX_CVTPD2PIrr (rd y) (set$ rd (mmx-cvt 3 64 32 y)))
(defun MMX_CVTPD2PIrm (rd b s i off seg) (set$ rd (let ((y (aes-mem b s i off seg))) (mmx-cvt 3 64 32 y))))
(defun MMX_CVTTPD2PIrr (rd y) (set$ rd (mmx-cvt 5 64 32 y)))
(defun MMX_CVTTPD2PIrm (rd b s i off seg) (set$ rd (let ((y (aes-mem b s i off seg))) (mmx-cvt 5 64 32 y))))

;; MASKMOVQ stores the bytes whose top bits the mask has at DI

(defun mmx-maskmov-lane (a x k _ _ _ _ i)
  (when (msb (evex-lane 8 k i))
    (store-n 8 (+ a i) (evex-lane 8 x i))))
(defun mmx-maskmov (a x k) (evex-each mmx-maskmov-lane a x k 0 0 0 0 0 8))
(defun MMX_MASKMOVQ64 (x k) (mmx-maskmov RDI x k))
(defun MMX_MASKMOVQ (x k) (mmx-maskmov EDI x k))

;;; X87, THE REST

(defun FNOP () (empty))
(defun FFREEP (r) (FFREE r) (x87-pop))

;; C0, C2 and C3 of the status word say what the comparison is

(defun x87-compare-status (x y) (x87-compare-status-by sse-forder x y))
;; of FCOM, FICOM and FTST, which raise invalid of a quiet NaN too, where
;; FUCOM doesn't
(defun x87-compare-status-signaling (x y) (x87-compare-status-by sse-forders x y))
(defun x87-compare-status-by (order x y)
  (let ((nan (logor (sse-is-nan 80 x) (sse-is-nan 80 y)))
        (less (order 80 x y))
        (more (order 80 y x)))
    (let ((same (not (logor nan (logor less more)))))
      (set FPU_STATUS
           (logor (logand FPU_STATUS 0xb8ff:16)
                  (lshift (cast-unsigned 16 (logor same nan)) 14)
                  (lshift (cast-unsigned 16 nan) 10)
                  (lshift (cast-unsigned 16 (logor less nan)) 8))))))

(defun COM_FST0r (r) (x87-compare-status-signaling ST0 r))
(defun COMP_FST0r (r) (x87-compare-status-signaling ST0 r) (x87-pop))
(defun UCOM_Fr (r) (x87-compare-status ST0 r))
(defun UCOM_FPr (r) (x87-compare-status ST0 r) (x87-pop))
(defun UCOM_FPPr () (x87-compare-status ST0 ST1) (x87-pop) (x87-pop))
(defun FCOMPP () (x87-compare-status-signaling ST0 ST1) (x87-pop) (x87-pop))
(defun TST_F () (x87-compare-status-signaling ST0 (x87-from-int 16 0:16)))
(defun FCOM32m (b s i off seg) (x87-compare-status-signaling ST0 (x87-from-float 32 (load-n 32 (ea b s i off seg)))))
(defun FCOM64m (b s i off seg) (x87-compare-status-signaling ST0 (x87-from-float 64 (load-n 64 (ea b s i off seg)))))
(defun FCOMP32m (b s i off seg) (FCOM32m b s i off seg) (x87-pop))
(defun FCOMP64m (b s i off seg) (FCOM64m b s i off seg) (x87-pop))
(defun FICOM16m (b s i off seg) (x87-compare-status-signaling ST0 (x87-from-int 16 (load-n 16 (ea b s i off seg)))))
(defun FICOM32m (b s i off seg) (x87-compare-status-signaling ST0 (x87-from-int 32 (load-n 32 (ea b s i off seg)))))
(defun FICOMP16m (b s i off seg) (FICOM16m b s i off seg) (x87-pop))
(defun FICOMP32m (b s i off seg) (FICOM32m b s i off seg) (x87-pop))

;; the functions, as intrinsics, and C2 of FPTAN and of the others is clear,
;; as an argument out of range isn't modeled

(defun x87-clear-c2 () (set FPU_STATUS (logand FPU_STATUS 0xfbff:16)))
(defun x87-function (name x) (intrinsic (symbol-concat name 'rne *sse-format* '80 :sep '_) x :result 80))
(defun F2XM1 () (set ST0 (x87-function 'f2xm1 ST0)))
(defun FSIN () (set ST0 (x87-function 'fsin ST0)) (x87-clear-c2))
(defun FCOS () (set ST0 (x87-function 'fcos ST0)) (x87-clear-c2))
(defun FSINCOS ()
  (let ((x ST0))
    (set ST0 (x87-function 'fsin x))
    (x87-push (x87-function 'fcos x))
    (x87-clear-c2)))
(defun FPTAN ()
  (set ST0 (x87-function 'ftan ST0))
  (x87-push (x87-from-int 16 1:16))
  (x87-clear-c2))
(defun FPATAN ()
  (set ST1 (x87-binary 'fatan2 ST1 ST0))
  (x87-pop))
(defun FYL2X ()
  (set ST1 (x87-binary 'fyl2x ST1 ST0))
  (x87-pop))
(defun FYL2XP1 ()
  (set ST1 (x87-binary 'fyl2xp1 ST1 ST0))
  (x87-pop))
(defun FXTRACT ()
  (let ((x ST0))
    (set ST0 (x87-function 'fexponent x))
    (x87-push (x87-function 'fsignificand x))))
(defun x87-remainder (name)
  (let ((r (intrinsic (symbol-concat name 'status *sse-format* '80 :sep '_) ST0 ST1 :result 16)))
    (set ST0 (x87-binary name ST0 ST1))
    (set FPU_STATUS (logor (logand FPU_STATUS 0xb8ff:16) (logand r 0x4700:16)))))
(defun FPREM () (x87-remainder 'fprem))
(defun FPREM1 () (x87-remainder 'fprem1))

;; packed decimals, and FSAVE, which is FNSTENV, the registers, and FNINIT

(defun FBLDm (b s i off seg) (x87-push (intrinsic 'fbld_ieee754_binary_80 (load-n 80 (ea b s i off seg)) :result 80)))
;; to an integer by the rounding of the control word
(defun FBSTPm (b s i off seg)
  (store-n 80 (ea b s i off seg) (x87-function 'fbstp ST0))
  (x87-pop))
(defun x87-save-registers (a)
  (store-n 80 (+ a 28) ST0)
  (store-n 80 (+ a 38) ST1)
  (store-n 80 (+ a 48) ST2)
  (store-n 80 (+ a 58) ST3)
  (store-n 80 (+ a 68) ST4)
  (store-n 80 (+ a 78) ST5)
  (store-n 80 (+ a 88) ST6)
  (store-n 80 (+ a 98) ST7))
(defun FSAVEm (b s i off seg)
  (FSTENVm b s i off seg)
  (x87-save-registers (ea b s i off seg))
  (FNINIT))
(defun FRSTORm (b s i off seg)
  (FLDENVm b s i off seg)
  (let ((a (ea b s i off seg)))
    (set ST0 (load-n 80 (+ a 28)))
    (set ST1 (load-n 80 (+ a 38)))
    (set ST2 (load-n 80 (+ a 48)))
    (set ST3 (load-n 80 (+ a 58)))
    (set ST4 (load-n 80 (+ a 68)))
    (set ST5 (load-n 80 (+ a 78)))
    (set ST6 (load-n 80 (+ a 88)))
    (set ST7 (load-n 80 (+ a 98)))))
