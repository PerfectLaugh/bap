;; what asks the machine

(defun random-to (name rd)
  (let ((r (intrinsic name :result (+ (word-width rd) 1))))
    (set-gpr rd (cast-low (word-width rd) r))
    (set CF (cast-high 1 r))
    (set OF 0:1)
    (set SF 0:1)
    (set ZF 0:1)
    (set AF 0:1)
    (set PF 0:1)))

