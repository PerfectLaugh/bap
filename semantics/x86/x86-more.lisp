;; the conditional comparisons of APX: if the condition doesn't hold, the
;; flags are of the bits of the instruction, OF, SF, ZF and CF from the top,
;; PF is as CF and AF is clear. The codes of P and NP are always and never
;; here, as these instructions have no conditions of PF

(defun conditional-holds (cc)
  (case cc
    10 1:1
    11 0:1
    (condition cc)))

(defun conditional-flags (cc dcf f x y)
  (let ((holds (conditional-holds cc)))
    (f x y)
    (unless holds
      (set OF (select 3 dcf))
      (set SF (select 2 dcf))
      (set ZF (select 1 dcf))
      (set CF (select 0 dcf))
      (set PF (select 0 dcf))
      (set AF 0:1))))
(defun ctest-op (x y) (and-op x y))

