(defun mmx-mem (b s i off seg) (load-n 64 (ea b s i off seg)))

(defun signed-to-unsigned-8 (x)
  (if (msb x) 0:8 (if (non-zero (extract 15 8 x)) 0xff:8 (cast-low 8 x))))
(defun signed-to-signed-8 (x) (cast-saturate :signed 8 x))
(defun signed-to-signed-16 (x) (cast-saturate :signed 16 x))

(defun mmx-pack-lane (f e x y half _ _ i)
  (if (< i half) (f (evex-lane e x i)) (f (evex-lane e y (- i half)))))
(defun mmx-pack (f rt e x y) (evex-lanes 0 0 0 rt mmx-pack-lane f e x y (/ 64 e) 0 0 0 (/ 64 rt)))

(defun MMX_PACKSSWBrr (rd x y) (set$ rd (mmx-pack signed-to-signed-8 8 16 x y)))
(defun MMX_PACKSSWBrm (rd x b s i off seg) (set$ rd (let ((y (mmx-mem b s i off seg))) (mmx-pack signed-to-signed-8 8 16 x y))))
