;;; THE GATHERS OF AVX2: THE TOP BIT OF EACH LANE OF THE VECTOR OF THE MASK
;;
;; (RD MASK PASS BASE SCALE INDEX OFF SEG MASK): an element is loaded only
;; if its bit is set, and the whole vector of the mask is cleared.

(defun avx2-lane-gather (e ie a scale idx pass mask i)
  (if (msb (evex-lane e mask i))
      (load-n e (evex-element-address a scale ie idx i))
    (evex-lane e pass i)))

(defun avx2-gather (e ie n rd mask pass b scale idx off seg k)
  (let ((a (ea b 0 'Nil off seg)))
    (set-vex rd (evex-lanes 0 0 0 e avx2-lane-gather e ie a scale idx pass k 0 n))
    (set-vex mask (zeros 128))))

(defun VPGATHERDDrm (rd mask pass b scale idx off seg k) (avx2-gather 32 32 4 rd mask pass b scale idx off seg k))
(defun VPGATHERDDYrm (rd mask pass b scale idx off seg k) (avx2-gather 32 32 8 rd mask pass b scale idx off seg k))
