;;; SHA-NI, FROM THE SDM

(defun rol32 (x n) (logor (lshift x n) (rshift x (- 32 n))))
(defun ror32 (x n) (logor (rshift x n) (lshift x (- 32 n))))
(defun dword (x i) (evex-lane 32 x i))

(defun sha1-f (k b c d)
  (case k
    0 (logxor d (logand b (logxor c d)))
    2 (logor (logand b c) (logand d (logor b c)))
    (logxor b c d)))
(defun sha1-k (k) (case k 0 0x5a827999:32 1 0x6ed9eba1:32 2 0x8f1bbcdc:32 0xca62c1d6:32))

(defun sha1-round (k a b c d w)
  (+ (sha1-f k b c d) (rol32 a 5) w (sha1-k k)))

(defun sha1-rounds (k a0 b0 c0 d0 y)
  (let ((a1 (sha1-round k a0 b0 c0 d0 (dword y 3)))
        (a2 (+ (sha1-round k a1 a0 (rol32 b0 30) c0 (dword y 2)) d0))
        (a3 (+ (sha1-round k a2 a1 (rol32 a0 30) (rol32 b0 30) (dword y 1)) c0))
        (a4 (+ (sha1-round k a3 a2 (rol32 a1 30) (rol32 a0 30) (dword y 0)) (rol32 b0 30))))
    (concat a4 a3 (rol32 a2 30) (rol32 a1 30))))

(defun sha1rnds4 (x y imm)
  (sha1-rounds (logand imm 3) (dword x 3) (dword x 2) (dword x 1) (dword x 0) y))

(defun SHA1RNDS4rri (rd x y imm) (set$ rd (sha1rnds4 x y imm)))
(defun SHA1RNDS4rmi (rd x b s i off seg imm) (set$ rd (sha1rnds4 x (aes-mem b s i off seg) imm)))

(defun sha1nexte (x y) (concat (+ (dword y 3) (rol32 (dword x 3) 30)) (extract 95 0 y)))
(defun SHA1NEXTErr (rd x y) (set$ rd (sha1nexte x y)))
(defun SHA1NEXTErm (rd x b s i off seg) (set$ rd (sha1nexte x (aes-mem b s i off seg))))

(defun sha1msg1 (x y)
  (concat (logxor (dword x 1) (dword x 3)) (logxor (dword x 0) (dword x 2))
          (logxor (dword y 3) (dword x 1)) (logxor (dword y 2) (dword x 0))))
(defun SHA1MSG1rr (rd x y) (set$ rd (sha1msg1 x y)))
(defun SHA1MSG1rm (rd x b s i off seg) (set$ rd (sha1msg1 x (aes-mem b s i off seg))))

(defun sha1msg2 (x y)
  (let ((w16 (rol32 (logxor (dword x 3) (dword y 2)) 1))
        (w17 (rol32 (logxor (dword x 2) (dword y 1)) 1))
        (w18 (rol32 (logxor (dword x 1) (dword y 0)) 1))
        (w19 (rol32 (logxor (dword x 0) w16) 1)))
    (concat w16 w17 w18 w19)))
(defun SHA1MSG2rr (rd x y) (set$ rd (sha1msg2 x y)))
(defun SHA1MSG2rm (rd x b s i off seg) (set$ rd (sha1msg2 x (aes-mem b s i off seg))))

(defun sha256-s0 (x) (logxor (ror32 x 7) (ror32 x 18) (rshift x 3)))
(defun sha256-s1 (x) (logxor (ror32 x 17) (ror32 x 19) (rshift x 10)))
(defun sha256-big0 (x) (logxor (ror32 x 2) (ror32 x 13) (ror32 x 22)))
(defun sha256-big1 (x) (logxor (ror32 x 6) (ror32 x 11) (ror32 x 25)))
(defun sha256-ch (e f g) (logxor (logand e f) (logand (lnot e) g)))
(defun sha256-maj (a b c) (logxor (logand a b) (logand a c) (logand b c)))

(defun sha256msg1 (x y)
  (concat (+ (dword x 3) (sha256-s0 (dword y 0))) (+ (dword x 2) (sha256-s0 (dword x 3)))
          (+ (dword x 1) (sha256-s0 (dword x 2))) (+ (dword x 0) (sha256-s0 (dword x 1)))))
(defun SHA256MSG1rr (rd x y) (set$ rd (sha256msg1 x y)))
(defun SHA256MSG1rm (rd x b s i off seg) (set$ rd (sha256msg1 x (aes-mem b s i off seg))))

(defun sha256msg2 (x y)
  (let ((w16 (+ (dword x 0) (sha256-s1 (dword y 2))))
        (w17 (+ (dword x 1) (sha256-s1 (dword y 3))))
        (w18 (+ (dword x 2) (sha256-s1 w16)))
        (w19 (+ (dword x 3) (sha256-s1 w17))))
    (concat w19 w18 w17 w16)))
(defun SHA256MSG2rr (rd x y) (set$ rd (sha256msg2 x y)))
(defun SHA256MSG2rm (rd x b s i off seg) (set$ rd (sha256msg2 x (aes-mem b s i off seg))))

(defun sha256rnds2 (x y k)
  (let ((a0 (dword y 3)) (b0 (dword y 2)) (c0 (dword x 3)) (d0 (dword x 2))
        (e0 (dword y 1)) (f0 (dword y 0)) (g0 (dword x 1)) (h0 (dword x 0))
        (t0 (+ h0 (sha256-big1 e0) (sha256-ch e0 f0 g0) (dword k 0)))
        (a1 (+ t0 (sha256-big0 a0) (sha256-maj a0 b0 c0)))
        (e1 (+ t0 d0))
        (t1 (+ g0 (sha256-big1 e1) (sha256-ch e1 e0 f0) (dword k 1)))
        (a2 (+ t1 (sha256-big0 a1) (sha256-maj a1 a0 b0)))
        (e2 (+ t1 c0)))
    (concat a2 a1 e2 e1)))
(defun SHA256RNDS2rr (rd x y) (set$ rd (sha256rnds2 x y XMM0)))
(defun SHA256RNDS2rm (rd x b s i off seg) (set$ rd (sha256rnds2 x (aes-mem b s i off seg) XMM0)))

