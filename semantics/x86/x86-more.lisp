;; XLAT reads the byte at the sum of BX and AL

(defun XLAT ()
  (declare (context (bits 64)))
  (set$ AL (load-n 8 (+ RBX (cast-unsigned 64 AL)))))
(defun XLAT ()
  (declare (context (bits 32)))
  (set$ AL (load-n 8 (+ EBX (cast-unsigned 32 AL)))))

