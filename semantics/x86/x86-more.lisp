;; the atomic operations of memory, which don't set the flags

(defun atomic-op (f n b s i off seg y)
  (let ((a (ea b s i off seg)))
    (store-n n a (f (load-n n a) (cast-low n y)))))
(defun atomic-add (x y) (+ x y))
(defun atomic-and (x y) (logand x y))
(defun atomic-or (x y) (logor x y))
(defun atomic-xor (x y) (logxor x y))

