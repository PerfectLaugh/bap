(declare (context (target x86)))
(require x86-common)

(in-package x86-common)

;;; SSE, AVX AND MMX INTEGER AND MOVE INSTRUCTIONS
;;
;; The operations apply to the lanes of the 64-bit MMX, 128-bit XMM and
;; 256-bit YMM registers, the lanes of the YMM operations are computed
;; in each 128-bit half. XMM and YMM are the low bits of ZMM. The legacy
;; SSE instructions don't change the other bits of ZMM, the VEX-encoded
;; ones clear them, as set-vex does, the MMX instructions write the MM
;; registers.

(defmacro ylanes (lanes op x y)
  (concat (lanes op (cast-high 128 x) (cast-high 128 y))
          (lanes op (cast-low 128 x) (cast-low 128 y))))

(defmacro mlanes (lanes op x y)
  (cast-low 64 (lanes op (cast-unsigned 128 x) (cast-unsigned 128 y))))

(defun lane-add (x y) (+ x y))
(defun lane-sub (x y) (- x y))
(defun lane-avg (x y)
  (let ((w (word-width x)))
    (cast-low w (rshift (+ (cast-unsigned (+ w 1) x) (cast-unsigned (+ w 1) y)
                           (cast-unsigned (+ w 1) 1:1))
                        1))))
(defun lane-minu (x y) (if (< x y) x y))
(defun lane-maxu (x y) (if (> x y) x y))
(defun lane-mins (x y) (if (s< x y) x y))
(defun lane-maxs (x y) (if (s> x y) x y))
(defun lane-eq (x y) (if (= x y) (ones (word-width x)) (zeros (word-width x))))
(defun lane-gt (x y) (if (s> x y) (ones (word-width x)) (zeros (word-width x))))
(defun lane-abs (x _) (if (msb x) (neg x) x))

;; the counts of the shifts are the low quadword of the source, the
;; lanes are cleared, or filled with the sign, if the count is not less
;; than the size of the lane, so the count is clamped to the size and
;; is the same in all lanes
(defun clamped-count (s n)
  (let ((c (cast-low 64 n))
        (m (cast-unsigned 64 (resize 8 s))))
    (cast-low s (if (< c m) c m))))

(defun lane-size (x) (resize (word-width x) (word-width x)))
(defun lane-sll (x c) (if (< c (lane-size x)) (lshift x c) (zeros (word-width x))))
(defun lane-srl (x c) (if (< c (lane-size x)) (rshift x c) (zeros (word-width x))))
(defun lane-sra (x c)
  (arshift x (if (< c (lane-size x)) c (- (lane-size x) (one-of x)))))

(defun ptest (x y)
  (set ZF (is-zero (logand x y)))
  (set CF (is-zero (logand (lnot x) y)))
  (set AF 0:1)
  (set OF 0:1)
  (set PF 0:1)
  (set SF 0:1))

;; PSHUFB selects the bytes of X by the low bits of the bytes of C, the
;; byte is cleared if the most significant bit of C is set
(defun shuffle-byte (x c)
  (if (msb c) 0:8
    (cast-low 8 (rshift x (cast-unsigned (word-width x)
                                         (* 8 (logand c (resize 8 (- (/ (word-width x) 8) 1)))))))))


